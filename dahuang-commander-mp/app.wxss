/** 大荒之地 · 宣纸水墨朱砂主题 (与 dahuang.land Web 端对齐) **/
page {
  background-color: #f4f1ea;
  color: #1a1a1a;
  font-size: 14px;
  line-height: 1.5;
  box-sizing: border-box;
  height: 100%;
  width: 100%;
}

view, scroll-view, text, input, button {
  box-sizing: border-box;
}

/* 水墨卡片：纸白半透明 + 墨线 + 柔和投影 (对齐 Web ink-card) */
.cyber-panel {
  background-color: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 12rpx;
  box-shadow: 0 10rpx 30rpx -10rpx rgba(59, 48, 36, 0.12);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tab-pane-container {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 命名历史遗留：glow-cyan 实为朱砂红描边，仅保留类名兼容 */
.glow-cyan {
  box-shadow: 0 10rpx 30rpx -8rpx rgba(158, 42, 43, 0.18);
  border-color: rgba(158, 42, 43, 0.35);
}

.glow-purple {
  box-shadow: 0 10rpx 30rpx -8rpx rgba(91, 122, 140, 0.18);
  border-color: rgba(91, 122, 140, 0.35);
}

.glow-emerald {
  box-shadow: 0 10rpx 30rpx -8rpx rgba(22, 101, 52, 0.18);
  border-color: rgba(22, 101, 52, 0.35);
}

/* Agent 生成的 HTML 卡片（rich-text）在浅色纸底上的默认排版 */
.msg-body-rich {
  color: #1a1a1a;
  line-height: 1.7;
  word-break: break-all;
}

/* Flex layout utilities */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.align-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

/* Custom Text Badges */
.badge {
  font-size: 18rpx;
  font-weight: bold;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  text-transform: uppercase;
}

.badge-pending {
  color: #6b5b4a;
  border-color: rgba(107,91,74, 0.3);
  background-color: rgba(107,91,74, 0.1);
}

.badge-processing {
  color: #9e2a2b;
  border-color: rgba(158,42,43, 0.4);
  background-color: rgba(158,42,43, 0.1);
}

.badge-success {
  color: #166534;
  border-color: rgba(22,101,52, 0.4);
  background-color: rgba(22,101,52, 0.1);
}

.badge-failed {
  color: #be123c;
  border-color: rgba(190,18,60, 0.4);
  background-color: rgba(190,18,60, 0.1);
}

/* Scrollbars - Hidden/Minimalist */
::-webkit-scrollbar {
  width: 0rpx;
  height: 0rpx;
  color: transparent;
}
