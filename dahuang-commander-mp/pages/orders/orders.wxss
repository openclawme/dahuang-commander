/* 购买记录页：宣纸底 + 纸白卡片，朱砂只做徽章点缀（古风淡雅体系） */
.container {
  min-height: 100vh;
  background: #f4f1ea;
  padding: 20rpx;
  box-sizing: border-box;
}

.summary-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  box-shadow: 0 6rpx 18rpx -10rpx rgba(59, 48, 36, 0.16);
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  min-width: 110rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #2b2b2b;
}

.summary-pending {
  color: #5b7a8c;
}

.summary-settled {
  color: #3b5e59;
}

.summary-label {
  font-size: 22rpx;
  color: #9aa3a8;
  margin-top: 4rpx;
}

.refresh-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: #9e2a2b;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 10rpx -4rpx rgba(158, 42, 43, 0.5);
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  padding: 22rpx 24rpx;
  gap: 16rpx;
}

.order-body {
  flex: 1;
  min-width: 0;
}

.order-title-row {
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.order-platform {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.platform-pdd {
  color: #ffffff;
  background: rgba(158, 42, 43, 0.85);
}

.platform-jd {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}

.order-title {
  font-size: 26rpx;
  color: #2b2b2b;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.order-meta {
  gap: 16rpx;
}

.order-time {
  font-size: 22rpx;
  color: #9aa3a8;
  flex-shrink: 0;
}

.order-sn {
  font-size: 20rpx;
  color: #c3c0b8;
  flex: 1;
  min-width: 0;
}

.order-status {
  font-size: 24rpx;
  flex-shrink: 0;
}

.status-pending {
  color: #5b7a8c;
}

.status-settled {
  color: #3b5e59;
}

.status-invalid {
  color: #9aa3a8;
}

.empty {
  padding-top: 160rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(91, 122, 140, 0.1);
  color: #5b7a8c;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #2b2b2b;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9aa3a8;
  text-align: center;
  padding: 0 80rpx;
  line-height: 1.6;
}

.loading-ring {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(91, 122, 140, 0.15);
  border-top-color: #5b7a8c;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.align-center { align-items: center; }
.justify-between { justify-content: space-between; }
.text-ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* CPS 披露（合规） */
.orders-disclosure {
  margin-top: 30rpx;
  font-size: 20rpx;
  color: #c3c0b8;
  text-align: center;
  line-height: 1.7;
  padding: 0 60rpx;
}
