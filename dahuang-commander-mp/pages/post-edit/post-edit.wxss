page { background: #f4f1ea; }
.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.title-input { width: 100%; box-sizing: border-box; background: #fff; border: 1rpx solid rgba(59,48,36,0.1); border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 30rpx; font-weight: bold; color: #3b3024; margin-bottom: 18rpx; }
.content-input { width: 100%; min-height: 560rpx; box-sizing: border-box; background: #fff; border: 1rpx solid rgba(59,48,36,0.1); border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; color: #3b3024; line-height: 1.6; }
.save-btn { margin-top: 28rpx; background: #9e2a2b; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.save-btn::after { border: none; }
.loading { text-align: center; color: #8c7d68; font-size: 26rpx; padding: 80rpx 0; }
