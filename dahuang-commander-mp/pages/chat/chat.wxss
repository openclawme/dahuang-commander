.container {
  background-color: #f4f1ea;
  padding: 24rpx;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.channel-header {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(158,42,43, 0.2);
  padding-bottom: 20rpx;
}

.channel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.channel-desc {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* Rooms List Styles */
.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-item {
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(107,91,74, 0.2);
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.2s ease;
  position: relative;
}

.glowing-border {
  border-color: rgba(158,42,43, 0.5);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.2);
}

.item-hover {
  background: rgba(158,42,43, 0.05);
  border-color: rgba(158,42,43, 0.3);
}

.room-icon-container {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: rgba(158,42,43, 0.1);
  border: 1rpx solid rgba(158,42,43, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.room-avatar-char {
  font-size: 36rpx;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #be123c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f4f1ea;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.room-info {
  flex: 1;
  min-width: 0;
}

.room-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.room-time {
  font-size: 24rpx;
  color: #6b5b4a;
}

.room-last-msg {
  font-size: 26rpx;
  color: #8c7d68;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 10rpx;
}

/* Empty State Styles */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-art {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #8c7d68;
  line-height: 1.6;
}
