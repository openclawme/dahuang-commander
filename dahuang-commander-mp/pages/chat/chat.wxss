.container {
  background-color: #f4f1ea;
  padding: 24rpx;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.channel-header {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(158, 42, 43, 0.2);
  padding-bottom: 20rpx;
}

.channel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.channel-desc {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* Rooms List Styles */
.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-item {
  background: rgba(244, 241, 234, 0.8);
  border: 1rpx solid rgba(107, 91, 74, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.2s ease;
  position: relative;
}

.glowing-border {
  border-color: rgba(158, 42, 43, 0.5);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.2);
}

.item-hover {
  background: rgba(158, 42, 43, 0.05);
  border-color: rgba(158, 42, 43, 0.3);
}

.room-icon-container {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: rgba(158, 42, 43, 0.1);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.room-avatar-char {
  font-size: 36rpx;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #be123c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f4f1ea;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.room-info {
  flex: 1;
  min-width: 0;
}

.room-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.room-time {
  font-size: 26rpx;
  color: #6b5b4a;
}

.room-last-msg {
  font-size: 26rpx;
  color: #8c7d68;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 10rpx;
}

/* Empty State Styles */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-art {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c7d68;
  line-height: 1.6;
}

/* ===== 通讯录 v1：三段式分段器 + 联系人列表 ===== */
.segment-bar {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
}
.segment-item {
  flex: 1;
  position: relative;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #8c7d68;
  padding: 24rpx 0;
  border-radius: 16rpx;
}
.segment-active {
  background: #9e2a2b;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(158, 42, 43, 0.5);
}
.segment-badge {
  position: absolute;
  top: -6rpx;
  right: 20%;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #b04d4e;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.contact-search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}
.contact-search-icon {
  font-size: 28rpx;
}
.contact-search-ph {
  flex: 1;
  font-size: 26rpx;
  color: #8c7d68;
}
.contact-add-pill {
  font-size: 22rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.contact-entry-row {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.contact-row {
  position: relative;
}
.contact-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  flex-shrink: 0;
}
.contact-avatar-char {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}
.online-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 4rpx solid #f4f1ea;
}
.online-on {
  background: #3b5e59;
}
.online-off {
  background: #c4b8a5;
}
.contact-pin-icon,
.contact-fav-icon {
  font-size: 22rpx;
}
.contact-tags {
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 180rpx;
}
.contact-tag {
  font-size: 18rpx;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 2rpx;
}
.contact-tag-more {
  background: rgba(158, 42, 43, 0.12);
  color: #9e2a2b;
  font-weight: bold;
}



/* ===== UI 体验增强：骨架屏 / 头像 / 微动画 ===== */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.skeleton-row {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
}
.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, rgba(59, 48, 36, 0.08) 25%, rgba(59, 48, 36, 0.14) 50%, rgba(59, 48, 36, 0.08) 75%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.4s infinite linear;
  flex-shrink: 0;
}
.skeleton-lines {
  flex: 1;
  gap: 14rpx;
}
.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(59, 48, 36, 0.08) 25%, rgba(59, 48, 36, 0.14) 50%, rgba(59, 48, 36, 0.08) 75%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.4s infinite linear;
}
.skeleton-line-title { width: 42%; }
.skeleton-line-sub { width: 72%; height: 20rpx; }

@keyframes skeletonShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.contact-avatar {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  overflow: visible;
  background: rgba(158, 42, 43, 0.1);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  flex-shrink: 0;
}
.contact-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  overflow: hidden;
}
.contact-avatar-char {
  font-size: 34rpx;
  font-weight: bold;
  color: #9e2a2b;
}
.online-dot {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid #f4f1ea;
}
.online-on { background: #3b5e59; }
.online-off { background: #b5aa9a; }

.segment-item {
  transition: all 0.18s ease;
}
.room-item {
  transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
.room-item:active {
  transform: scale(0.985);
}


.empty-action {
  margin-top: 28rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: #9e2a2b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(158, 42, 43, 0.45);
}

.room-avatar-char {
  font-size: 28rpx;
  font-weight: bold;
  color: #9e2a2b;
}
