.container {
  background-color: var(--paper);
  padding: 24rpx;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.channel-header {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid var(--brand-mid);
  padding-bottom: 20rpx;
}

.channel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--brand);
}

.channel-desc {
  font-size: 26rpx;
  color: var(--ink-mid);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* Rooms List Styles */
.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-item {
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(107,91,74, 0.2);
  border-radius: var(--radius-md);
  padding: 24rpx;
  transition: all 0.2s ease;
  position: relative;
}

.glowing-border {
  border-color: var(--brand-glow);
  box-shadow: 0 6rpx 18rpx -6rpx var(--brand-mid);
}

.item-hover {
  background: var(--brand-faint);
  border-color: var(--brand-line);
}

.room-icon-container {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.room-icon-direct {
  background: linear-gradient(135deg, #5b7a8c, #2c4453);
  border: 1rpx solid var(--line-solid);
}
.room-icon-group {
  background: var(--brand-grad);
  border: 1rpx solid var(--brand-line);
}

.room-avatar-char {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: var(--danger);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--paper);
  box-shadow: 0 6rpx 16rpx -6rpx var(--line-stronger);
}

.room-info {
  flex: 1;
  min-width: 0;
}

.room-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.room-time {
  font-size: 26rpx;
  color: var(--ink-mid);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.room-last-msg {
  font-size: 26rpx;
  color: var(--ink-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 10rpx;
}

/* Empty State Styles */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-art {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--ink-mid);
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

/* ===== 通讯录 v1：三段式分段器 + 联系人列表 ===== */
.segment-bar {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
}
.segment-item {
  flex: 1;
  position: relative;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--ink-soft);
  padding: 24rpx 0;
  border-radius: var(--radius-md);
}
.segment-active {
  background: var(--brand);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx -4rpx var(--brand-glow);
}
.segment-badge {
  position: absolute;
  top: -6rpx;
  right: 20%;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: #e53e3e;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.contact-search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  background: var(--card-strong);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-pill);
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}
.contact-search-icon {
  font-size: 28rpx;
}
.contact-search-ph {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-faint);
}
.contact-add-pill {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--radius-pill);
  padding: 4rpx 20rpx;
}

.contact-entry-row {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.contact-row {
  position: relative;
}
.contact-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  flex-shrink: 0;
}
.contact-avatar-char {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}
.online-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 4rpx solid var(--paper);
}
.online-on {
  background: var(--ok);
}
.online-off {
  background: #c4b8a5;
}
.contact-pin-icon,
.contact-fav-icon {
  font-size: 22rpx;
}
.contact-tags {
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 180rpx;
}
.contact-tag {
  font-size: 18rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 2rpx;
}
.contact-tag-more {
  background: rgba(158, 42, 43, 0.12);
  color: var(--brand);
  font-weight: bold;
}



.contact-avatar {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  overflow: visible;
  background: rgba(158,42,43,0.1);
  border: 1rpx solid var(--brand-line);
  flex-shrink: 0;
}
.contact-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
}
.contact-avatar-char {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--brand);
}
.online-dot {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid var(--paper);
}
.online-on { background: #16a34a; }
.online-off { background: #b5aa9a; }

.segment-item {
  transition: all 0.18s ease;
}
.room-item {
  transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
.room-item:active {
  transform: scale(0.985);
}


.empty-action {
  margin-top: 28rpx;
  padding: 16rpx 34rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(158,42,43,0.45);
}

.room-avatar-char {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--brand);
}
