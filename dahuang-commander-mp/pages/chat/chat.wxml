<view class="container">
  <!-- 顶部标题/导语 -->
  <view class="channel-header flex-col">
    <text class="channel-title">{{t.chat.title}}</text>
    <text class="channel-desc">{{t.chat.desc}}</text>
  </view>

  <!-- 房间列表 -->
  <view class="rooms-list" wx:if="{{roomsList.length > 0}}">
    <view class="room-item flex-row align-center {{item.unreadCount > 0 ? 'glowing-border' : ''}}" 
          wx:for="{{roomsList}}" 
          wx:key="roomId" 
          bindtap="enterRoom" 
          data-roomid="{{item.roomId}}"
          hover-class="item-hover"
          hover-stay-time="100">
      
      <!-- 房间状态图标 -->
      <view class="room-icon-container">
        <text class="room-avatar-char">{{item.unreadCount > 0 ? '⚡' : '💬'}}</text>
        <view class="unread-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount}}</view>
      </view>

      <!-- 房间信息 -->
      <view class="room-info flex-col">
        <view class="flex-row justify-between align-center">
          <text class="room-name">{{item.name}}</text>
          <text class="room-time">{{item.lastMsgTime}}</text>
        </view>
        <text class="room-last-msg">{{item.lastMsgText}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state flex-col align-center" wx:else>
    <text class="empty-art">🛰️</text>
    <text class="empty-title">{{t.chat.empty_title}}</text>
    <text class="empty-text">{{t.chat.empty_text}}</text>
  </view>
</view>
