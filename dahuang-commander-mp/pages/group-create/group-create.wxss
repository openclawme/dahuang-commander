@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink-strong);
  display: block;
}

.form-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--ink-strong);
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.form-ph {
  color: var(--ink-faint);
}

.cost-note {
  display: block;
  font-size: 22rpx;
  color: var(--warn);
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.agent-row {
  padding: 18rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--line-weak);
  background: var(--card-weak);
  border-radius: var(--radius-sm);
  margin-bottom: 10rpx;
}

.row-selected {
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
}

.contact-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  flex-shrink: 0;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

.row-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--ink-strong);
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-solid);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.check-on {
  background: var(--brand);
  border-color: var(--brand);
}

.empty-agents {
  padding: 40rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

.create-btn {
  width: 100%;
  background: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: var(--radius-md);
  margin-top: 32rpx;
  box-shadow: 0 8rpx 20rpx -8rpx var(--brand-glow);
}

.create-btn::after {
  border: none;
}
