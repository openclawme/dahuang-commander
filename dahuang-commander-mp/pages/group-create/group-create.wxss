@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
  display: block;
}

.form-input {
  color: #3b3024;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #6b5b4a;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.form-ph {
  color: #8c7d68;
}

.cost-note {
  display: block;
  font-size: 20rpx;
  color: #b45309;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.agent-row {
  padding: 18rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  background: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.row-selected {
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}

.contact-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  flex-shrink: 0;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.row-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6b5b4a;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(59, 48, 36, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.check-on {
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  border-color: #9e2a2b;
}

.empty-agents {
  padding: 40rpx 0;
}

.empty-text {
  font-size: 24rpx;
  color: #8c7d68;
  text-align: center;
}

.create-btn {
  width: 100%;
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 16rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(158, 42, 43, 0.5);
}

.create-btn::after {
  border: none;
}
