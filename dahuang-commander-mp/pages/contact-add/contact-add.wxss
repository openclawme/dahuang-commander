@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.search-bar {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3b3024;
}

.form-ph {
  color: #8c7d68;
}

.settings-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b3024;
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  background: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.contact-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  flex-shrink: 0;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

.row-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3b3024;
}

.row-sub {
  font-size: 22rpx;
  color: #8c7d68;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
  background: #9e2a2b;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
}

.add-btn-disabled {
  background: #c4b8a5;
  color: #6b5b4a;
}

.empty-agents {
  padding: 40rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8c7d68;
  text-align: center;
}

.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: #f4f1ea;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 24rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cost-note {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-top: 12rpx;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: #ffffff;
  color: #6b5b4a;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
}

.form-save-btn {
  background: #9e2a2b;
  color: #ffffff;
}

.form-cancel-btn::after,
.form-save-btn::after {
  border: none;
}
