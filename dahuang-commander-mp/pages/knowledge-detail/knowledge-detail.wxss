/* ===== 知识库文档详情（古风淡雅） ===== */
.kd-container {
  min-height: 100vh;
  background: #f6f1e7;
  display: flex;
  flex-direction: column;
}

.kd-head {
  padding: 24rpx 28rpx;
  background: #fffdf6;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  gap: 8rpx;
}
.kd-head-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(91, 122, 140, 0.12);
  color: #4a6a7c;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kd-head-title { flex: 1; min-width: 0; font-size: 30rpx; color: #2b2a26; font-weight: 700; line-height: 1.4; }
.kd-rename {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #4a6a7c;
  border: 1rpx solid rgba(91, 122, 140, 0.4);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.kd-head-meta { font-size: 22rpx; color: #8a7f6d; margin-top: 4rpx; }
.kd-head-hint { font-size: 21rpx; color: #a89f8e; }

.kd-body {
  flex: 1;
  padding: 28rpx;
  box-sizing: border-box;
}
.kd-content {
  display: block;
  font-size: 27rpx;
  color: #3b3024;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.kd-state { flex: 1; display: flex; align-items: center; justify-content: center; }
.kd-state-text { font-size: 26rpx; color: #8a7f6d; }

.kd-footer {
  background: #fffdf6;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
}
.kd-footer-btn {
  border: 1rpx solid rgba(176, 84, 63, 0.4);
  border-radius: 999rpx;
  padding: 14rpx 70rpx;
}
.kd-footer-label { font-size: 26rpx; color: #b0543f; font-weight: 600; }

.hover-dim { opacity: 0.75; }
