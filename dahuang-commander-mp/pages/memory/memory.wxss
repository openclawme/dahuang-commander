@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #8c7d68;
  font-size: 24rpx;
}

/* 档案头卡 */
.profile-hero-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-top: 6rpx solid #9e2a2b;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx -10rpx rgba(59, 48, 36, 0.15);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-char {
  font-size: 24rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

/* 分区 */
.settings-section {
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(59, 48, 36, 0.1);
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 8rpx;
  display: block;
}

.section-desc {
  font-size: 24rpx;
  color: #8c7d68;
  line-height: 1.4;
  margin-top: 6rpx;
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

/* 行 */
.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}

.agent-row:last-child {
  border-bottom: none;
}

.register-row {
  border-bottom: none;
}

.register-row-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.register-row-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.row-hover {
  background: rgba(158, 42, 43, 0.05);
}

.row-arrow {
  font-size: 32rpx;
  color: #8c7d68;
  flex-shrink: 0;
  font-weight: normal;
}

.danger-link {
  font-size: 24rpx;
  color: #b45309;
}

/* 空态 */
.empty-agents {
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #8c7d68;
  text-align: center;
}

/* 事实条目 */
.fact-row {
  padding: 20rpx 24rpx;
  gap: 10rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}

.fact-row:last-child {
  border-bottom: none;
}

.fact-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.fact-time {
  font-size: 20rpx;
  color: #8c7d68;
}

.fact-content {
  font-size: 28rpx;
  color: #6b5b4a;
  line-height: 1.5;
  word-break: break-all;
}

/* 近期对话 / 长期记忆条目 */
.shortterm-row,
.episodic-row {
  padding: 18rpx 24rpx;
  gap: 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}

.shortterm-row:last-child,
.episodic-row:last-child {
  border-bottom: none;
}

/* 摘要/人设卡片 */
.summary-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
}

/* 编辑浮层 */
.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: #f4f1ea;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea-tall {
  min-height: 320rpx;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: #ffffff;
  color: #6b5b4a;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
}

.form-save-btn {
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
}


/* AI 整理建议 */
.maint-toggle-row {
  padding: 0 8rpx 16rpx 8rpx;
}
.maint-boundary-note {
  display: block;
  margin: 0 8rpx 16rpx 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(158, 42, 43, 0.05);
  border-left: 4rpx solid rgba(158, 42, 43, 0.4);
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
}
.maint-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(158, 42, 43, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}
.maint-type {
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}
.maint-items {
  gap: 8rpx;
  margin-top: 4rpx;
}
.maint-item {
  background: rgba(244, 241, 234, 0.9);
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
}
.maint-item-text {
  font-size: 24rpx;
  color: #6b5b4a;
}
.maint-merged {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
}
.maint-merged-label {
  flex: 1;
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: bold;
}
.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}
.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #6b5b4a;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
  margin: 0;
}
.maint-btn-primary {
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
  border-color: #9e2a2b;
}
.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: #8c7d68;
}

/* 按钮化操作 */
.maint-analyze-btn {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(158, 42, 43, 0.5);
}
.maint-expand-btn {
  font-size: 20rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}
.icon-del-btn {
  min-width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #b45309;
  border-radius: 50%;
  background: rgba(180, 83, 9, 0.06);
}
.icon-del-btn:active {
  background: rgba(180, 83, 9, 0.16);
}

/* 输入占位符可读性 + 删除按钮按压 */
.form-ph {
  color: #8c7d68;
}
.icon-del-hover {
  background: rgba(180, 83, 9, 0.18);
}

/* 审查修复 */
.section-header-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}
.maint-btn::after,
.form-save-btn::after,
.form-cancel-btn::after {
  border: none;
}


/* ===== 关键记忆认知升级：搜索 / 分类 / 置顶 / 反馈 ===== */
.fact-search {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #3b3024;
  margin-bottom: 14rpx;
}
.fact-search-ph { color: #a89982; }
.fact-cat-row {
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}
.fact-cat-pill {
  font-size: 23rpx;
  color: #6b5b4a;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(59, 48, 36, 0.08);
}
.fact-cat-pill.active {
  color: #9e2a2b;
  border-color: rgba(158, 42, 43, 0.3);
  background: rgba(158, 42, 43, 0.06);
}
.fact-cat-tag {
  font-size: 20rpx;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.fact-pin-tag {
  font-size: 20rpx;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.fact-actions {
  gap: 10rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(59, 48, 36, 0.08);
}
.fact-action {
  font-size: 22rpx;
  color: #8c7d68;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(244, 241, 234, 0.8);
}
.fact-action.on {
  color: #3b5e59;
  background: rgba(59, 94, 89, 0.1);
}
.fact-action.warn {
  color: #d97706;
  background: rgba(217, 119, 6, 0.1);
}
.fact-action.danger {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.1);
}
