@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-soft);
  font-size: 26rpx;
}

/* 档案头卡 */
.profile-hero-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-top: 6rpx solid var(--brand);
  border-radius: var(--radius-card);
  box-shadow: 0 10rpx 30rpx -10rpx var(--line-strong);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-char {
  font-size: 26rpx;
  color: var(--ink-mid);
  margin-top: 6rpx;
}

/* 分区 */
.settings-section {
  margin-bottom: 44rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink-strong);
  margin-bottom: 8rpx;
  display: block;
}

.section-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.4;
  margin-top: 6rpx;
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

/* 行 */
.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--line-weak);
}

.agent-row:last-child {
  border-bottom: none;
}

.register-row {
  border-bottom: none;
}

.register-row-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--brand);
}

.register-row-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--brand);
}

.row-hover {
  background: var(--brand-faint);
}

.row-arrow {
  font-size: 32rpx;
  color: var(--ink-faint);
  flex-shrink: 0;
  font-weight: normal;
}

.danger-link {
  font-size: 26rpx;
  color: var(--warn);
}

/* 空态 */
.empty-agents {
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

/* 事实条目 */
.fact-row {
  padding: 20rpx 24rpx;
  gap: 10rpx;
  border-bottom: 1rpx solid var(--line-weak);
}

.fact-row:last-child {
  border-bottom: none;
}

.fact-label {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid rgba(158, 42, 43, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.fact-time {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.fact-content {
  font-size: 26rpx;
  color: var(--ink-strong);
  line-height: 1.5;
  word-break: break-all;
}

/* 近期对话 / 长期记忆条目 */
.shortterm-row,
.episodic-row {
  padding: 18rpx 24rpx;
  gap: 8rpx;
  border-bottom: 1rpx solid var(--line-weak);
}

.shortterm-row:last-child,
.episodic-row:last-child {
  border-bottom: none;
}

/* 摘要/人设卡片 */
.summary-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

/* 编辑浮层 */
.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: var(--paper);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--ink);
  display: block;
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea-tall {
  min-height: 320rpx;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: var(--surface);
  color: var(--ink-mid);
  border: 1rpx solid var(--line-stronger);
}

.form-save-btn {
  background: var(--brand);
  color: #ffffff;
}


/* AI 整理建议 */
.maint-toggle-row {
  padding: 0 8rpx 16rpx 8rpx;
}
.maint-boundary-note {
  display: block;
  margin: 0 8rpx 16rpx 8rpx;
  padding: 12rpx 16rpx;
  background: var(--brand-faint);
  border-left: 4rpx solid var(--brand-line);
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.maint-card {
  background: var(--card);
  border: 1rpx solid var(--brand-mid);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}
.maint-type {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--brand);
}
.maint-items {
  gap: 8rpx;
  margin-top: 4rpx;
}
.maint-item {
  background: rgba(244, 241, 234, 0.9);
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
}
.maint-item-text {
  font-size: 24rpx;
  color: var(--ink-mid);
}
.maint-merged {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
}
.maint-merged-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: bold;
}
.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}
.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: var(--surface);
  color: var(--ink-strong);
  border: 1rpx solid var(--line-stronger);
  margin: 0;
}
.maint-btn-primary {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}
.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: var(--ink-soft);
}

/* 按钮化操作 */
.maint-analyze-btn {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  background: var(--brand);
  border-radius: var(--radius-pill);
  padding: 10rpx 28rpx;
  box-shadow: 0 4rpx 12rpx -4rpx var(--brand-glow);
}
.maint-expand-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--radius-pill);
  padding: 6rpx 22rpx;
}
.icon-del-btn {
  min-width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--warn);
  border-radius: 50%;
  background: rgba(180, 83, 9, 0.06);
}
.icon-del-btn:active {
  background: rgba(180, 83, 9, 0.16);
}

/* 输入占位符可读性 + 删除按钮按压 */
.form-ph {
  color: var(--ink-faint);
}
.icon-del-hover {
  background: rgba(180, 83, 9, 0.18);
}

/* 审查修复 */
.section-header-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}
.maint-btn::after,
.form-save-btn::after,
.form-cancel-btn::after {
  border: none;
}
