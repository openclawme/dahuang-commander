<view class="mc-container">
  <!-- 头部 -->
  <view class="mc-head flex-row align-center">
    <view class="mc-head-badge">具</view>
    <view class="flex-col" style="margin-left: 16rpx;">
      <text class="mc-head-title">MCP 工具商店</text>
      <text class="mc-head-sub">给你的分身装外挂 · 启停 / 测试 / 安装 / 移除</text>
    </view>
  </view>

  <!-- 服务端列表 -->
  <view class="mc-list flex-col" wx:if="{{!loading}}">
    <view class="mc-card flex-col" wx:for="{{servers}}" wx:key="id">
      <view class="flex-row align-center">
        <view class="mc-card-badge">{{item.name.slice(0, 1)}}</view>
        <view class="flex-col" style="flex: 1; min-width: 0;">
          <view class="flex-row align-center">
            <text class="mc-card-title">{{item.name}}</text>
            <text class="mc-cat-free" wx:if="{{item.shared}}">系统提供</text>
          </view>
          <text class="mc-card-host" bindtap="onCopyHost" data-host="{{item.host}}">{{item.host}} · {{item.authMode === 'header' ? '头部鉴权' : 'URL 鉴权'}}（点按复制地址）</text>
        </view>
        <switch checked="{{item.enabled}}" color="#b0543f" style="transform: scale(0.75);" bindchange="onToggleEnabled" data-id="{{item.id}}" />
      </view>

      <text class="mc-card-meta" wx:if="{{item.enabled && !item.usingSystemKey}}">{{item.toolCount}} 个工具 · {{item.lastLoadedText}}</text>
      <text class="mc-card-meta" wx:if="{{item.enabled && item.usingSystemKey}}">{{item.toolCount}} 个工具 · 使用系统共享 Key（额度用尽可在「编辑」里填自己的 Key）</text>
      <text class="mc-card-meta" wx:else>已停用（其工具不注入分身）</text>
      <text class="mc-card-error" wx:if="{{item.lastError}}">最近错误：{{item.lastError}}</text>

      <view class="mc-tools flex-row" wx:if="{{item.toolNames && item.toolNames.length}}">
        <text class="mc-tool-chip" wx:for="{{item.toolNames}}" wx:for-item="tn" wx:key="*this">{{tn}}</text>
      </view>

      <view class="mc-card-actions flex-row">
        <view class="mc-act-btn" hover-class="hover-dim" bindtap="onTest" data-id="{{item.id}}">{{item.testing ? '测试中…' : '测试连接'}}</view>
        <view class="mc-act-btn" hover-class="hover-dim" bindtap="onEditOpen" data-id="{{item.id}}">编辑</view>
        <view class="mc-act-btn mc-act-danger" hover-class="hover-dim" bindtap="onDelete" data-id="{{item.id}}" wx:if="{{!item.shared}}">移除</view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="mc-empty flex-col align-center" wx:if="{{!loading && servers.length === 0}}">
      <view class="mc-empty-badge">具</view>
      <text class="mc-empty-title">还没有安装任何 MCP 工具</text>
      <text class="mc-empty-text">点下方按钮，从目录安装或自定义接入</text>
    </view>
  </view>

  <!-- 状态 -->
  <view class="mc-state" wx:if="{{loading}}">
    <text class="mc-state-text">加载中…</text>
  </view>

  <!-- 底部添加 -->
  <view class="mc-footer" bindtap="onAddOpen" hover-class="hover-dim" wx:if="{{!loading}}">
    <view class="mc-footer-btn flex-row align-center">
      <text class="mc-footer-plus">＋</text>
      <text class="mc-footer-label">添加工具</text>
    </view>
    <text class="mc-footer-hint">启用越多，分身每次响应略慢 · 已装 {{servers.length}} 个服务端</text>
  </view>
</view>

<!-- ===== 添加弹层 ===== -->
<view class="mc-mask" wx:if="{{showAddSheet}}" bindtap="closeAddSheet" catchtouchmove="noop"></view>
<view class="mc-sheet" wx:if="{{showAddSheet}}">
  <view class="mc-sheet-head flex-row align-center">
    <text class="mc-sheet-title">{{addMode === 'catalog' ? '从目录安装' : '自定义接入'}}</text>
    <view class="mc-sheet-close" bindtap="closeAddSheet">✕</view>
  </view>

  <!-- 目录模式 -->
  <scroll-view class="mc-sheet-body" scroll-y wx:if="{{addMode === 'catalog'}}">
    <text class="mc-group-label">官方</text>
    <view class="mc-cat-item flex-row align-center" wx:for="{{catalog.official}}" wx:key="serverKey" bindtap="onCatalogInstall" data-key="{{item.serverKey}}" hover-class="hover-dim">
      <view class="flex-col" style="flex: 1; min-width: 0;">
        <view class="flex-row align-center">
          <text class="mc-cat-name">{{item.name}}</text>
          <text class="mc-cat-free" wx:if="{{item.shared}}">系统提供·已默认启用</text>
          <text class="mc-cat-needkey" wx:elif="{{item.needsKey}}">需 Key</text>
        </view>
        <text class="mc-cat-desc">{{item.description}}</text>
        <text class="mc-cat-hint" wx:if="{{item.shared}}">所有分身默认可用系统 Key；额度用尽后可在管理页填自己的 Key</text>
        <text class="mc-cat-hint" wx:elif="{{item.keyHint}}">Key 申请：{{item.keyHint}}</text>
      </view>
      <text class="mc-cat-install" wx:if="{{!item.shared}}">安装</text>
    </view>
    <text class="mc-group-label">社区（免 Key）</text>
    <view class="mc-cat-item flex-row align-center" wx:for="{{catalog.community}}" wx:key="serverKey" bindtap="onCatalogInstall" data-key="{{item.serverKey}}" hover-class="hover-dim">
      <view class="flex-col" style="flex: 1; min-width: 0;">
        <view class="flex-row align-center">
          <text class="mc-cat-name">{{item.name}}</text>
          <text class="mc-cat-free">免 Key</text>
        </view>
        <text class="mc-cat-desc">{{item.description}}</text>
        <text class="mc-cat-note" wx:if="{{item.note}}">{{item.note}}</text>
      </view>
      <text class="mc-cat-install">安装</text>
    </view>
  </scroll-view>

  <!-- 自定义模式 -->
  <scroll-view class="mc-sheet-body" scroll-y wx:else>
    <text class="mc-form-label">名称 *</text>
    <input class="mc-form-input" placeholder="如：我的天气服务" value="{{custom.name}}" bindinput="onCustomInput" data-field="name" />
    <text class="mc-form-label">MCP 地址 *</text>
    <input class="mc-form-input" placeholder="如：https://xxx.com/mcp?key={key}" value="{{custom.url}}" bindinput="onCustomInput" data-field="url" />
    <text class="mc-form-hint">支持 {key} 占位符；已内嵌 Key 的完整 URL 也支持</text>
    <text class="mc-form-label">Key（可选）</text>
    <input class="mc-form-input" placeholder="留空=URL 内嵌或无 Key" value="{{custom.key}}" bindinput="onCustomInput" data-field="key" />
    <text class="mc-form-label">鉴权方式</text>
    <view class="flex-row" style="gap: 16rpx;">
      <view class="mc-form-chip {{custom.authMode === 'url' ? 'mc-form-chip-on' : ''}}" bindtap="onCustomAuthMode" data-value="url">URL 参数</view>
      <view class="mc-form-chip {{custom.authMode === 'header' ? 'mc-form-chip-on' : ''}}" bindtap="onCustomAuthMode" data-value="header">请求头</view>
    </view>
    <block wx:if="{{custom.authMode === 'header'}}">
      <text class="mc-form-label">请求头模板</text>
      <input class="mc-form-input" placeholder="Authorization: Bearer {key}" value="{{custom.authHeader}}" bindinput="onCustomInput" data-field="authHeader" />
    </block>
    <view class="mc-sheet-submit" hover-class="hover-dim" bindtap="onCustomSubmit">接入</view>
  </scroll-view>
</view>

<!-- ===== Key 弹窗 ===== -->
<view class="mc-mask" wx:if="{{keyModal.show}}" bindtap="closeKeyModal" catchtouchmove="noop"></view>
<view class="mc-keymodal" wx:if="{{keyModal.show}}">
  <text class="mc-keymodal-title">{{keyModal.target.name}} · 填写 Key</text>
  <text class="mc-keymodal-hint" wx:if="{{keyModal.target.keyHint}}">{{keyModal.target.keyHint}}</text>
  <input class="mc-form-input" placeholder="粘贴 Key" value="{{keyModal.key}}" bindinput="onKeyModalInput" />
  <view class="mc-sheet-submit" hover-class="hover-dim" bindtap="onKeyModalSubmit">安装</view>
</view>

<!-- ===== 编辑弹层 ===== -->
<view class="mc-mask" wx:if="{{showEditSheet}}" bindtap="closeEditSheet" catchtouchmove="noop"></view>
<view class="mc-sheet" wx:if="{{showEditSheet}}">
  <view class="mc-sheet-head flex-row align-center">
    <text class="mc-sheet-title">编辑服务端</text>
    <view class="mc-sheet-close" bindtap="closeEditSheet">✕</view>
  </view>
  <scroll-view class="mc-sheet-body" scroll-y>
    <text class="mc-form-label">名称</text>
    <input class="mc-form-input" value="{{editName}}" bindinput="onEditInput" data-field="editName" />
    <text class="mc-form-label">Key（留空=保持不变；共享服务留空=使用系统 Key）</text>
    <input class="mc-form-input" placeholder="留空则保持原 Key 不变" value="{{editKey}}" bindinput="onEditInput" data-field="editKey" />
    <view class="flex-row align-center" style="justify-content: space-between; margin-top: 8rpx;">
      <text class="mc-form-hint">清除 Key</text>
      <switch checked="{{editClearKey}}" color="#b0543f" style="transform: scale(0.75);" bindchange="onEditClearKey" />
    </view>
    <text class="mc-form-label">Key 申请渠道说明</text>
    <input class="mc-form-input" value="{{editKeyHint}}" bindinput="onEditInput" data-field="editKeyHint" />
    <view class="mc-sheet-submit" hover-class="hover-dim" bindtap="onEditSubmit">保存</view>
  </scroll-view>
</view>
