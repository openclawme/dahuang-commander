@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #8c7d68;
  font-size: 26rpx;
}

.profile-hero-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-top: 6rpx solid #9e2a2b;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx -10rpx rgba(59, 48, 36, 0.15);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.contact-avatar-big {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  margin-bottom: 20rpx;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
}

.online-dot-big {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
}

.online-on {
  background: #2f9e44;
}

.online-off {
  background: #c4b8a5;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.profile-char {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

.fact-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.fact-content {
  font-size: 26rpx;
  color: #3b3024;
  line-height: 1.5;
  word-break: break-all;
  text-align: center;
}

.fact-time {
  font-size: 22rpx;
  color: #a89982;
}

.contact-add-pill {
  font-size: 22rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.dm-btn {
  width: 100%;
  background: #9e2a2b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(158, 42, 43, 0.5);
}

.dm-btn::after,
.form-save-btn::after,
.form-cancel-btn::after {
  border: none;
}

.settings-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b3024;
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  background: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.register-row-text {
  flex: 1;
  font-size: 26rpx;
  color: #3b3024;
}

.row-arrow {
  font-size: 32rpx;
  color: #a89982;
}

.row-hover {
  background: rgba(158, 42, 43, 0.05);
}

.maint-expand-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.contact-tags {
  flex-wrap: wrap;
}

.contact-tag {
  font-size: 22rpx;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin: 4rpx;
}

.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: #f4f1ea;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.form-ph {
  color: #a89982;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: #ffffff;
  color: #6b5b4a;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
}

.form-save-btn {
  background: #9e2a2b;
  color: #ffffff;
}

.danger-btn {
  color: #b45309;
  border-color: rgba(180, 83, 9, 0.4);
}
