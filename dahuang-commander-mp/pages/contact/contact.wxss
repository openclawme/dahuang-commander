@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.profile-hero-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-top: 6rpx solid var(--brand);
  border-radius: var(--radius-card);
  box-shadow: 0 10rpx 30rpx -10rpx var(--line-strong);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.contact-avatar-big {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  margin-bottom: 20rpx;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
}

.online-dot-big {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
}

.online-on {
  background: var(--ok);
}

.online-off {
  background: #c4b8a5;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--ink);
}

.profile-char {
  font-size: 26rpx;
  color: var(--ink-mid);
  margin-top: 6rpx;
}

.fact-label {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid rgba(158, 42, 43, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.fact-content {
  font-size: 26rpx;
  color: var(--ink-strong);
  line-height: 1.5;
  word-break: break-all;
  text-align: center;
}

.fact-time {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.contact-add-pill {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--radius-pill);
  padding: 4rpx 20rpx;
}

.dm-btn {
  width: 100%;
  background: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: var(--radius-md);
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 20rpx -8rpx var(--brand-glow);
}

.dm-btn::after,
.form-save-btn::after,
.form-cancel-btn::after {
  border: none;
}

.settings-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink-strong);
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--line-weak);
  background: var(--card-weak);
  border-radius: var(--radius-sm);
  margin-bottom: 10rpx;
}

.register-row-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-strong);
}

.row-arrow {
  font-size: 32rpx;
  color: var(--ink-faint);
}

.row-hover {
  background: var(--brand-faint);
}

.maint-expand-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--radius-pill);
  padding: 6rpx 22rpx;
}

.contact-tags {
  flex-wrap: wrap;
}

.contact-tag {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin: 4rpx;
}

.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: var(--paper);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--ink);
  display: block;
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.form-ph {
  color: var(--ink-faint);
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: var(--surface);
  color: var(--ink-mid);
  border: 1rpx solid var(--line-stronger);
}

.form-save-btn {
  background: var(--brand);
  color: #ffffff;
}

.danger-btn {
  color: var(--warn);
  border-color: rgba(180, 83, 9, 0.4);
}
