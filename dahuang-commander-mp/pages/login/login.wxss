.container {
  padding: 80rpx 40rpx 40rpx;
  background-color: #f4f1ea;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
}

.login-seal {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  box-shadow: 0 16rpx 40rpx -12rpx rgba(158, 42, 43, 0.6);
  margin-bottom: 28rpx;
}

.login-seal-char {
  color: #ffffff;
  font-size: 72rpx;
  font-weight: bold;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.login-desc {
  font-size: 26rpx;
  color: #8c7d68;
  margin-top: 10rpx;
  margin-bottom: 48rpx;
  text-align: center;
  line-height: 1.5;
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-top: 6rpx solid #9e2a2b;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx -10rpx rgba(59, 48, 36, 0.15);
  padding: 32rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.login-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #3b3024;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.login-ph {
  color: #a89982;
}

.login-btn {
  width: 100%;
  background: #9e2a2b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(158, 42, 43, 0.5);
}

.login-btn-ghost {
  background: #ffffff;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.4);
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

.login-hint {
  display: block;
  font-size: 22rpx;
  color: #a89982;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.5;
}

.advanced-toggle {
  font-size: 24rpx;
  color: #9e2a2b;
  padding: 12rpx 24rpx;
  margin-bottom: 8rpx;
}

.login-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #3b3024;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

/* ===== 本地最近登录 ===== */
.recent-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.recent-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
  display: block;
  margin-bottom: 12rpx;
}
.recent-row {
  gap: 16rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}
.recent-row:last-of-type {
  border-bottom: none;
}
.recent-hover {
  background: rgba(158, 42, 43, 0.06);
  border-radius: 8rpx;
}
.recent-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  flex-shrink: 0;
}
.recent-avatar-char {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}
.recent-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3b3024;
}
.recent-did {
  font-size: 20rpx;
  color: #a89982;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-arrow {
  font-size: 32rpx;
  color: #a89982;
}
.recent-hint {
  display: block;
  font-size: 20rpx;
  color: #a89982;
  margin-top: 12rpx;
}
