page { background: #f4f1ea; }
.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.task-stats { gap: 14rpx; margin-bottom: 20rpx; }
.stat-card { flex: 1; background: rgba(255,255,255,0.7); border: 1rpx solid rgba(59,48,36,0.08); border-radius: 16rpx; padding: 18rpx 8rpx; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #3b3024; }
.stat-pending { color: #d97706; }
.stat-processing { color: #5b7a8c; }
.stat-completed { color: #3b5e59; }
.stat-failed { color: #9e2a2b; }
.stat-label { font-size: 22rpx; color: #8c7d68; margin-top: 6rpx; }
.filter-scroll { width: 100%; margin-bottom: 18rpx; }
.filter-track { display: flex; gap: 10rpx; }
.filter-pill { flex-shrink: 0; font-size: 24rpx; color: #6b5b4a; padding: 10rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,0.6); border: 1rpx solid rgba(59,48,36,0.08); }
.filter-pill.active { color: #9e2a2b; border-color: rgba(158,42,43,0.3); background: rgba(158,42,43,0.06); }
.task-list, .cron-section { display: flex; flex-direction: column; gap: 16rpx; }
.section-title { font-size: 26rpx; font-weight: bold; color: #3b3024; margin-bottom: 6rpx; }
.task-card, .cron-card { background: rgba(255,255,255,0.78); border: 1rpx solid rgba(59,48,36,0.08); border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; }
.task-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: bold; color: #3b3024; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-status { font-size: 22rpx; font-weight: bold; padding: 4rpx 12rpx; border-radius: 8rpx; }
.task-status.pending { color: #d97706; background: rgba(217,119,6,0.1); }
.task-status.processing { color: #5b7a8c; background: rgba(91,122,140,0.12); }
.task-status.completed { color: #3b5e59; background: rgba(59,94,89,0.12); }
.task-status.failed { color: #9e2a2b; background: rgba(158,42,43,0.1); }
.task-status.cancelled { color: #8c7d68; background: rgba(140,125,104,0.12); }
.task-preview { font-size: 24rpx; color: #6b5b4a; margin-top: 12rpx; line-height: 1.5; }
.task-error { font-size: 24rpx; color: #9e2a2b; margin-top: 10rpx; }
.task-footer { margin-top: 14rpx; }
.task-time, .cron-meta { font-size: 22rpx; color: #8c7d68; }
.task-actions, .cron-actions { gap: 12rpx; }
.mini-btn { font-size: 24rpx; color: #6b5b4a; padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(255,255,255,0.8); border: 1rpx solid rgba(59,48,36,0.12); }
.mini-btn.primary { color: #9e2a2b; border-color: rgba(158,42,43,0.3); background: rgba(158,42,43,0.06); }
.cron-command { flex: 1; font-size: 27rpx; font-weight: bold; color: #3b3024; }
.cron-status { font-size: 22rpx; font-weight: bold; }
.cron-status.on { color: #3b5e59; }
.cron-status.off { color: #8c7d68; }
.empty-text, .loading-text { text-align: center; color: #8c7d68; font-size: 26rpx; padding: 60rpx 0; }
