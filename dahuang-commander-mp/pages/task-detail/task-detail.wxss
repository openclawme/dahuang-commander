page { background: #f4f1ea; }
.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.hero-card { background: rgba(255,255,255,0.8); border: 1rpx solid rgba(59,48,36,0.08); border-radius: 20rpx; padding: 24rpx; }
.hero-status { font-size: 24rpx; font-weight: bold; color: #9e2a2b; }
.hero-time { font-size: 22rpx; color: #8c7d68; }
.hero-command { font-size: 32rpx; font-weight: bold; color: #3b3024; margin-top: 16rpx; line-height: 1.5; }
.hero-meta { font-size: 22rpx; color: #8c7d68; margin-top: 12rpx; }
.section { margin-top: 26rpx; }
.section-title { display: block; font-size: 24rpx; font-weight: bold; color: #9e2a2b; margin-bottom: 12rpx; }
.result-card, .error-card { background: rgba(255,255,255,0.8); border-radius: 16rpx; padding: 20rpx; }
.result-text { font-size: 27rpx; color: #3b3024; line-height: 1.6; }
.error-text { font-size: 26rpx; color: #9e2a2b; line-height: 1.5; }
.timeline { display: flex; flex-direction: column; gap: 14rpx; }
.event-item { background: rgba(255,255,255,0.72); border: 1rpx solid rgba(59,48,36,0.06); border-radius: 14rpx; padding: 16rpx; }
.event-type { font-size: 24rpx; font-weight: bold; color: #5b7a8c; }
.event-time { font-size: 22rpx; color: #8c7d68; }
.event-content { font-size: 25rpx; color: #3b3024; line-height: 1.5; margin-top: 8rpx; }
.action-row { margin-top: 34rpx; gap: 16rpx; }
.action-btn { flex: 1; font-size: 28rpx; border-radius: 12rpx; }
.action-btn.primary { background: #9e2a2b; color: #fff; }
.action-btn.ghost { background: rgba(255,255,255,0.8); color: #6b5b4a; border: 1rpx solid rgba(59,48,36,0.12); }
.action-btn::after { border: none; }
.empty-text, .loading-text { text-align: center; color: #8c7d68; font-size: 26rpx; padding: 60rpx 0; }
