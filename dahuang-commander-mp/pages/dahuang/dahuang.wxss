@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.offline-warning-banner {
  background: rgba(217,119,6, 0.12);
  border: 1rpx solid rgba(217,119,6, 0.4);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 24rpx;
}

.warning-text {
  font-size: 22rpx;
  color: #d97706;
  font-weight: 500;
}

/* Custom Top Tab Bar Styles */
.dahuang-tab-navbar {
  display: flex;
  flex-direction: row;
  background: rgba(253,251,247, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.2);
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx -4rpx rgba(59, 48, 36, 0.15);
}

.dahuang-tab-nav-item {
  flex: 1;
  font-size: 24rpx;
  color: #6b5b4a;
  padding: 16rpx 0;
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dahuang-tab-nav-item.active {
  background: rgba(158,42,43, 0.15);
  border: 1rpx solid rgba(158,42,43, 0.5);
  color: #9e2a2b;
  font-weight: bold;
}

.tab-icon {
  font-size: 26rpx;
}

.tab-pane-container {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* Owner Highlighting (Requirement 2) */
.is-me-post {
  border: 1rpx solid rgba(158,42,43, 0.4) !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.15) !important;
  background: rgba(158,42,43, 0.03) !important;
}

.me-post-badge {
  font-size: 20rpx;
  color: #d97706;
  background: rgba(217,119,6, 0.15);
  border: 1rpx solid rgba(217,119,6, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
  margin-left: auto;
}

.me-p-badge {
  font-size: 18rpx;
  color: #9e2a2b;
  background: rgba(158,42,43, 0.15);
  border: 1rpx solid rgba(158,42,43, 0.4);
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  font-weight: bold;
}

.me-score-badge {
  font-size: 18rpx;
  color: #166534;
  background: rgba(22,101,52, 0.15);
  border: 1rpx solid rgba(22,101,52, 0.4);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.is-me-participant {
  background: rgba(158,42,43, 0.08) !important;
  border-left: 4rpx solid #9e2a2b !important;
}

/* Dispatch Capsule Action Buttons (Requirement 3) */
.dispatch-cockpit-btn {
  background: rgba(158,42,43, 0.08) !important;
  border: 1rpx dashed rgba(158,42,43, 0.5) !important;
  color: #9e2a2b !important;
  font-size: 22rpx !important;
  font-weight: bold !important;
  border-radius: 12rpx !important;
  padding: 14rpx 0 !important;
  width: 100% !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.dispatch-cockpit-btn:active {
  background: rgba(158,42,43, 0.2) !important;
  transform: scale(0.98) !important;
}

.elegant-dispatch-btn {
  background: linear-gradient(135deg, rgba(158,42,43, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%) !important;
  border: 1rpx solid rgba(139, 92, 246, 0.5) !important;
  color: #c4b5fd !important;
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.2) !important;
}

.forum-web-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: #5b7a8c;
  background: rgba(56, 189, 248, 0.1);
  border: 1rpx solid rgba(56, 189, 248, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 0;
  line-height: 1.2;
}
.forum-web-btn:active {
  background: rgba(56, 189, 248, 0.2);
}

.dispatch-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* Mini Cockpit Drawer Popup Modal (Requirement 3) */
.mini-cockpit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(244,241,234, 0.85);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.mini-cockpit-modal {
  background: #f4f1ea;
  border-top: 2rpx solid rgba(158,42,43, 0.5);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(158,42,43, 0.2);
  animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 85vh;
}

.cockpit-modal-header {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.cockpit-modal-icon {
  font-size: 38rpx;
}

.cockpit-modal-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.cockpit-modal-subtitle {
  font-size: 20rpx;
  color: #8c7d68;
  margin-top: 4rpx;
}

.mini-online-badge {
  font-size: 20rpx;
  color: #166534;
  background: rgba(22,101,52, 0.1);
  border: 1rpx solid rgba(22,101,52, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.cockpit-close-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(59, 48, 36, 0.1);
  color: #be123c;
  font-size: 18rpx;
  cursor: pointer;
}

/* Dialogue List */
.cockpit-dialog-scroll {
  height: 480rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.mini-chat-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.mini-chat-user {
  align-items: flex-end;
}

.mini-chat-agent {
  align-items: flex-start;
}

.mini-chat-bubble {
  max-width: 85%;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.mini-chat-user .mini-chat-bubble {
  background: #9e2a2b;
  color: #f4f1ea;
  font-weight: 500;
  border-top-right-radius: 2rpx;
}

.mini-chat-agent .mini-chat-bubble {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  color: #3b3024;
  border-top-left-radius: 2rpx;
}

.mini-chat-time {
  font-size: 20rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

/* Steps in bubble */
.mini-bubble-task-container {
  width: 100%;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 8rpx;
  padding: 12rpx;
}

.mini-progress-track {
  width: 100%;
  height: 6rpx;
  background: rgba(59, 48, 36, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: #9e2a2b;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.mini-task-item {
  font-size: 18rpx;
}

.mini-task-title {
  color: #8c7d68;
}

.mini-task-title.done {
  color: #6b5b4a;
  text-decoration: line-through;
}

.mini-task-badge {
  font-size: 20rpx;
  font-weight: bold;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}

.mini-task-badge.status-SUCCESS {
  color: #166534;
}
.mini-task-badge.status-PROCESSING {
  color: #9e2a2b;
}
.mini-task-badge.status-WAITING {
  color: #6b5b4a;
}

.mini-progress-num {
  font-size: 18rpx;
  font-weight: bold;
  color: #9e2a2b;
  margin-left: auto;
}

/* Quick Dispatch Option Templates */
.cockpit-quick-options {
  margin-bottom: 20rpx;
}

.quick-title {
  font-size: 20rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 12rpx;
}

.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quick-opt-btn {
  background: rgba(255, 255, 255, 0.02) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
  color: #a89982 !important;
  font-size: 20rpx !important;
  padding: 16rpx 20rpx !important;
  border-radius: 10rpx !important;
  text-align: left !important;
  line-height: 1.3 !important;
  width: 100% !important;
}

.quick-opt-btn:active {
  background: rgba(158,42,43, 0.1) !important;
  border-color: rgba(158,42,43, 0.4) !important;
  color: #9e2a2b !important;
}

/* Custom Mini Input Bar */
.cockpit-input-bar {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  gap: 12rpx;
}

.cockpit-input {
  flex: 1;
  height: 60rpx;
  font-size: 22rpx;
  color: #1a1a1a;
}

.cockpit-send-btn {
  background: #8c7d68 !important;
  color: #8c7d68 !important;
  font-size: 20rpx !important;
  font-weight: bold !important;
  padding: 12rpx 24rpx !important;
  border-radius: 8rpx !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.cockpit-send-btn.active {
  background: #9e2a2b !important;
  color: #f4f1ea !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.4) !important;
}

/* Keyframes */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* Inline Comments Section */
.comments-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(59, 48, 36, 0.12);
  animation: fadeIn 0.3s ease;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.comment-item {
  background: rgba(255, 255, 255, 0.03);
  padding: 12rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
}

.comment-author {
  font-size: 20rpx;
  font-weight: bold;
  color: #8c7d68;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 22rpx;
  color: #3b3024;
  line-height: 1.4;
}

.loading-comments {
  font-size: 20rpx;
  color: #6b5b4a;
  text-align: center;
  padding: 10rpx 0;
}

.comment-input-area {
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.comment-input-area .cyber-input {
  flex: 1;
  height: 56rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.comment-input-area .mini-btn {
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  margin: 0;
}
