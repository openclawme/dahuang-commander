@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.offline-warning-banner {
  background: rgba(217, 119, 6, 0.12);
  border: 1rpx solid rgba(217, 119, 6, 0.4);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 24rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #d97706;
  font-weight: 500;
}

/* Custom Top Tab Bar Styles */
.dahuang-tab-navbar {
  display: flex;
  flex-direction: row;
  background: rgba(253, 251, 247, 0.8);
  border: 1rpx solid rgba(158, 42, 43, 0.2);
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
}

.dahuang-tab-nav-item {
  flex: 1;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #6b5b4a;
  padding: 26rpx 0; /* 触控高度 ≈91rpx，满足最小点击区 */
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 选中态：朱砂文字 + 浅底点缀（淡雅，不上实底） */
.dahuang-tab-nav-item.active {
  background: rgba(158, 42, 43, 0.07);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  color: #9e2a2b;
  font-weight: bold;
}

/* 跳转型入口（集市）：与切换型区分，右侧带箭头 */
.dahuang-tab-nav-link {
  color: #8c7d68;
}
.tab-link-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}


.tab-pane-container {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* Owner Highlighting (Requirement 2) */
.is-me-post {
  border: 1rpx solid rgba(91, 122, 140, 0.35) !important;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(91, 122, 140, 0.15) !important;
  background: rgba(91, 122, 140, 0.05) !important;
}

.me-post-badge {
  font-size: 24rpx;
  color: #d97706;
  background: rgba(217, 119, 6, 0.15);
  border: 1rpx solid rgba(217, 119, 6, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
  margin-left: auto;
}

.me-p-badge {
  font-size: 24rpx;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.12);
  border: 1rpx solid rgba(91, 122, 140, 0.4);
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  font-weight: bold;
}

.me-score-badge {
  font-size: 24rpx;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.15);
  border: 1rpx solid rgba(91, 122, 140, 0.4);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.is-me-participant {
  background: rgba(91, 122, 140, 0.08) !important;
  border-left: 4rpx solid #5b7a8c !important;
}

/* Dispatch Capsule Action Buttons (Requirement 3) */
.dispatch-cockpit-btn {
  background: rgba(91, 122, 140, 0.08) !important;
  border: 1rpx dashed rgba(91, 122, 140, 0.5) !important;
  color: #5b7a8c !important;
  font-size: 24rpx !important;
  font-weight: bold !important;
  border-radius: 16rpx !important;
  padding: 14rpx 0 !important;
  width: 100% !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.dispatch-cockpit-btn:active {
  background: rgba(91, 122, 140, 0.2) !important;
  transform: scale(0.98) !important;
}

.elegant-dispatch-btn {
  background: linear-gradient(135deg, rgba(158, 42, 43, 0.15) 0%, rgba(91, 122, 140, 0.15) 100%) !important;
  border: 1rpx solid rgba(91, 122, 140, 0.5) !important;
  color: #5b7a8c !important;
  box-shadow: 0 4rpx 12rpx rgba(91, 122, 140, 0.2) !important;
}

.forum-web-btn {
  font-size: 24rpx;
  font-weight: bold;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.1);
  border: 1rpx solid rgba(91, 122, 140, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 0;
  line-height: 1.2;
}
.forum-web-btn:active {
  background: rgba(91, 122, 140, 0.2);
}

.dispatch-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* Mini Cockpit Drawer Popup Modal (Requirement 3) */
.mini-cockpit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(244, 241, 234, 0.85);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.mini-cockpit-modal {
  background: #f4f1ea;
  border-top: 2rpx solid rgba(158, 42, 43, 0.5);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx rgba(158, 42, 43, 0.2);
  animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 85vh;
}

.cockpit-modal-header {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.12);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.cockpit-modal-icon {
  font-size: 38rpx;
}

.cockpit-modal-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.cockpit-modal-subtitle {
  font-size: 24rpx;
  color: #8c7d68;
  margin-top: 4rpx;
}

.mini-online-badge {
  font-size: 24rpx;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.1);
  border: 1rpx solid rgba(91, 122, 140, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.cockpit-close-btn {
  width: 44rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(59, 48, 36, 0.1);
  color: #a93230;
  font-size: 24rpx;
  cursor: pointer;
}

/* Dialogue List */
.cockpit-dialog-scroll {
  height: 480rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.mini-chat-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.mini-chat-user {
  align-items: flex-end;
}

.mini-chat-agent {
  align-items: flex-start;
}

.mini-chat-bubble {
  max-width: 85%;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.mini-chat-user .mini-chat-bubble {
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.14);
  color: #1a1a1a;
  font-weight: 500;
  border-top-right-radius: 2rpx;
}

.mini-chat-agent .mini-chat-bubble {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  color: #6b5b4a;
  border-top-left-radius: 2rpx;
}

.mini-chat-time {
  font-size: 24rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

/* Steps in bubble */
.mini-bubble-task-container {
  width: 100%;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 8rpx;
  padding: 12rpx;
}

.mini-progress-track {
  width: 100%;
  height: 6rpx;
  background: rgba(59, 48, 36, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: #9e2a2b;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.mini-task-item {
  font-size: 24rpx;
}

.mini-task-title {
  color: #8c7d68;
}

.mini-task-title.done {
  color: #6b5b4a;
  text-decoration: line-through;
}

.mini-task-badge {
  font-size: 24rpx;
  font-weight: bold;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}

.mini-task-badge.status-SUCCESS {
  color: #5b7a8c;
}
.mini-task-badge.status-PROCESSING {
  color: #9e2a2b;
}
.mini-task-badge.status-WAITING {
  color: #6b5b4a;
}

.mini-progress-num {
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
  margin-left: auto;
}

/* Quick Dispatch Option Templates */
.cockpit-quick-options {
  margin-bottom: 20rpx;
}

.quick-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 12rpx;
}

.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quick-opt-btn {
  background: rgba(255, 255, 255, 0.02) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
  color: #8c7d68 !important;
  font-size: 24rpx !important;
  padding: 16rpx 20rpx !important;
  border-radius: 10rpx !important;
  text-align: left !important;
  line-height: 1.3 !important;
  width: 100% !important;
}

.quick-opt-btn:active {
  background: rgba(158, 42, 43, 0.1) !important;
  border-color: rgba(158, 42, 43, 0.4) !important;
  color: #9e2a2b !important;
}

/* Custom Mini Input Bar */
.cockpit-input-bar {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  gap: 12rpx;
}

.cockpit-input {
  flex: 1;
  height: 60rpx;
  font-size: 24rpx;
  color: #1a1a1a;
}

.cockpit-send-btn {
  background: #8c7d68 !important;
  color: #8c7d68 !important;
  font-size: 24rpx !important;
  font-weight: bold !important;
  padding: 12rpx 24rpx !important;
  border-radius: 8rpx !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.cockpit-send-btn.active {
  background: #9e2a2b !important;
  color: #f4f1ea !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.4) !important;
}

/* Keyframes */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* Inline Comments Section */
.comments-section {
  background: rgba(91, 122, 140, 0.06);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  animation: fadeIn 0.3s ease;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.comment-item {
  background: rgba(255, 255, 255, 0.03);
  padding: 12rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
}

.comment-author {
  font-size: 24rpx;
  font-weight: bold;
  color: #8c7d68;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 24rpx;
  color: #6b5b4a;
  line-height: 1.4;
}

.loading-comments {
  font-size: 24rpx;
  color: #6b5b4a;
  text-align: center;
  padding: 10rpx 0;
}

.comment-input-area {
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.comment-input-area .cyber-input {
  flex: 1;
  height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.comment-input-area .mini-btn {
  padding: 0 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  margin: 0;
}
/* 扁平化：tab 面板不再套外框，内容直接贴在页面背景上 */
.tab-pane-container {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  margin-bottom: 0;
}

/* 帖子列表：纸白卡片（与信道页房间卡同语言） */
.forum-post-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
}

/* 帖子卡头部：标签灰章 + 作者粗体 + 右侧小字 IQ/Karma */
.post-tag {
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(59, 48, 36, 0.06);
  color: #6b5b4a;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.post-author {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}
.post-meta {
  margin-left: auto;
  font-size: 20rpx;
  color: #8c7d68;
  font-weight: normal;
}
.post-title {
  margin-top: 14rpx;
}
.post-content {
  margin-top: 8rpx;
}

/* 长文折叠态：仅超过阈值（JS longContent 判定）的帖子截断 3 行；
   点击卡片展开后移除该类完整显示 */
.content-clamped {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.post-stats {
  margin-top: 14rpx;
  padding-top: 14rpx;
  padding-bottom: 0;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  border-bottom: none;
  gap: 28rpx;
}
.stat-text {
  font-size: 24rpx;
  color: #8c7d68;
}
.stat-expand {
  margin-left: auto;
  font-size: 20rpx;
  color: #5b7a8c;
}
.action-bar-label {
  font-size: 20rpx;
  color: #8c7d68;
}

/* 帖子配图九宫格 */
.post-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.post-image-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
}

/* 游戏/挑战卡片降为轻量面板 */
.arena-game-card,
.alchemy-challenge-card {
  border-radius: 16rpx;
  border-color: rgba(59, 48, 36, 0.08);
  box-shadow: none;
}
/* 横向溢出修复：可收缩元素加省略号，次要元素不收缩 */
.post-tag,
.post-meta,
.me-post-badge,
.sub-index {
  flex-shrink: 0;
}
.post-author {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub-meta {
  flex: 1;
  min-width: 0;
}
.sub-author {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub-name {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.game-name {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.drawer-meta-item {
  word-break: break-all;
}
.poster-card-body {
  word-break: break-all;
}

/* 扁平化：去掉竞技场/炼丹内层面板边框与底纹 */
.dilemma-info-box,
.dilemma-control-cockpit,
.alchemy-leaderboard-panel,
.alchemy-compiler-panel {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  padding: 24rpx;
}
.node-control-drawer {
  background: transparent;
  border: none;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 0;
  box-shadow: none;
}
.leaderboard-item {
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 0;
  padding: 16rpx 0;
}

/* 排行榜前三名次章（金/银/铜） */
.leaderboard-item:first-child .sub-index { color: #d97706; }
.leaderboard-item:nth-child(2) .sub-index { color: #8c7d68; }
.leaderboard-item:nth-child(3) .sub-index { color: #b45309; }
/* 窄屏纵向堆叠，宽屏（平板/横屏）恢复两栏 */
@media (max-width: 767px) {
  .grid-row {
    flex-direction: column;
  }
  .dilemma-info-box,
  .dilemma-control-cockpit,
  .alchemy-leaderboard-panel,
  .alchemy-compiler-panel {
    flex: none;
  }
}
.mini-task-title {
  flex: 1;
  min-width: 0;
}
.mini-task-badge {
  flex-shrink: 0;
}
.sub-specs {
  flex-wrap: wrap;
}
/* 炼丹页：元信息纵向排列，榜单两行清晰化 */
.challenge-meta-grid {
  grid-template-columns: 1fr;
}
.challenge-meta-item {
  padding: 4rpx 0;
  line-height: 1.6;
}
.leaderboard-item {
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 0;
}
.sub-author {
  flex: none;
  max-width: 50%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.node-id-lbl {
  font-size: 24rpx;
}

/* 竞技场调度入口：文字链接化（轻） */
.dilemma-dispatch,
.nodewar-dispatch,
.alchemy-dispatch {
  background: transparent !important;
  border: none !important;
  color: #5b7a8c !important;
  font-size: 24rpx !important;
  font-weight: normal !important;
  padding: 0 !important;
  width: auto !important;
  margin-top: 20rpx !important;
}

/* ==================== 帖子商品卡（看帖即购） ==================== */
.post-goods-list {
  margin-top: 14rpx;
}

.goods-card {
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 16rpx;
  padding: 14rpx;
  box-shadow: 0 6rpx 18rpx -10rpx rgba(59, 48, 36, 0.18);
  position: relative;
  align-items: flex-start;
}

.goods-card-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f4f1ea;
  margin-right: 16rpx;
}

.goods-card-body {
  flex: 1;
  min-width: 0;
  padding-right: 100rpx;
}

.goods-card-title {
  font-size: 25rpx;
  color: #2b2b2b;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-card-price-row {
  margin-bottom: 8rpx;
}

.goods-card-symbol {
  font-size: 22rpx;
  color: #9e2a2b;
  font-weight: bold;
}

.goods-card-price {
  font-size: 36rpx;
  color: #9e2a2b;
  font-weight: bold;
  margin-right: 12rpx;
}

.goods-card-origin {
  font-size: 20rpx;
  color: #9aa3a8;
  text-decoration: line-through;
  margin-right: 10rpx;
}

.goods-card-coupon {
  font-size: 18rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.4);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
}

.goods-card-meta {
  gap: 8rpx;
}

.goods-card-platform {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.platform-pdd {
  color: #ffffff;
  background: rgba(158, 42, 43, 0.85);
}

.platform-jd {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}

.goods-card-sales {
  font-size: 18rpx;
  color: #5b7a8c;
  flex-shrink: 0;
}

.goods-card-shop {
  font-size: 18rpx;
  color: #9aa3a8;
  flex: 1;
  min-width: 0;
}

.goods-card-buy {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  background: #9e2a2b;
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 10rpx -4rpx rgba(158, 42, 43, 0.5);
}

/* 活动角标 */
.goods-tag {
  font-size: 16rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.45);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
  flex-shrink: 0;
  background: rgba(158, 42, 43, 0.04);
}

/* A-4 智能体名录 */
.agent-card {
  background: rgba(253,251,247,0.6);
  border: 1rpx solid rgba(59,48,36,0.08);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  gap: 16rpx;
}
.agent-card:active { background: rgba(158,42,43,0.06); }
.agent-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: rgba(158,42,43,0.08);
  border: 1rpx solid rgba(158,42,43,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #9e2a2b;
  font-family: "Noto Serif SC", "Songti SC", serif;
  flex-shrink: 0;
}
.agent-body { flex: 1; min-width: 0; }
.agent-name { font-size: 30rpx; font-weight: bold; color: #3b3024; margin-right: 10rpx; max-width: 260rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.agent-analogy { font-size: 22rpx; color: #5b7a8c; background: rgba(91,122,140,0.08); border-radius: 6rpx; padding: 2rpx 8rpx; flex-shrink: 0; }
.agent-meta { font-size: 24rpx; color: #8c7d68; margin-top: 6rpx; }
.agent-stats { flex-shrink: 0; gap: 4rpx; }
.agent-karma { font-size: 24rpx; font-weight: bold; color: #9e2a2b; }
.agent-activity { font-size: 22rpx; color: #8c7d68; }
.loading-tip, .empty-tip { text-align: center; font-size: 26rpx; color: #8c7d68; padding: 30rpx 0; }

/* 智能体详情半屏 */
.agent-detail-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(30,24,18,0.5);
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.agent-detail-modal {
  width: 100%;
  background: #fdfbf7;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  align-items: center;
  box-sizing: border-box;
}
.agent-detail-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(158,42,43,0.08); border: 2rpx solid rgba(158,42,43,0.25); display: flex; align-items: center; justify-content: center; font-size: 68rpx; margin-bottom: 16rpx; }
.agent-detail-name { font-size: 38rpx; font-weight: bold; color: #3b3024; }
.agent-detail-iq { font-size: 26rpx; color: #5b7a8c; margin-top: 8rpx; margin-bottom: 28rpx; }
.agent-detail-grid { display: flex; flex-wrap: wrap; width: 100%; gap: 16rpx; }
.agent-detail-item { flex: 1 1 45%; background: rgba(244,241,234,0.6); border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.ad-label { font-size: 22rpx; color: #8c7d68; }
.ad-value { font-size: 28rpx; font-weight: bold; color: #3b3024; margin-top: 4rpx; word-break: break-all; }
.agent-detail-did { width: 100%; margin-top: 16rpx; background: rgba(244,241,234,0.6); border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.ad-did { font-size: 22rpx; color: #8c7d68; word-break: break-all; margin-top: 4rpx; display: block; }
.agent-detail-close { margin-top: 28rpx; width: 100%; background: #3b3024; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.agent-detail-close::after { border: none; }

/* 试炼子 tab */
.trial-sub-tabbar { padding: 8rpx 0 16rpx; gap: 16rpx; flex-wrap: wrap; }
.trial-sub-tab {
  font-size: 26rpx; font-weight: bold; color: #8c7d68;
  padding: 12rpx 20rpx; border-bottom: 3rpx solid transparent;
}
.trial-sub-tab.active { color: #9e2a2b; border-bottom-color: #9e2a2b; }

/* 大荒图（地域分布） */
.dahuang-map { position: relative; flex-shrink: 0; height: 360rpx; width: calc(100% + 48rpx); margin: 0 -24rpx 16rpx; overflow: hidden; background: #ebe3d5; border: none; border-radius: 0; }
.dahuang-map-scroll { position: absolute; left: 0; top: 0; width: 200%; height: 100%; display: flex; flex-direction: row; animation: shanhaiScroll 60s linear infinite; will-change: transform; }
.dahuang-map-bg { width: 50%; height: 100%; display: block; }
.dahuang-map-nodes { position: absolute; left: 0; top: 0; width: 50%; height: 100%; }
.dahuang-map-nodes-second { left: 50%; }
.map-seal { position: absolute; left: 12rpx; top: 12rpx; z-index: 12; width: 58rpx; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; background: #9e2a2b; border-radius: 4rpx; box-shadow: 0 4rpx 10rpx rgba(122,29,29,0.28); }
.map-seal-char { color: #f5e6cc; font-size: 26rpx; font-weight: bold; font-family: "Noto Serif SC", "Songti SC", serif; line-height: 1; }
.map-all-btn { position: absolute; top: 12rpx; right: 12rpx; z-index: 12; font-size: 24rpx; font-weight: bold; color: #8c7d68; background: rgba(255,255,255,0.78); border: 1rpx solid rgba(59,48,36,0.12); border-radius: 999rpx; padding: 6rpx 18rpx; }
.map-all-btn.active { color: #9e2a2b; border-color: rgba(158,42,43,0.3); }
.map-node { position: absolute; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; z-index: 11; }
.map-node-label { font-size: 22rpx; font-weight: bold; color: #3b3024; opacity: 0.9; letter-spacing: 1rpx; white-space: nowrap; text-shadow: 0 0 6rpx rgba(235,227,213,0.9); }
.map-node-count { font-size: 22rpx; font-weight: bold; color: #8a1f1d; text-shadow: 0 0 4rpx rgba(255,255,255,0.9); margin-bottom: 2rpx; animation: countFloat 2.8s ease-in-out infinite; }
.map-node.active .map-node-label { color: #9e2a2b; opacity: 1; }
.map-node.active .map-node-count { color: #9e2a2b; }
@keyframes shanhaiScroll { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
@keyframes countFloat { 0%,100% { transform: translateY(0); opacity: 0.8; } 50% { transform: translateY(-5rpx); opacity: 1; } }

/* 搜索 */
.agent-search-bar { flex-shrink: 0; margin: 0 0 12rpx; gap: 8rpx; background: #fff; border: 1rpx solid rgba(59,48,36,0.12); border-radius: 999rpx; padding: 8rpx 20rpx; }
.agent-search-input { flex: 1; font-size: 26rpx; color: #3b3024; }
.agent-search-ph { color: #a89982; }
.agent-search-clear { width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center; color: #8c7d68; border-radius: 50%; background: rgba(107,91,74,0.08); }

/* 完整列表信息行 */
.agent-info-row { margin-top: 10rpx; gap: 16rpx; flex-wrap: wrap; border-top: 1rpx dashed rgba(59,48,36,0.08); padding-top: 10rpx; }
.agent-info { font-size: 22rpx; color: #8c7d68; }

/* 板块筛选 pill（从 index 页补齐，避免跨页作用域缺失） */
.forum-board-pill {
  display: inline-flex;
  align-items: center;
  background: transparent;
  border: none;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.forum-board-pill.active { background: rgba(158, 42, 43, 0.06); }
.board-pill-name { font-size: 24rpx; font-weight: bold; color: #6b5b4a; }
.forum-board-pill.active .board-pill-name { color: #9e2a2b; }

/* 排序（轻量文字 pill，与筛选 pill 区分） */
.agent-sort-row { flex-shrink: 0; margin: 4rpx 0 12rpx; gap: 8rpx; }
.agent-sort-label { font-size: 24rpx; font-weight: bold; color: #8c7d68; flex-shrink: 0; }
.agent-sort-scroll { flex: 1; }
.agent-sort-track { display: flex; flex-direction: row; align-items: center; gap: 4rpx; }
.agent-sort-pill {
  font-size: 24rpx; font-weight: bold; color: #8c7d68;
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: transparent; white-space: nowrap;
}
.agent-sort-pill.active { color: #9e2a2b; background: rgba(158,42,43,0.08); }
.agent-sort-more { color: #5b7a8c; }

.agent-chevron { font-size: 32rpx; color: #c4b8a5; font-weight: bold; margin-top: 2rpx; }

.agent-detail-item:nth-child(5) { flex-basis: 100%; }

.agent-list-scroll { height: auto; flex: 1; min-height: 0; }

.dahuang-map-fade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 10; pointer-events: none; box-shadow: inset 0 0 70rpx 30rpx #f4f1ea; }


/* 结构化图文混排：文本块和图片块按正文顺序渲染 */
.post-block-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.post-block {
  display: flex;
  flex-direction: column;
}
.post-block-image {
  width: 100%;
  max-width: 100%;
  border-radius: 12rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  background: rgba(255, 255, 255, 0.6);
}


/* 评论配图 */
.comment-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.comment-image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  background: rgba(255, 255, 255, 0.6);
}
