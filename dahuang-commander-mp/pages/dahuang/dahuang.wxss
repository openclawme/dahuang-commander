@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.offline-warning-banner {
  background: rgba(217,119,6, 0.12);
  border: 1rpx solid rgba(217,119,6, 0.4);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 26rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #d97706;
  font-weight: 500;
}

/* Custom Top Tab Bar Styles */
.dahuang-tab-navbar {
  display: flex;
  flex-direction: row;
  background: rgba(253,251,247, 0.8);
  border: 1rpx solid var(--brand-mid);
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx -4rpx var(--line-strong);
}

.dahuang-tab-nav-item {
  flex: 1;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--ink-mid);
  padding: 16rpx 0;
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dahuang-tab-nav-item.active {
  background: rgba(158,42,43, 0.15);
  border: 1rpx solid var(--brand-glow);
  color: var(--brand);
  font-weight: bold;
}

.tab-icon {
  font-size: 26rpx;
}

.tab-pane-container {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* Owner Highlighting (Requirement 2) */
.is-me-post {
  border: 1rpx solid var(--brand-line) !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.15) !important;
  background: rgba(158,42,43, 0.03) !important;
}

.me-post-badge {
  font-size: 26rpx;
  color: #d97706;
  background: rgba(217,119,6, 0.15);
  border: 1rpx solid rgba(217,119,6, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
  margin-left: auto;
}

.me-p-badge {
  font-size: 26rpx;
  color: var(--brand);
  background: rgba(158,42,43, 0.15);
  border: 1rpx solid var(--brand-line);
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  font-weight: bold;
}

.me-score-badge {
  font-size: 26rpx;
  color: #166534;
  background: rgba(22,101,52, 0.15);
  border: 1rpx solid rgba(22,101,52, 0.4);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.is-me-participant {
  background: var(--brand-soft) !important;
  border-left: 4rpx solid var(--brand) !important;
}

/* Dispatch Capsule Action Buttons (Requirement 3) */
.dispatch-cockpit-btn {
  background: var(--brand-soft) !important;
  border: 1rpx dashed var(--brand-glow) !important;
  color: var(--brand) !important;
  font-size: 26rpx !important;
  font-weight: bold !important;
  border-radius: 12rpx !important;
  padding: 14rpx 0 !important;
  width: 100% !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.dispatch-cockpit-btn:active {
  background: var(--brand-mid) !important;
  transform: scale(0.98) !important;
}

.elegant-dispatch-btn {
  background: linear-gradient(135deg, rgba(158,42,43, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%) !important;
  border: 1rpx solid rgba(139, 92, 246, 0.5) !important;
  color: #c4b5fd !important;
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.2) !important;
}

.forum-web-btn {
  font-size: 26rpx;
  font-weight: bold;
  color: #5b7a8c;
  background: rgba(56, 189, 248, 0.1);
  border: 1rpx solid rgba(56, 189, 248, 0.4);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 0;
  line-height: 1.2;
}
.forum-web-btn:active {
  background: rgba(56, 189, 248, 0.2);
}

.dispatch-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

/* Mini Cockpit Drawer Popup Modal (Requirement 3) */
.mini-cockpit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(244,241,234, 0.85);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.mini-cockpit-modal {
  background: var(--paper);
  border-top: 2rpx solid var(--brand-glow);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 40rpx var(--brand-mid);
  animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 85vh;
}

.cockpit-modal-header {
  border-bottom: 1rpx solid var(--line);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.cockpit-modal-icon {
  font-size: 38rpx;
}

.cockpit-modal-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink);
}

.cockpit-modal-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

.mini-online-badge {
  font-size: 26rpx;
  color: #166534;
  background: rgba(22,101,52, 0.1);
  border: 1rpx solid rgba(22,101,52, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.cockpit-close-btn {
  width: 44rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(59, 48, 36, 0.1);
  color: var(--danger);
  font-size: 26rpx;
  cursor: pointer;
}

/* Dialogue List */
.cockpit-dialog-scroll {
  height: 480rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.mini-chat-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.mini-chat-user {
  align-items: flex-end;
}

.mini-chat-agent {
  align-items: flex-start;
}

.mini-chat-bubble {
  max-width: 85%;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.mini-chat-user .mini-chat-bubble {
  background: var(--brand);
  color: var(--paper);
  font-weight: 500;
  border-top-right-radius: 2rpx;
}

.mini-chat-agent .mini-chat-bubble {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--line);
  color: var(--ink-strong);
  border-top-left-radius: 2rpx;
}

.mini-chat-time {
  font-size: 26rpx;
  color: var(--ink-mid);
  margin-top: 6rpx;
}

/* Steps in bubble */
.mini-bubble-task-container {
  width: 100%;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 12rpx;
}

.mini-progress-track {
  width: 100%;
  height: 6rpx;
  background: rgba(59, 48, 36, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: var(--brand);
  box-shadow: 0 6rpx 16rpx -6rpx var(--line-stronger);
  transition: width 0.3s ease;
}

.mini-task-item {
  font-size: 26rpx;
}

.mini-task-title {
  color: var(--ink-soft);
}

.mini-task-title.done {
  color: var(--ink-mid);
  text-decoration: line-through;
}

.mini-task-badge {
  font-size: 26rpx;
  font-weight: bold;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}

.mini-task-badge.status-SUCCESS {
  color: #166534;
}
.mini-task-badge.status-PROCESSING {
  color: var(--brand);
}
.mini-task-badge.status-WAITING {
  color: var(--ink-mid);
}

.mini-progress-num {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--brand);
  margin-left: auto;
}

/* Quick Dispatch Option Templates */
.cockpit-quick-options {
  margin-bottom: 20rpx;
}

.quick-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink-mid);
  margin-bottom: 12rpx;
}

.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quick-opt-btn {
  background: rgba(255, 255, 255, 0.02) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
  color: var(--ink-faint) !important;
  font-size: 26rpx !important;
  padding: 16rpx 20rpx !important;
  border-radius: 10rpx !important;
  text-align: left !important;
  line-height: 1.3 !important;
  width: 100% !important;
}

.quick-opt-btn:active {
  background: rgba(158,42,43, 0.1) !important;
  border-color: var(--brand-line) !important;
  color: var(--brand) !important;
}

/* Custom Mini Input Bar */
.cockpit-input-bar {
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  gap: 12rpx;
}

.cockpit-input {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.cockpit-send-btn {
  background: var(--ink-soft) !important;
  color: var(--ink-soft) !important;
  font-size: 26rpx !important;
  font-weight: bold !important;
  padding: 12rpx 24rpx !important;
  border-radius: 8rpx !important;
  transition: all 0.2s ease !important;
  line-height: 1.5 !important;
}

.cockpit-send-btn.active {
  background: var(--brand) !important;
  color: var(--paper) !important;
  box-shadow: 0 6rpx 18rpx -6rpx var(--brand-line) !important;
}

/* Keyframes */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* Inline Comments Section */
.comments-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  animation: fadeIn 0.3s ease;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.comment-item {
  background: rgba(255, 255, 255, 0.03);
  padding: 12rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
}

.comment-author {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--ink-soft);
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 26rpx;
  color: var(--ink-strong);
  line-height: 1.4;
}

.loading-comments {
  font-size: 26rpx;
  color: var(--ink-mid);
  text-align: center;
  padding: 10rpx 0;
}

.comment-input-area {
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.comment-input-area .cyber-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.comment-input-area .mini-btn {
  padding: 0 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin: 0;
}
/* 扁平化：tab 面板不再套外框，内容直接贴在页面背景上 */
.tab-pane-container {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  margin-bottom: 0;
}

/* 帖子列表：用分隔线代替卡片框 */
.forum-post-card {
  background: transparent;
  border: none;
  border-bottom: 1rpx solid var(--line-weak);
  border-radius: 0;
  padding: 24rpx 0;
  margin-bottom: 0;
}

/* 游戏/挑战卡片降为轻量面板 */
.arena-game-card,
.alchemy-challenge-card {
  border-radius: 12rpx;
  border-color: var(--line-weak);
  box-shadow: none;
}
/* 横向溢出修复：可收缩元素加省略号，次要元素不收缩 */
.post-tag,
.post-meta,
.me-post-badge,
.sub-index {
  flex-shrink: 0;
}
.post-author {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub-meta {
  flex: 1;
  min-width: 0;
}
.sub-author {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sub-name {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.game-name {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.drawer-meta-item {
  word-break: break-all;
}
.poster-card-body {
  word-break: break-all;
}

/* 扁平化：去掉竞技场/炼丹内层面板边框与底纹 */
.dilemma-info-box,
.dilemma-control-cockpit,
.alchemy-leaderboard-panel,
.alchemy-compiler-panel {
  background: transparent;
  border: none;
  box-shadow: none;
}
.node-control-drawer {
  background: transparent;
  border: none;
  border-top: 1rpx solid var(--line-weak);
  border-radius: 0;
  box-shadow: none;
}
.leaderboard-item {
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.06);
  border-radius: 0;
}
/* 窄屏纵向堆叠，宽屏（平板/横屏）恢复两栏 */
@media (max-width: 767px) {
  .grid-row {
    flex-direction: column;
  }
  .dilemma-info-box,
  .dilemma-control-cockpit,
  .alchemy-leaderboard-panel,
  .alchemy-compiler-panel {
    flex: none;
  }
}
.mini-task-title {
  flex: 1;
  min-width: 0;
}
.mini-task-badge {
  flex-shrink: 0;
}
.sub-specs {
  flex-wrap: wrap;
}
/* 炼丹页：元信息纵向排列，榜单两行清晰化 */
.challenge-meta-grid {
  grid-template-columns: 1fr;
}
.challenge-meta-item {
  padding: 4rpx 0;
  line-height: 1.6;
}
.leaderboard-item {
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 0;
}
.sub-author {
  flex: none;
  max-width: 50%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.node-id-lbl {
  font-size: 24rpx;
}
