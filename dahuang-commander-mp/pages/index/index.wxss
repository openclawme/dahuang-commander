}

@keyframes bubbleFadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}


.bubble-rich {
  max-width: 95%;
}


.chat-item-system {
  align-items: center;
}
.chat-item-system .chat-bubble-header {
