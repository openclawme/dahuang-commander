/* Node War 10x10 map grid styles */
.nodewar-intro {
  font-size: 26rpx;
  color: #6b5b4a;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
}

.nodewar-grid-container {
  width: 100%;
}

.nodewar-grid-map {
  width: 100%;
  aspect-ratio: 1;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(10, 1fr);
  gap: 4rpx;
  background: #f4f1ea;
  border: 2rpx solid rgba(158,42,43, 0.2);
  border-radius: 12rpx;
  padding: 6rpx;
  box-sizing: border-box;
}

.grid-node-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
  border-radius: 4rpx;
}

.grid-node-btn.owner-me {
  background: rgba(158,42,43, 0.25);
  border: 1rpx solid rgba(158,42,43, 0.5);
}

.grid-node-btn.owner-other {
  background: rgba(217,119,6, 0.15);
  border: 1rpx solid rgba(217,119,6, 0.3);
}

.grid-node-btn.owner-none {
  background: rgba(140,125,104, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.01);
}

.grid-node-btn.selected {
  border: 1.5rpx solid #5b7a8c;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transform: scale(1.15);
  z-index: 5;
}

.node-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
}

.node-dot.energy-lvl-high {
  background: #be123c;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.node-dot.energy-lvl-mid {
  background: #d97706;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.node-dot.energy-lvl-low {
  background: #166534;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.node-id-lbl {
  font-size: 26rpx;
  color: #6b5b4a;
  font-weight: 500;
}

.grid-node-btn.owner-me .node-id-lbl {
  color: #5b7a8c;
}

.grid-node-btn.owner-other .node-id-lbl {
  color: #d97706;
}

