}

.wechat-image-status {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 20rpx;
  border-radius: 10rpx;
}
.wechat-image-status.error { color: #f6d6d6; background: rgba(158,42,43,0.55); }

/* ===== 主人对话图片（发送历史 + 输入区缩略图统一） ===== */
.human-image-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.human-image-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
}

/* ==================== 商品购物卡片（购物 v2） ==================== */
/* 纸白卡片浮在青灰气泡上；朱砂只用于价格强调与按钮反色，贴合古风淡雅体系 */
.bubble-goods-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.goods-card {
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 16rpx;
  padding: 14rpx;
  box-shadow: 0 6rpx 18rpx -10rpx rgba(59, 48, 36, 0.18);
  position: relative;
  align-items: flex-start;
}

.goods-card-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f4f1ea;
  margin-right: 16rpx;
}

.goods-card-body {
  flex: 1;
  min-width: 0;
  padding-right: 110rpx; /* 给右下角"去购买"按钮让位 */
}

.goods-card-title {
  font-size: 26rpx;
  color: #2b2b2b;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-card-price-row {
  margin-bottom: 10rpx;
}

.goods-card-symbol {
  font-size: 24rpx;
  color: #9e2a2b;
  font-weight: bold;
}

.goods-card-price {
  font-size: 38rpx;
  color: #9e2a2b;
  font-weight: bold;
  margin-right: 12rpx;
}

.goods-card-origin {
  font-size: 22rpx;
  color: #9aa3a8;
  text-decoration: line-through;
  margin-right: 10rpx;
}

.goods-card-coupon {
  font-size: 20rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.4);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.goods-card-meta {
  gap: 10rpx;
}

.goods-card-platform {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.platform-pdd {
  color: #ffffff;
  background: rgba(158, 42, 43, 0.85);
}

.platform-jd {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}

.goods-card-sales {
  font-size: 20rpx;
  color: #5b7a8c;
  flex-shrink: 0;
}

.goods-card-shop {
  font-size: 20rpx;
  color: #9aa3a8;
  flex: 1;
  min-width: 0;
}

.goods-card-buy {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  background: #9e2a2b;
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 10rpx -4rpx rgba(158, 42, 43, 0.5);
}

/* 活动角标（秒杀/百亿补贴）：朱砂描边小徽章点缀 */
.goods-tag {
  font-size: 18rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.45);
  border-radius: 6rpx;
  padding: 1rpx 8rpx;
  flex-shrink: 0;
  background: rgba(158, 42, 43, 0.04);
}

/* 登录推荐条 + 回复建议 chips */
.recommendation-strip {
  padding: 12rpx 16rpx;
  background: rgba(253,251,247,0.9);
  border: 1rpx solid rgba(158,42,43,0.18);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.recommendation-header { margin-bottom: 10rpx; }
.recommendation-title { font-size: 26rpx; font-weight: bold; color: #6b5b4a; }
.recommendation-dismiss {
  width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center;
  border-radius: 50%; color: #6b5b4a; font-size: 26rpx; background: rgba(107,91,74,0.06);
}
.recommendation-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.recommendation-chip {
  display: flex; align-items: center; gap: 4rpx;
  padding: 12rpx 20rpx; border-radius: 30rpx;
  background: rgba(158,42,43,0.06); border: 1rpx solid rgba(158,42,43,0.22);
  font-size: 26rpx; color: #6b3a2f; font-weight: bold;
}
.recommendation-chip-text { max-width: 300rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.recommendation-chip-arrow { color: #9e2a2b; }
.recommendation-chip:active { background: rgba(158,42,43,0.14); }

/* 步骤级失败但整体完成的轻量提示（区别于红色错误横幅） */
.partial-fail-note {
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  background: rgba(217, 119, 6, 0.08);
  border: 1rpx solid rgba(217, 119, 6, 0.3);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #b07d3c;
}

/* 建议/推荐 chips：两列网格，等宽对齐，一行两个两行四条 */
.suggestion-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}
.suggestion-chip {
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  min-width: 0;
  padding: 12rpx 14rpx; border-radius: 999rpx;
  background: rgba(91,122,140,0.08); border: 1rpx solid rgba(91,122,140,0.25);
  font-size: 26rpx; color: #4a6a7c; font-weight: bold;
  box-sizing: border-box;
}
.suggestion-chip-text {
  flex: 0 1 auto;
  max-width: 100%;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  text-align: center;
}
.suggestion-chip-arrow { color: #5b7a8c; flex-shrink: 0; }
.suggestion-chip:active {
  background: rgba(91,122,140,0.18);
  transform: scale(0.98);
  transition: transform 0.1s ease;
}


/* ==========================================================================
   主人快捷面板（磨砂玻璃浮钮 + 指令/任务抽屉）
   ========================================================================== */
.quick-fab {
  position: absolute;
  left: 0;
  top: 0;
  width: 96rpx;
  height: 96rpx;
  z-index: 1001; /* 遮罩之下：面板打开时点浮钮位置=点遮罩=关闭，浮钮随页面一起沉下去 */
  transition: opacity 0.2s ease;
}

/* 30 秒未操作的呼吸态：降透明度，不挡视线 */
.quick-fab-idle {
  opacity: 0.45;
}

/* 松手后：篮球式跳起落下——下压蓄力 → 起跳 → 落地弹起两下 → 落在边缘偏上处 */
.quick-fab-jump {
  transform-origin: 50% 100%;
  animation: quickFabBounce 1.1s cubic-bezier(0.34, 0.9, 0.44, 1) both;
}
@keyframes quickFabBounce {
  0%   { transform: translateY(0) scale(1, 1); }
  12%  { transform: translateY(4px) scale(0.9, 1.1); }    /* 下压蓄力 */
  38%  { transform: translateY(-38px) scale(1.04, 0.96); } /* 起跳 */
  56%  { transform: translateY(0) scale(1.09, 0.91); }     /* 落地压扁 */
  70%  { transform: translateY(-14px) scale(1, 1); }       /* 弹起 */
  84%  { transform: translateY(0) scale(1.04, 0.96); }     /* 二次落地 */
  100% { transform: translateY(0) scale(1, 1); }
}

/* 起跳后：横移滑向边缘（top 同步滑到比松手处略高的位置） */
.quick-fab-glide {
  transition: left 0.55s cubic-bezier(0.25, 0.8, 0.3, 1), top 0.55s cubic-bezier(0.25, 0.8, 0.3, 1);
}

.quick-fab-halo {
  position: absolute;
  left: -18rpx;
  top: -18rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(158, 42, 43, 0.30) 0%, rgba(212, 175, 55, 0.18) 40%, rgba(91, 122, 140, 0.12) 62%, transparent 76%);
  filter: blur(6rpx);
  animation: quickFabHalo 4.8s ease-in-out infinite;
  pointer-events: none;
}

.quick-fab-ring {
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    rgba(158, 42, 43, 0.52) 0deg,
    rgba(212, 175, 55, 0.50) 120deg,
    rgba(91, 122, 140, 0.44) 240deg,
    rgba(158, 42, 43, 0.52) 360deg
  );
  filter: blur(4rpx) saturate(1.45);
  opacity: 0.72;
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 7rpx), #000 calc(100% - 5rpx));
  mask: radial-gradient(farthest-side, transparent calc(100% - 7rpx), #000 calc(100% - 5rpx));
  animation: quickFabRingSpin 18s linear infinite, quickFabRingHue 9s ease-in-out infinite;
  pointer-events: none;
}

.quick-fab-sheen {
  position: absolute;
  left: 50%;
  top: 5rpx;
  width: 48rpx;
  height: 16rpx;
  margin-left: -24rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.22) 58%, transparent 100%);
  filter: blur(2rpx);
  z-index: 2;
  pointer-events: none;
}

@keyframes quickFabHalo {
  0%, 100% { transform: scale(0.90); opacity: 0.42; }
  50% { transform: scale(1.10); opacity: 0.95; }
}

@keyframes quickFabRingSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.quick-fab-glass {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.12) 52%, rgba(255, 255, 255, 0.08) 100%);
  -webkit-backdrop-filter: blur(34rpx) saturate(2);
  backdrop-filter: blur(34rpx) saturate(2);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 44rpx -16rpx rgba(59, 48, 36, 0.38), 0 0 0 2rpx rgba(255, 255, 255, 0.28), 0 0 36rpx -6rpx rgba(212, 175, 55, 0.48), inset 0 2rpx 0 rgba(255, 255, 255, 0.98), inset 0 -14rpx 28rpx -20rpx rgba(255, 255, 255, 0.7), inset 0 0 30rpx rgba(255, 255, 255, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 灵气雾气：白雾 + 金雾两层，缓慢漂移/旋转/呼吸（星芒转动时雾气流转变幻） */
.quick-fab-mist {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.quick-fab-mist-a {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  left: -46rpx;
  top: -42rpx;
  background: radial-gradient(circle at 42% 46%, rgba(91, 122, 140, 0.55) 0%, rgba(91, 122, 140, 0.2) 40%, transparent 68%);
  opacity: 0.7;
  animation: fab-mist-drift-a 7s ease-in-out infinite alternate;
}
.quick-fab-mist-b {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  right: -50rpx;
  bottom: -46rpx;
  background: radial-gradient(circle at 55% 40%, rgba(212, 175, 55, 0.68) 0%, rgba(212, 175, 55, 0.24) 42%, transparent 72%);
  opacity: 0.75;
  animation: fab-mist-drift-b 11s ease-in-out infinite alternate;
}
@keyframes fab-mist-drift-a {
  0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 0.5; }
  100% { transform: translate(24rpx, -18rpx) rotate(40deg) scale(1.3); opacity: 0.95; }
}
@keyframes fab-mist-drift-b {
  0% { transform: translate(0, 0) rotate(0deg) scale(1.16); opacity: 0.8; }
  100% { transform: translate(-24rpx, 18rpx) rotate(-45deg) scale(0.84); opacity: 0.35; }
}

.quick-fab-radar {
  position: relative;
  width: 66rpx;
  height: 66rpx;
}

.quick-fab-radar-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(158, 42, 43, 0.5);
  opacity: 0;
  animation: quickFabRadar 2.2s ease-out infinite;
}

.quick-fab-radar-ring:nth-child(2) { animation-delay: 0.72s; }
.quick-fab-radar-ring:nth-child(3) { animation-delay: 1.44s; }

.quick-fab-radar-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #c04a4b 0%, #9e2a2b 70%);
  box-shadow: 0 0 12rpx rgba(158, 42, 43, 0.45);
  transform: translate(-50%, -50%);
}

.quick-fab-star {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(1.38);
}

.quick-fab-star .claude-starburst-breathe {
  animation: quickFabStarBreathe 4.8s ease-in-out infinite;
}

.quick-fab-star .claude-starburst {
  animation: quickFabStarSpin 14s linear infinite;
}

@keyframes quickFabStarBreathe {
  0%, 100% { transform: scale(0.92); opacity: 0.7; }
  50% { transform: scale(1.26); opacity: 1; }
}

@keyframes quickFabStarSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.quick-fab-icon {
  position: relative;
  z-index: 1;
  color: #8c7d68;
  font-size: 30rpx;
  font-weight: bold;
}

.quick-fab-hidden {
  opacity: 0;
  pointer-events: none;
}

@keyframes quickFabRadar {
  0% { transform: translate(-50%, -50%) scale(0.32); opacity: 0.9; }
  100% { transform: translate(-50%, -50%) scale(1.85); opacity: 0; }
}

.quick-panel-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1002;
  background: rgba(59, 48, 36, 0.14); /* 轻微暗化：打开面板时聊天区沉下去 */
}

.quick-panel {
  position: absolute;
  /* 定位由 quickPanelStyle 锚定 FAB 动态计算（左/右 + 上/下） */
  width: 610rpx;
  max-height: 64vh;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.13) 44%, rgba(255, 255, 255, 0.09) 100%),
    radial-gradient(ellipse at 50% -20%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 62%),
    radial-gradient(circle at 14% 0%, rgba(212, 175, 55, 0.05) 0%, rgba(212, 175, 55, 0) 44%),
    radial-gradient(circle at 100% 100%, rgba(158, 42, 43, 0.04) 0%, rgba(158, 42, 43, 0) 48%),
    rgba(255, 253, 249, 0.12);
  -webkit-backdrop-filter: blur(56rpx) saturate(2);
  backdrop-filter: blur(56rpx) saturate(2);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 36rpx;
  box-shadow: 0 34rpx 90rpx -28rpx rgba(59, 48, 36, 0.42), 0 0 42rpx -10rpx rgba(255, 255, 255, 0.42), inset 0 2rpx 0 rgba(255, 255, 255, 0.95), inset 0 -22rpx 44rpx -32rpx rgba(255, 255, 255, 0.65), inset 0 0 60rpx rgba(255, 255, 255, 0.14);
  z-index: 1003;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.quick-panel-header {
  padding: 24rpx 92rpx 18rpx 26rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.08);
}

.quick-panel-head-left {
  gap: 16rpx;
  min-width: 0;
}

.quick-panel-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  /* 青玉小印：淡雅墨青，去红色化 */
  background: linear-gradient(150deg, rgba(91, 122, 140, 0.88) 0%, rgba(58, 84, 98, 0.9) 100%);
  color: #f2ede2;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Noto Serif SC", "Songti SC", serif;
  border: 1rpx solid rgba(212, 175, 55, 0.45);
  box-shadow: 0 10rpx 22rpx -10rpx rgba(58, 84, 98, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

.quick-panel-title-box {
  gap: 3rpx;
}

.quick-panel-title {
  font-size: 31rpx;
  font-weight: bold;
  color: #3b3024;
  letter-spacing: 2rpx;
  font-family: "Noto Serif SC", "Songti SC", serif;
}

.quick-panel-subtitle {
  font-size: 20rpx;
  color: rgba(59, 48, 36, 0.55);
  letter-spacing: 1rpx;
}

.quick-panel-close {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 12;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b5b4a;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow: 0 6rpx 16rpx -10rpx rgba(59, 48, 36, 0.35);
}

.quick-panel-scroll {
  flex: 1;
  min-height: 0;
  max-height: 54vh;
  padding: 8rpx 20rpx 26rpx;
  box-sizing: border-box;
}

.quick-section {
  margin-top: 20rpx;
}

.quick-section-head {
  margin-bottom: 14rpx;
}

.quick-section-dot {
  width: 8rpx;
  height: 26rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}

.task-dot { background: linear-gradient(180deg, #7fa0b2, #5b7a8c); }
.command-dot { background: linear-gradient(180deg, #e0c36a, #c9a34c); }
.rec-dot { background: linear-gradient(180deg, #a9c09a, #8ba678); }

.quick-section-title {
  font-size: 25rpx;
  font-weight: bold;
  color: #3b3024;
  letter-spacing: 2rpx;
  font-family: "Noto Serif SC", "Songti SC", serif;
}

.quick-refresh {
  font-size: 21rpx;
  color: #5b7a8c;
  background: rgba(255, 255, 255, 0.11);
  border: 1rpx solid rgba(91, 122, 140, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
  transition: all 0.2s ease;
}

.quick-refresh-hover {
  background: rgba(91, 122, 140, 0.12);
}

.quick-task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0.10) 100%);
  -webkit-backdrop-filter: blur(24rpx) saturate(1.7);
  backdrop-filter: blur(24rpx) saturate(1.7);
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 10rpx 24rpx -18rpx rgba(59, 48, 36, 0.4);
  transition: transform 0.2s ease;
}

.quick-task-item-hover {
  transform: scale(0.985);
  background: rgba(255, 255, 255, 0.68);
}

.quick-task-status {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #3b5e59;
  box-shadow: 0 0 0 6rpx rgba(59, 94, 89, 0.12);
  flex-shrink: 0;
  animation: quickTaskPulse 1.8s ease-in-out infinite;
}

@keyframes quickTaskPulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(59, 94, 89, 0.10); }
  50% { box-shadow: 0 0 0 9rpx rgba(59, 94, 89, 0.16); }
}

.quick-task-main {
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.quick-task-title {
  font-size: 25rpx;
  color: #3b3024;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-task-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(59, 48, 36, 0.08);
  overflow: hidden;
}

.quick-task-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7fa0b2, #3b5e59);
  border-radius: 4rpx;
}

.quick-task-progress {
  font-size: 22rpx;
  font-weight: bold;
  color: #3b5e59;
  flex-shrink: 0;
}

.quick-chip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 19rpx 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.11) 100%);
  -webkit-backdrop-filter: blur(24rpx) saturate(1.7);
  backdrop-filter: blur(24rpx) saturate(1.7);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border-left: 5rpx solid rgba(212, 175, 55, 0.5);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 10rpx 24rpx -18rpx rgba(59, 48, 36, 0.38);
  transition: transform 0.2s ease;
}

.quick-chip-hover {
  transform: scale(0.985);
  border-left-color: #d4af37;
  background: rgba(255, 255, 255, 0.72);
}

.quick-chip-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: rgba(91, 122, 140, 0.1);
  color: #5b7a8c;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: "Noto Serif SC", "Songti SC", serif;
}

.quick-chip-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #3b3024;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-chip-arrow {
  font-size: 30rpx;
  color: #8c7d68;
  flex-shrink: 0;
}

.quick-empty {
  font-size: 24rpx;
  color: #8c7d68;
  padding: 12rpx 0;
}


/* 快捷面板首次加载态：星芒推演动画 + 文案 */
.quick-panel-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 64rpx 0 56rpx;
}

.quick-loading-star {
  transform: scale(1.7);
}

.quick-loading-text {
  font-size: 24rpx;
  color: #8c7d68;
  letter-spacing: 2rpx;
  animation: quickLoadingBreath 2.4s ease-in-out infinite;
}

@keyframes quickLoadingBreath {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}


/* 推荐理由：每条快捷指令下面的一行小字 */
.quick-chip-body {
  flex: 1;
  min-width: 0;
  gap: 4rpx;
}
.quick-chip-reason {
  font-size: 20rpx;
  color: #8c7d68;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* 灵犀笺：全部任务入口 + 任务中心底部入口 */
.quick-section-more {
  font-size: 22rpx;
  color: #5b7a8c;
  padding: 4rpx 10rpx;
}
.quick-panel-footer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.16);
}
.quick-panel-footer-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: linear-gradient(150deg, #b23a3b, #7f1d1d);
  color: #f5e6cc;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.quick-panel-footer-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b3024;
  flex-shrink: 0;
}
.quick-panel-footer-sub {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #8c7d68;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-panel-footer-arrow {
  font-size: 30rpx;
  color: #8c7d68;
  flex-shrink: 0;
}


/* 图片快捷操作建议：选图后出现，点击直接带图发送 */
.image-quick-actions {
  margin-bottom: 10rpx;
}
.image-quick-scroll {
  width: 100%;
  white-space: nowrap;
}
.image-quick-track {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}
.image-quick-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  box-shadow: 0 4rpx 12rpx -8rpx rgba(59, 48, 36, 0.25);
}
.image-quick-chip-hover {
  background: rgba(158, 42, 43, 0.08);
  border-color: rgba(158, 42, 43, 0.3);
}
.image-quick-chip-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: rgba(158, 42, 43, 0.08);
  color: #9e2a2b;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-quick-chip-text {
  font-size: 24rpx;
  color: #3b3024;
}


/* Agent 回复图片：网络图转存后以原生 image 显示，支持点击预览 */
.agent-image-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}
.agent-image-thumb {
  width: 100%;
  max-width: 520rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  background: rgba(255, 255, 255, 0.6);
}


/* 聊天图文混排：文字段和图片段按消息顺序渲染 */
.msg-segments {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.msg-segment-image {
  width: 100%;
  max-width: 520rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  background: rgba(255, 255, 255, 0.6);
}

.msg-miniapp-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(201, 163, 76, 0.10);
  border: 1rpx solid rgba(168, 132, 47, 0.35);
  max-width: 420rpx;
  box-sizing: border-box;
}
.msg-miniapp-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: rgba(176, 84, 63, 0.85);
  color: #fdf8ec;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-miniapp-label {
  color: #8a6d1f;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.msg-miniapp-btn:active {
  background: rgba(201, 163, 76, 0.2);
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.msg-link {
  display: block;
  color: #4a7f99;
  text-decoration: underline;
  word-break: break-all;
  font-size: 26rpx;
  line-height: 1.6;
  margin: 4rpx 0;
}



/* 聊天图文混排：原生表格（浅色主题，可横向滚动，不再出现深色黑框） */
.msg-segment-table {
  width: 100%;
  margin: 8rpx 0;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.msg-table-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #3b5e59;
  padding: 16rpx 18rpx 8rpx;
}
.msg-table-scroll { width: 100%; }
.msg-table { display: inline-block; min-width: 100%; }
/* grid 定列宽（grid-template-columns 由 wxml 按表头数注入）：表头与数据行严格对齐 */
.msg-table-row { display: grid; }
.msg-table-head { background: rgba(91, 122, 140, 0.07); }
.msg-table-cell {
  min-width: 0;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  border-right: 1rpx solid rgba(59, 48, 36, 0.06);
  word-break: break-all;
  box-sizing: border-box;
}
.msg-table-th {
  font-weight: bold;
  color: #5b7a8c;
  border-bottom: 1rpx solid rgba(91, 122, 140, 0.25);
}

/* 段落内图表：跟随正文位置。
   注意：这里刻意【不用 scroll-view】——内联在 flex 容器里的原生 scroll-view
   在部分基础库上会把 canvas 高度算成 0，导致图表画不出来（一片空白）。
   用普通 view + overflow-x 滚动：点数多时按 _minWidthPx 加宽横向滚动，
   点数少时 min-width:100% 拉满容器，与末尾图表的观感统一。 */
.bubble-chart-inline {
  display: block;
  width: 100%;
  margin: 10rpx 0;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  padding: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.bubble-chart-inline-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.bubble-chart-canvas-inline {
  display: block;
  height: 400rpx;
}


