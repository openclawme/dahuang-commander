/* 富内容气泡（Agent 生成的 HTML 卡片/表格）：接近全宽，提升表格可读性 */
.bubble-rich {
  max-width: 96%;
  width: 96%;
  padding: 14rpx 16rpx;
}
.bubble-rich .msg-body-rich {
  width: 100%;
}

/* 聊天面板：收紧左右留白，提高横向空间利用率 */
.chat-panel {
  padding: 20rpx 4rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}
/* 审批弹窗与兜底提示：长文本自动换行，避免横向溢出 */
.info-row {
  align-items: flex-start;
}
.info-value {
  word-break: break-all;
}
.fallback-action-box {
  min-width: 0;
}
.fallback-action-box text {
  word-break: break-all;
}
