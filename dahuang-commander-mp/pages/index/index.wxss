}
.decision-banner-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}
.decision-banner-arrow {
  font-size: 32rpx;
  color: #9e2a2b;
}


.chat-bubble-body {
