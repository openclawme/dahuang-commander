/* Cause-and-effect particles */
.cause-particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  opacity: 0;
  z-index: 3;
}

.cause-particle.gold {
  background: #d97706;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  animation: particle-drift-up 1.5s ease-out infinite;
}

.cause-particle.blue {
  background: #9e2a2b;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  animation: particle-drift-down 1.5s ease-out infinite;
}

@keyframes spin-aura {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes particle-drift-up {
  0% { transform: translateY(15rpx) scale(0); opacity: 0; }
  20% { opacity: 0.9; }
  100% { transform: translateY(-45rpx) scale(1); opacity: 0; }
}

@keyframes particle-drift-down {
  0% { transform: translateY(-45rpx) scale(0); opacity: 0; }
  20% { opacity: 0.9; }
  100% { transform: translateY(15rpx) scale(1); opacity: 0; }
}

