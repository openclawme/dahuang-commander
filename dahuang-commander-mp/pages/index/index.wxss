/* 审批弹窗与兜底提示：长文本自动换行，避免横向溢出 */
.info-row {
  align-items: flex-start;
}
.info-value {
  word-break: break-all;
}
.fallback-action-box {
  min-width: 0;
}
.fallback-action-box text {
