.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  transition: transform 0.12s cubic-bezier(0.25, 1, 0.5, 1);
}

/* Header Panel Styles */
.header-panel {
  margin-top: 10rpx;
}

.bubble-error {
  border: 1px solid rgba(190, 18, 60, 0.6) !important;
  background: rgba(190, 18, 60, 0.12) !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(190, 18, 60, 0.25) !important;
}

.avatar-ring {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 4rpx solid #9e2a2b;
  background-color: rgba(158, 42, 43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  margin-right: 20rpx;
}

.avatar-char {
  font-size: 40rpx;
}

.agent-meta {
  justify-content: center;
}

.agent-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.agent-did {
  font-size: 24rpx;
  color: #6b5b4a;
  margin-top: 4rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.online-pulse {
  background-color: rgba(59, 94, 89, 0.15);
  border: 1rpx solid #3b5e59;
  color: #3b5e59;
  animation: pulse-green 2s infinite alternate;
}

.offline-glow {
  background-color: rgba(190, 18, 60, 0.15);
  border: 1rpx solid #be123c;
  color: #be123c;
}

.status-dot {
  font-size: 24rpx;
  margin-right: 8rpx;
}

@keyframes pulse-green {
  0% {
    box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  }
  100% {
    box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  }
}

.stats-row {
  border-top: 1rpx solid rgba(107, 91, 74, 0.2);
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
}

/* 命名历史遗留：text-cyan 实为朱砂红，text-purple 实为青灰，仅保留类名兼容 */
.text-cyan {
  color: #9e2a2b;
}

.text-purple {
  color: #5b7a8c;
}

.text-emerald {
  color: #3b5e59;
}

/* 历史遗留幽灵类：补上浅色纸主题下的语义色，避免白字白底事故 */
.text-white {
  color: #6b5b4a;
}
.text-yellow {
  color: #d97706;
}
.text-slate {
  color: #6b5b4a;
}
.text-green {
  color: #3b5e59;
}
.text-ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Progress Panel Styles */
.progress-panel {
  display: flex;
  flex-direction: column;
}

.panel-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: bold;
  color: #5b7a8c;
}

.command-bubble {
  background: rgba(91, 122, 140, 0.08);
  border-left: 6rpx solid #5b7a8c;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.bubble-prefix {
  font-size: 24rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.bubble-content {
  font-size: 24rpx;
  color: #6b5b4a;
}

.progress-track {
  height: 10rpx;
  background: rgba(107, 91, 74, 0.2);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b7a8c, #9e2a2b);
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  font-size: 24rpx;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 8rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
}

.task-icon {
  margin-top: 2rpx;
}

.task-detail {
  flex: 1;
  color: #8c7d68;
}

.task-done {
  text-decoration: line-through;
  color: #6b5b4a;
}

.empty-tasks {
  padding: 40rpx 0;
}

/* 空状态统一：文字方印（与全端印章语言一致） */
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  font-family: "Noto Serif SC", "Songti SC", serif;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.06);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #6b5b4a;
}

/* Logs Panel Styles */
.logs-panel {
  display: flex;
  flex-direction: column;
}

.panel-subtitle {
  font-size: 24rpx;
  color: rgba(59, 94, 89, 0.5);
  letter-spacing: 2rpx;
}

.logs-panel-container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
  margin-bottom: 12rpx;
}

.logs-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  border: 1rpx solid rgba(59, 94, 89, 0.1);
  background-color: rgba(244, 241, 234, 0.8);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.log-line {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  align-items: flex-start;
}

.log-time {
  color: #6b5b4a;
  width: 120rpx;
  flex-shrink: 0;
}

.log-tag {
  font-weight: bold;
  width: 140rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.tag-SYSTEM {
  color: #6b5b4a;
}

.tag-ACTION {
  color: #d97706;
}

.tag-CHAT {
  color: #5b7a8c;
}

.tag-ERROR {
  color: #be123c;
}

.msg-SYSTEM {
  color: #8c7d68;
}

.msg-ACTION {
  color: #d97706;
}

.msg-CHAT {
  color: #5b7a8c;
}

.msg-ERROR {
  color: #fecdd3;
}

/* Quick Actions Styles */
.quick-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.quick-btn {
  flex: 1;
  min-width: 200rpx;
  font-size: 24rpx;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.05);
  border: 1rpx solid rgba(158, 42, 43, 0.2);
  border-radius: 30rpx;
  padding: 10rpx 0;
  text-align: center;
  font-weight: bold;
  line-height: 1.5;
  margin: 0;
}

.quick-btn::after {
  border: none;
}

.quick-btn:active {
  background: rgba(158, 42, 43, 0.15);
  border-color: #9e2a2b;
}

/* Bottom Terminal Console Redesign */
.placeholder-bottom {
  height: 120rpx;
}

.terminal-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fdfbf7;
  border-top: 1rpx solid rgba(158, 42, 43, 0.25);
  padding: 20rpx 24rpx;
  box-shadow: 0 -10rpx 30rpx -8rpx rgba(59, 48, 36, 0.2);
  z-index: 100;
  box-sizing: border-box;
}

.terminal-console {
  background: rgba(244, 241, 234, 0.95);
  border: 1rpx solid rgba(158, 42, 43, 0.4);
  border-radius: 16rpx;
  box-shadow: inset 0 0 20rpx rgba(158, 42, 43, 0.08);
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx;
}

.console-header {
  border-bottom: 1rpx solid rgba(107, 91, 74, 0.15);
  padding-bottom: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: row;
}

.console-dot {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.dot-red { color: #be123c; }
.dot-yellow { color: #d97706; }
.dot-green { color: #3b5e59; }

.console-title {
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.console-clear-btn {
  font-size: 24rpx;
  color: #6b5b4a;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 4rpx;
}

.console-clear-btn:active {
  background: rgba(190, 18, 60, 0.1);
  color: #be123c;
}

.console-body {
  align-items: flex-start;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: row;
}

.prompt-symbol {
  color: #9e2a2b;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.terminal-textarea {
  flex: 1;
  background: transparent;
  border: none;
  color: #1a1a1a;
  font-size: 24rpx;
  height: 140rpx;
  line-height: 1.5;
  padding: 0;
}

.terminal-placeholder {
  color: #6b5b4a;
  font-size: 24rpx;
}

.console-footer {
  border-top: 1rpx solid rgba(107, 91, 74, 0.15);
  padding-top: 10rpx;
  margin-top: 4rpx;
  display: flex;
  flex-direction: row;
}

.console-char-count {
  font-size: 24rpx;
  color: #6b5b4a;
}

.submit-btn-premium {
  background: linear-gradient(135deg, #9e2a2b, #5b7a8c);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 8rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border: none;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.submit-btn-premium::after {
  border: none;
}

.submit-btn-premium:active {
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  opacity: 0.9;
}

.btn-icon {
  font-size: 24rpx;
}

/* Tab Switcher Styles */
.tab-header {
  display: flex;
  flex-direction: row;
  border-bottom: 2rpx solid rgba(107, 91, 74, 0.15);
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  gap: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  padding: 16rpx 0;
  color: #6b5b4a;
  position: relative;
  transition: all 0.2s ease;
}

.tab-active {
  font-weight: 800;
}

.tab-active::after {
  content: "";
  position: absolute;
  bottom: -2rpx;
  left: 25%;
  right: 20%;
  height: 4rpx;
  border-radius: 2rpx;
}

.tab-active.text-cyan {
  color: #9e2a2b;
}

.tab-active.text-cyan::after {
  background-color: #9e2a2b;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.tab-active.text-emerald {
  color: #3b5e59;
}

.tab-active.text-emerald::after {
  background-color: #3b5e59;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

/* Chat Scroll Area */
.chat-panel-container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
  margin-bottom: 12rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  border: none;
  background-color: transparent;
  border-radius: 0;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
}

.chat-item {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.chat-item-human {
  align-items: flex-end;
}

.chat-item-agent {
  align-items: flex-start;
}

.chat-bubble-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.chat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(107, 91, 74, 0.08);
  color: #6b5b4a;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.chat-bubble-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-bubble-time {
  font-size: 24rpx;
  color: #8c7d68;
  flex-shrink: 0;
}

.chat-quote-preview {
  margin-bottom: 10rpx;
  padding: 10rpx 12rpx;
  background: rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #c0c0c0;
  border-radius: 8rpx;
}

.chat-quote-preview-text {
  display: block;
  max-width: 480rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #8c7d68;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.chat-bubble-body {
  max-width: 82%;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
  white-space: pre-wrap;
}

/* 气泡分层（UI 统一 v3·淡雅仙境）：
   主人=纸白+淡墨描边，Agent=青灰雾+墨线；朱砂只留名字/头像级点缀 */
.bubble-user {
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.14);
  color: #1a1a1a;
  border-top-right-radius: 2rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
}

.bubble-agent {
  background: rgba(91, 122, 140, 0.07);
  border: 1rpx solid rgba(91, 122, 140, 0.28);
  color: #1a1a1a;
  border-top-left-radius: 2rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
}

/* Nested Progress & Task styling inside chat bubble */
.bubble-task-container {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(59, 48, 36, 0.1);
  width: 100%;
}

/* ==================== 实时进度区（agent_progress 状态机） ==================== */
.ps-status-row {
  gap: 10rpx;
  margin-bottom: 10rpx;
}
.ps-status-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #4a6a7c;
  font-weight: bold;
}
.ps-elapsed {
  font-size: 20rpx;
  color: #9aa3a8;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* 分段进度条 */
.ps-bar {
  display: flex;
  gap: 6rpx;
  height: 10rpx;
  margin-bottom: 8rpx;
}
.ps-seg {
  height: 100%;
  border-radius: 999rpx;
  transition: background 0.3s ease;
}
.seg-done { background: #3b5e59; }
.seg-failed { background: #be123c; }
.seg-pending { background: rgba(91, 122, 140, 0.15); }
.seg-active {
  background: linear-gradient(90deg, rgba(59, 94, 89, 0.3) 25%, rgba(59, 94, 89, 0.95) 50%, rgba(59, 94, 89, 0.3) 75%);
  background-size: 200% 100%;
  animation: seg-flow 1.2s linear infinite;
}
@keyframes seg-flow {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 无步骤信息时的整条流动动画（理解指令阶段） */
.ps-bar-indeterminate {
  position: relative;
  background: rgba(91, 122, 140, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}
.ps-ind-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 40%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(59, 94, 89, 0.25), rgba(59, 94, 89, 0.85), rgba(59, 94, 89, 0.25));
  animation: ind-slide 1.6s ease-in-out infinite;
}
@keyframes ind-slide {
  0% { left: -40%; }
  100% { left: 100%; }
}

.ps-meta-row {
  gap: 12rpx;
}
.ps-pct {
  font-size: 20rpx;
  color: #9aa3a8;
}
.ps-stall {
  font-size: 20rpx;
  color: #d97706;
}
.ps-toggle {
  font-size: 20rpx;
  color: #5b7a8c;
  margin-left: auto;
  padding: 4rpx 8rpx;
}

.ps-steps {
  margin-top: 8rpx;
}
.ps-step {
  gap: 10rpx;
  padding: 6rpx 0;
}
.ps-step-mark {
  font-size: 22rpx;
  width: 28rpx;
  text-align: center;
  flex-shrink: 0;
}
.mark-done { color: #3b5e59; }
.mark-failed { color: #be123c; }
.mark-running { color: #9e2a2b; }
.mark-pending { color: #b9c4ca; }
.ps-step-desc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #2b2b2b;
}
.ps-step-time {
  font-size: 20rpx;
  color: #9aa3a8;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.ps-detail {
  font-size: 20rpx;
  color: #7a8a93;
  margin-top: 6rpx;
  word-break: break-all;
}

.bubble-progress-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.bubble-progress-lbl {
  font-size: 24rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.bubble-progress-pct {
  font-size: 24rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.live-status-line {
  margin-top: 10rpx;
  padding: 8rpx 12rpx;
  background: rgba(158, 42, 43, 0.05);
  border-radius: 10rpx;
  overflow: hidden;
}

.live-status-text {
  font-size: 24rpx;
  color: #9e2a2b;
  animation: liveStatusBlink 1.2s ease-in-out infinite;
}

@keyframes liveStatusBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.bubble-progress-track {
  height: 6rpx;
  background: rgba(91, 122, 140, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bubble-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b7a8c, #9e2a2b);
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.bubble-task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
  width: 100%;
}

.bubble-task-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  background: transparent;
  border: none;
  color: #8c7d68;
  padding: 10rpx 14rpx;
  background: rgba(253, 251, 247, 0.4);
  border-radius: 8rpx;
  border: 1rpx solid rgba(91, 122, 140, 0.15);
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

.bubble-task-item-header {
  width: 100%;
}

.bubble-task-title {
  font-weight: 500;
  color: #6b5b4a;
  font-size: 24rpx;
}

.bubble-task-done {
  text-decoration: line-through;
  color: #6b5b4a !important;
}

.bubble-task-status-badge {
  font-size: 24rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-weight: bold;
  line-height: 1;
}

.bubble-task-status-badge.status-SUCCESS {
  color: #3b5e59;
  background: rgba(59, 94, 89, 0.1);
  border: 1rpx solid rgba(59, 94, 89, 0.25);
}

.bubble-task-status-badge.status-PROCESSING {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.1);
