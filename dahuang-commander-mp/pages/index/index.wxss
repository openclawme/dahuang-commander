.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* Header Panel Styles */
.header-panel {
  margin-top: 10rpx;
}

.bubble-error {
  border: 1px solid rgba(190,18,60, 0.6) !important;
  background: rgba(190,18,60, 0.12) !important;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(190,18,60, 0.25) !important;
}

.avatar-ring {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 4rpx solid #9e2a2b;
  background-color: rgba(158,42,43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  margin-right: 20rpx;
}

.avatar-char {
  font-size: 40rpx;
}

.agent-meta {
  justify-content: center;
}

.agent-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.agent-did {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 4rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.online-pulse {
  background-color: rgba(22,101,52, 0.15);
  border: 1rpx solid #166534;
  color: #166534;
  animation: pulse-green 2s infinite alternate;
}

.offline-glow {
  background-color: rgba(190,18,60, 0.15);
  border: 1rpx solid #be123c;
  color: #be123c;
}

.status-dot {
  font-size: 26rpx;
  margin-right: 8rpx;
}

@keyframes pulse-green {
  0% {
    box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  }
  100% {
    box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  }
}

.stats-row {
  border-top: 1rpx solid rgba(107,91,74, 0.2);
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
}

/* 命名历史遗留：text-cyan 实为朱砂红，text-purple 实为青灰，仅保留类名兼容 */
.text-cyan {
  color: #9e2a2b;
}

.text-purple {
  color: #5b7a8c;
}

.text-emerald {
  color: #166534;
}

/* 历史遗留幽灵类：补上浅色纸主题下的语义色，避免白字白底事故 */
.text-white {
  color: #3b3024;
}
.text-yellow {
  color: #b8844f;
}
.text-slate {
  color: #6b5b4a;
}
.text-green {
  color: #166534;
}
.text-ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Progress Panel Styles */
.progress-panel {
  display: flex;
  flex-direction: column;
}

.panel-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: bold;
  color: #5b7a8c;
}

.command-bubble {
  background: rgba(91,122,140, 0.08);
  border-left: 6rpx solid #5b7a8c;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.bubble-prefix {
  font-size: 26rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.bubble-content {
  font-size: 26rpx;
  color: #3b3024;
}

.progress-track {
  height: 10rpx;
  background: rgba(107,91,74, 0.2);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b7a8c, #9e2a2b);
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  font-size: 26rpx;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 8rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
}

.task-icon {
  margin-top: 2rpx;
}

.task-detail {
  flex: 1;
  color: #a89982;
}

.task-done {
  text-decoration: line-through;
  color: #6b5b4a;
}

.empty-tasks {
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #6b5b4a;
}

/* Logs Panel Styles */
.logs-panel {
  display: flex;
  flex-direction: column;
}

.panel-subtitle {
  font-size: 26rpx;
  color: rgba(22,101,52, 0.5);
  letter-spacing: 2rpx;
}

.logs-panel-container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
  margin-bottom: 12rpx;
}

.logs-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  border: 1rpx solid rgba(22,101,52, 0.1);
  background-color: rgba(244,241,234, 0.8);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.log-line {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1.4;
  align-items: flex-start;
}

.log-time {
  color: #6b5b4a;
  width: 120rpx;
  flex-shrink: 0;
}

.log-tag {
  font-weight: bold;
  width: 140rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.tag-SYSTEM {
  color: #6b5b4a;
}

.tag-ACTION {
  color: #eab308;
}

.tag-CHAT {
  color: #d946ef;
}

.tag-ERROR {
  color: #be123c;
}

.msg-SYSTEM {
  color: #8c7d68;
}

.msg-ACTION {
  color: #fef08a;
}

.msg-CHAT {
  color: #fbcfe8;
}

.msg-ERROR {
  color: #fecdd3;
}

/* Quick Actions Styles */
.quick-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.quick-btn {
  flex: 1;
  min-width: 200rpx;
  font-size: 26rpx;
  color: #9e2a2b;
  background: rgba(158,42,43, 0.05);
  border: 1rpx solid rgba(158,42,43, 0.2);
  border-radius: 30rpx;
  padding: 10rpx 0;
  text-align: center;
  font-weight: bold;
  line-height: 1.5;
  margin: 0;
}

.quick-btn::after {
  border: none;
}

.quick-btn:active {
  background: rgba(158,42,43, 0.15);
  border-color: #9e2a2b;
}

/* Bottom Terminal Console Redesign */
.placeholder-bottom {
  height: 120rpx;
}

.terminal-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fdfbf7;
  border-top: 1rpx solid rgba(158,42,43, 0.25);
  padding: 20rpx 24rpx;
  box-shadow: 0 -10rpx 30rpx -8rpx rgba(59, 48, 36, 0.2);
  z-index: 100;
  box-sizing: border-box;
}

.terminal-console {
  background: rgba(244,241,234, 0.95);
  border: 1rpx solid rgba(158,42,43, 0.4);
  border-radius: 12rpx;
  box-shadow: inset 0 0 20rpx rgba(158,42,43, 0.08);
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx;
}

.console-header {
  border-bottom: 1rpx solid rgba(107,91,74, 0.15);
  padding-bottom: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: row;
}

.console-dot {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.dot-red { color: #be123c; }
.dot-yellow { color: #eab308; }
.dot-green { color: #166534; }

.console-title {
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.console-clear-btn {
  font-size: 26rpx;
  color: #6b5b4a;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 4rpx;
}

.console-clear-btn:active {
  background: rgba(190,18,60, 0.1);
  color: #be123c;
}

.console-body {
  align-items: flex-start;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: row;
}

.prompt-symbol {
  color: #9e2a2b;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.terminal-textarea {
  flex: 1;
  background: transparent;
  border: none;
  color: #1a1a1a;
  font-size: 26rpx;
  height: 140rpx;
  line-height: 1.5;
  padding: 0;
}

.terminal-placeholder {
  color: #6b5b4a;
  font-size: 26rpx;
}

.console-footer {
  border-top: 1rpx solid rgba(107,91,74, 0.15);
  padding-top: 10rpx;
  margin-top: 4rpx;
  display: flex;
  flex-direction: row;
}

.console-char-count {
  font-size: 26rpx;
  color: #6b5b4a;
}

.submit-btn-premium {
  background: linear-gradient(135deg, #9e2a2b, #5b7a8c);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 8rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border: none;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.submit-btn-premium::after {
  border: none;
}

.submit-btn-premium:active {
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  opacity: 0.9;
}

.btn-icon {
  font-size: 26rpx;
}

/* Tab Switcher Styles */
.tab-header {
  display: flex;
  flex-direction: row;
  border-bottom: 2rpx solid rgba(107,91,74, 0.15);
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  gap: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  padding: 16rpx 0;
  color: #6b5b4a;
  position: relative;
  transition: all 0.2s ease;
}

.tab-active {
  font-weight: 800;
}

.tab-active::after {
  content: "";
  position: absolute;
  bottom: -2rpx;
  left: 25%;
  right: 20%;
  height: 4rpx;
  border-radius: 2rpx;
}

.tab-active.text-cyan {
  color: #9e2a2b;
}

.tab-active.text-cyan::after {
  background-color: #9e2a2b;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

.tab-active.text-emerald {
  color: #166534;
}

.tab-active.text-emerald::after {
  background-color: #166534;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
}

/* Chat Scroll Area */
.chat-panel-container {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
  margin-bottom: 12rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  border: none;
  background-color: transparent;
  border-radius: 0;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
}

.chat-item {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.chat-item-human {
  align-items: flex-end;
}

.chat-item-agent {
  align-items: flex-start;
}

.chat-bubble-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.chat-avatar {
  font-size: 28rpx;
  flex-shrink: 0;
}

.chat-bubble-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #6b5b4a;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-bubble-time {
  font-size: 26rpx;
  color: #8c7d68;
  flex-shrink: 0;
}

.chat-quote-preview {
  margin-bottom: 10rpx;
  padding: 10rpx 12rpx;
  background: rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #c0c0c0;
  border-radius: 8rpx;
}

.chat-quote-preview-text {
  display: block;
  max-width: 480rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.chat-bubble-body {
  max-width: 85%;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-wrap: break-word;
  white-space: pre-wrap;
}

.bubble-user {
  background: rgba(158,42,43, 0.06);
  border: 1rpx solid rgba(158,42,43, 0.25);
  color: #3b3024;
  border-top-right-radius: 2rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
}

.bubble-agent {
  background: rgba(91,122,140, 0.06);
  border: 1rpx solid rgba(91,122,140, 0.25);
  color: #1a1a1a;
  border-top-left-radius: 2rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
}

/* Nested Progress & Task styling inside chat bubble */
.bubble-task-container {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(91,122,140, 0.2);
  width: 100%;
}

.bubble-progress-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.bubble-progress-lbl {
  font-size: 26rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.bubble-progress-pct {
  font-size: 26rpx;
  color: #5b7a8c;
  font-weight: bold;
}

.bubble-progress-track {
  height: 6rpx;
  background: rgba(91,122,140, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bubble-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b7a8c, #9e2a2b);
  box-shadow: 0 6rpx 16rpx -6rpx rgba(59, 48, 36, 0.2);
  transition: width 0.3s ease;
}

.bubble-task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
  width: 100%;
}

.bubble-task-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8c7d68;
  padding: 10rpx 14rpx;
  background: rgba(253,251,247, 0.4);
  border-radius: 8rpx;
  border: 1rpx solid rgba(91,122,140, 0.15);
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

.bubble-task-item-header {
  width: 100%;
}

.bubble-task-title {
  font-weight: 500;
  color: #3b3024;
  font-size: 26rpx;
}

.bubble-task-done {
  text-decoration: line-through;
  color: #6b5b4a !important;
}

.bubble-task-status-badge {
  font-size: 26rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-weight: bold;
  line-height: 1;
}

.bubble-task-status-badge.status-SUCCESS {
  color: #166534;
  background: rgba(22,101,52, 0.1);
  border: 1rpx solid rgba(22,101,52, 0.25);
}

.bubble-task-status-badge.status-PROCESSING {
  color: #9e2a2b;
  background: rgba(158,42,43, 0.1);
  border: 1rpx solid rgba(158,42,43, 0.35);
  animation: badge-pulse 1.2s infinite alternate;
}

.bubble-task-status-badge.status-PENDING {
  color: #6b5b4a;
  background: rgba(107,91,74, 0.08);
  border: 1rpx solid rgba(107,91,74, 0.15);
}

.bubble-task-status-badge.status-FAILED {
  color: #be123c;
  background: rgba(190,18,60, 0.1);
  border: 1rpx solid rgba(190,18,60, 0.25);
}

.bubble-step-progress-track {
  height: 6rpx;
  background: rgba(253,251,247, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 3rpx;
  overflow: hidden;
  margin: 6rpx 0;
  width: 100%;
}

.bubble-step-progress-fill {
  height: 100%;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  border-radius: 3rpx;
}

.bubble-step-progress-fill.fill-SUCCESS {
  background: linear-gradient(90deg, #166534, #3b5e59);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
}

.bubble-step-progress-fill.fill-PROCESSING {
  background: linear-gradient(90deg, #9e2a2b, #b35c44);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
  animation: progress-shimmer 2s infinite linear;
  background-size: 200% 100%;
}

.bubble-step-progress-fill.fill-FAILED {
  background: linear-gradient(90deg, #be123c, #be123c);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25);
}

.bubble-step-progress-fill.fill-PENDING {
  width: 0% !important;
}

.bubble-task-detail {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 4rpx;
  padding-left: 20rpx;
  line-height: 1.4;
  word-break: break-all;
}

@keyframes badge-pulse {
  0% { box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25); opacity: 0.8; }
  100% { box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25); opacity: 1; }
}

@keyframes progress-shimmer {
  0% { background-position: 0% 0%; }
  100% { background-position: -200% 0%; }
}

/* Compact sticky header panel (Support for multiple concurrent tasks) */
.compact-progress-indicator {
  background: rgba(91,122,140, 0.04);
  border: 1rpx solid rgba(91,122,140, 0.25);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  animation: glow-purple-pulse 1.5s infinite alternate;
}

@keyframes glow-purple-pulse {
  0% { box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25); }
  100% { box-shadow: 0 6rpx 18rpx -6rpx rgba(59, 48, 36, 0.25); }
}

.compact-progress-item {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.compact-progress-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.compact-progress-text {
  font-size: 26rpx;
  color: #a89982;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  margin-right: 12rpx;
}

.compact-progress-pct {
  font-size: 26rpx;
  color: #5b7a8c;
  font-weight: bold;
}

/* ==========================================================================
   法旨批复阁 (Approval Pending Modal / Command Gate) Redesign & Styling
   ========================================================================== */
.approval-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(244,241,234, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 40rpx;
  box-sizing: border-box;
}

.approval-modal {
  width: 100%;
  max-width: 650rpx;
  background: rgba(253,251,247, 0.95);
  border: 2rpx solid #eab308;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(234, 179, 8, 0.25), inset 0 0 30rpx rgba(234, 179, 8, 0.05);
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
  animation: modal-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes modal-enter {
  0% {
    transform: scale(0.9) translateY(40rpx);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.modal-header {
