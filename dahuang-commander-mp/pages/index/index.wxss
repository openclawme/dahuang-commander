}
.chat-item-system .chat-bubble-body {
  max-width: 92%;
  background: rgba(107, 91, 74, 0.06);
  border: 1rpx dashed rgba(107, 91, 74, 0.2);
  box-shadow: none;
  color: #6b5b4a;
  text-align: center;
}

/* 图片附件选择与预览 */
.wechat-add-btn {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wechat-add-icon {
  font-size: 38rpx;
  color: #3c3c3c;
  line-height: 1;
}
.wechat-add-btn:active { opacity: 0.6; }
.wechat-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 4rpx 12rpx;
}
.wechat-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.wechat-image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #ffffff;
}
.wechat-image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(60, 60, 60, 0.85);
