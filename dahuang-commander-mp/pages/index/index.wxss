/* Cyberpunk Pending Loader styles */
.pending-loader-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}

/* Claude "Imagining..." 同款放射星芒：暖珊瑚色 8 条不等长光芒，缓慢旋转 + 呼吸 */
.claude-starburst-breathe {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  animation: starburst-breathe 2.4s ease-in-out infinite;
}
@keyframes starburst-breathe {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.12); opacity: 1; }
}
.claude-starburst {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  animation: starburst-spin 6s linear infinite;
}
@keyframes starburst-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.claude-ray {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  margin-left: -2.5rpx;
  border-radius: 3rpx;
  background: linear-gradient(to top, rgba(217, 119, 87, 0.95), rgba(217, 119, 87, 0.2));
  transform-origin: 50% 100%;
}
/* 各光芒长度不等，更接近手绘星芒的有机感 */
.r0 { height: 17rpx; margin-top: -17rpx; transform: rotate(0deg); }
.r1 { height: 11rpx; margin-top: -11rpx; transform: rotate(45deg); }
.r2 { height: 14rpx; margin-top: -14rpx; transform: rotate(90deg); }
.r3 { height: 9rpx;  margin-top: -9rpx;  transform: rotate(135deg); }
.r4 { height: 16rpx; margin-top: -16rpx; transform: rotate(180deg); }
.r5 { height: 10rpx; margin-top: -10rpx; transform: rotate(225deg); }
.r6 { height: 13rpx; margin-top: -13rpx; transform: rotate(270deg); }
.r7 { height: 8rpx;  margin-top: -8rpx;  transform: rotate(315deg); }

/* 放射状脉冲等待图标（Claude 风格）：波纹从中心向外扩散 + 中心实心点。
   translate(-50%,-50%) 精确定位，保证中心点与波纹严格同心 */
.radar-pulse {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.radar-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #5b7a8c;
  transform: translate(-50%, -50%);
}
.radar-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 2rpx solid #5b7a8c;
  opacity: 0;
  animation: radar-expand 1.8s ease-out infinite;
}
.radar-ring:nth-child(2) { animation-delay: 0.6s; }
.radar-ring:nth-child(3) { animation-delay: 1.2s; }
@keyframes radar-expand {
  0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0.85; }
  100% { transform: translate(-50%, -50%) scale(2.2); opacity: 0; }
}

.cyber-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(91, 122, 140, 0.2);
  border-top: 3rpx solid #5b7a8c;
  border-right: 3rpx solid #9e2a2b;
  border-radius: 50%;
  animation: cyber-spin 1s linear infinite;
}

.pending-loader-text {
  font-size: 24rpx;
  color: #5b7a8c;
  font-weight: 500;
  animation: cyber-pulse 1.8s ease-in-out infinite;
}

@keyframes cyber-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes cyber-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1.0; }
}

/* ==========================================================================
   Dahuang Premium Telemetry, Sandbox and Orbit Aura Styling Extensions
   ========================================================================== */

/* Top Status Header with Orbit Aura and Particle drifts */
.agent-header {
  /* 青瓷晨雾渐变：纸白 → 淡青灰，仙境淡雅 */
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.85) 0%, rgba(232, 239, 237, 0.65) 100%);
