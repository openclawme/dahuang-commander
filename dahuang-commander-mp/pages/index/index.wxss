}
.bubble-chart-canvas {
  min-width: 100%;
  height: 440rpx;
  border-radius: 10rpx;
}


/* ===== 待主人决策横幅（与 quote-banner 同语言：朱砂细描边条） ===== */
.decision-banner {
  background: rgba(158, 42, 43, 0.06);
  border: none;
  border-left: 6rpx solid #9e2a2b;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  gap: 12rpx;
}
.decision-banner-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  font-family: "Noto Serif SC", "Songti SC", serif;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
