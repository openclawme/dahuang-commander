<view class="container">

  <view class="cyber-panel glow-cyan tab-pane-container chat-panel" style="{{keyboardHeight > 0 ? 'margin-bottom: ' + keyboardHeight + 'px;' : ''}}">
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{toChatView}}" scroll-with-animation>
      <view class="chat-item chat-item-{{item.sender}}" wx:for="{{chatHistory}}" wx:key="id" id="chat-{{item.id}}">
        <view class="chat-bubble-header flex-row">
          <text class="chat-avatar">{{item.sender === 'human' ? '👑' : '🧙‍♂️'}}</text>
          <text class="chat-bubble-name">{{item.sender === 'human' ? t.index.you : (agentState.name || t.index.agent)}}</text>
          <text class="chat-bubble-time">{{item.timestamp}}</text>
        </view>
        
        <view class="chat-bubble-body bubble-{{item.sender === 'human' ? 'user' : 'agent'}} {{item.isRich ? 'bubble-rich' : ''}} {{item.isError ? 'bubble-error' : ''}}">
          <view class="error-banner flex-row align-center" wx:if="{{item.isError}}" style="margin-bottom: 8rpx; color: #be123c; font-size: 26rpx; font-weight: bold;">
            <icon type="warn" size="12" color="#be123c" style="margin-right: 8rpx;"></icon>
            <text>⚠️ 天道推演中断 / 执行异常</text>
          </view>
          <block wx:if="{{item.isPending && (!item.tasks || item.tasks.length === 0) && (!item.content || item.content === '（元神入定推演中...）')}}">
            <view class="pending-loader-container flex-row align-center">
              <view class="cyber-spinner"></view>
              <text class="pending-loader-text">{{t.index.pending}}</text>
            </view>
          </block>
          <block wx:else>
            <rich-text wx:if="{{item.isRich}}" class="msg-body-rich" nodes="{{item.richContent}}" user-select></rich-text>
            <text wx:elif="{{item.content && item.content !== '（元神入定推演中...）'}}" user-select>{{item.content}}</text>
          </block>
          
          <view class="bubble-task-container" wx:if="{{item.sender === 'agent' && (item.isPending || (item.progress > 0 && item.progress < 100))}}">
            <view class="bubble-progress-row flex-row align-center justify-between">
              <text class="bubble-progress-lbl">{{t.index.progress}}</text>
              <view class="flex-row align-center" style="gap: 10rpx;">
                <text class="bubble-progress-pct">{{item.progress || 0}}%</text>
              </view>
            </view>
            <view class="bubble-progress-track">
              <view class="bubble-progress-fill" style="width: {{item.progress || 0}}%;"></view>
            </view>
            <view class="bubble-task-list" wx:if="{{item.tasks && item.tasks.length > 0}}">
              <view class="bubble-task-item flex-col" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id" style="{{task.status === 'PROCESSING' ? 'border-color: rgba(158,42,43, 0.25); background: rgba(158,42,43, 0.04);' : ''}}">
                <view class="bubble-task-item-header flex-row align-center justify-between">
                  <view class="flex-row align-center" style="flex: 1; min-width: 0;">
                    <icon type="{{task.status === 'SUCCESS' ? 'success' : (task.status === 'FAILED' ? 'warn' : 'waiting')}}" size="10" color="{{task.status === 'SUCCESS' ? '#166534' : (task.status === 'FAILED' ? '#be123c' : '#9e2a2b')}}" style="margin-right: 8rpx; flex-shrink: 0;"></icon>
                    <text class="bubble-task-title {{task.status === 'SUCCESS' ? 'bubble-task-done' : ''}} text-ellipsis">{{task.desc || task.title || t.index.step}}</text>
                  </view>
                  <text class="bubble-task-status-badge status-{{task.status}}">{{task.status}}</text>
                </view>

                <view class="bubble-step-progress-track">
                  <view class="bubble-step-progress-fill fill-{{task.status}}" style="width: {{task.status === 'SUCCESS' ? '100%' : (task.status === 'PROCESSING' ? '60%' : (task.status === 'FAILED' ? '100%' : '0%'))}};"></view>
                </view>

                <view class="bubble-task-detail" wx:if="{{task.detail}}">
                  <text>↳ {{task.detail}}</text>
                </view>
              </view>
            </view>

            <view class="fallback-action-box flex-row align-center justify-between" wx:if="{{item.autoFallbackTriggered}}" style="margin-top: 12rpx; padding: 10rpx 14rpx; background: rgba(217,119,6, 0.08); border: 1px solid rgba(217,119,6, 0.3); border-radius: 8rpx;">
              <text style="font-size: 26rpx; color: #d97706;">⚡ 看门狗已自动接力执行备选方案</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="empty-tasks flex-col align-center" wx:if="{{chatHistory.length === 0}}">
        <text class="empty-icon">🧘</text>
        <text class="empty-text">{{t.index.empty}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 5. Bottom fixed terminal input -->
  <view class="wechat-footer" style="transform: translateY(-{{keyboardHeight}}px); padding-bottom: {{keyboardHeight > 0 ? '16rpx' : 'calc(16rpx + env(safe-area-inset-bottom))'}}; transition: transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);">
    <view class="wechat-input-bar flex-row align-center">
      <view class="clear-icon-btn flex-row align-center justify-center" bindtap="clearInput" wx:if="{{inputValue}}">
        <text class="clear-icon">🧹</text>
      </view>
      <textarea 
        class="wechat-textarea" 
        placeholder="{{t.index.placeholder}}" 
        value="{{inputValue}}" 
        bindinput="onInputChange" 
        maxlength="1000"
        auto-height="{{true}}"
        show-confirm-bar="{{false}}"
        disable-default-padding
        adjust-position="{{false}}"
        cursor-spacing="20"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        bindkeyboardheightchange="onKeyboardHeightChange"
      />
      <view class="wechat-submit-btn {{inputValue ? 'active' : ''}}" bindtap="sendInstruction">{{t.index.send}}</view>
    </view>
  </view>

  <!-- Command Approval gate overlay modal -->
  <view class="approval-modal-overlay" wx:if="{{pendingApproval}}">
    <view class="approval-modal">
      <view class="modal-header flex-row align-center justify-between">
        <view class="flex-row align-center">
          <text class="modal-title-icon">📜</text>
          <text class="modal-title text-yellow">{{t.index.approval_title}}</text>
        </view>
        <view class="pending-badge">{{t.index.approval_pending}}</view>
      </view>

      <view class="modal-body">
        <view class="info-section">
          <view class="info-row">
            <text class="info-label">{{t.index.approval_tool}}</text>
            <text class="info-value text-cyan">{{pendingApproval.tool}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{t.index.approval_params}}</text>
            <view class="params-box">
              <text class="params-text">{{pendingApproval.parameters}}</text>
            </view>
          </view>
        </view>

        <view class="reason-section">
          <text class="reason-label">{{t.index.approval_reason}}</text>
          <scroll-view class="reason-scroll" scroll-y>
            <text class="reason-text">{{pendingApproval.reply}}</text>
          </scroll-view>
        </view>
      </view>

      <view class="modal-footer flex-row">
        <button class="modal-btn glow-red-btn" bindtap="resolveApproval" data-action="reject">
          <text class="btn-icon">❌</text> {{t.index.approval_reject}}
        </button>
        <button class="modal-btn glow-emerald-btn" bindtap="resolveApproval" data-action="approve">
          <text class="btn-icon">✅</text> {{t.index.approval_approve}}
        </button>
      </view>
    </view>
  </view>
</view>
