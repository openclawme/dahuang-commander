<view class="container" style="transform: translateY(-{{keyboardShift}}px);">

  <view class="cyber-panel glow-cyan tab-pane-container chat-panel">
    <!-- 待主人决策横幅 -->
    <view class="decision-banner flex-row align-center" wx:if="{{pendingCount > 0}}" bindtap="openDecisions">
      <text class="decision-banner-icon">决</text>
      <text class="decision-banner-text">{{t.index.decisions_banner.replace('{count}', pendingCount)}}</text>
      <text class="decision-banner-arrow">›</text>
    </view>
    <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{toChatView}}" scroll-with-animation bindscroll="onChatScroll">
      <view class="chat-item chat-item-{{item.sender}} {{item.sender === 'system' ? 'chat-item-system' : ''}}" wx:for="{{chatHistory}}" wx:key="id" id="chat-{{item.id}}" data-index="{{index}}" bindlongpress="onMessageLongPress">
        <view class="chat-bubble-header flex-row">
          <text class="chat-avatar">{{item.sender === 'human' ? '我' : item.sender === 'system' ? '系' : avatarChar}}</text>
          <text class="chat-bubble-name">{{item.sender === 'human' ? t.index.you : item.sender === 'system' ? t.index.system_label : (agentState.name || t.index.agent)}}</text>
          <text class="chat-bubble-time">{{item.timestamp}}</text>
        </view>
        
        <!-- 日程到点提醒：古风卡片（铃印 + 标题 + 正文 + 时刻） -->
        <view class="sched-remind-card" wx:if="{{item.sender === 'system' && item.sysKind === 'schedule'}}">
          <view class="sched-remind-badge">铃</view>
          <view class="sched-remind-body flex-col">
            <view class="flex-row align-center">
              <text class="sched-remind-title">日程到点</text>
              <text class="sched-remind-time" wx:if="{{item.sysTime}}">{{item.sysTime}}</text>
            </view>
            <text class="sched-remind-text">{{item.content}}</text>
          </view>
        </view>
        <view class="chat-bubble-body bubble-{{item.sender === 'human' ? 'user' : 'agent'}} {{item.isRich ? 'bubble-rich' : ''}} {{item.isError ? 'bubble-error' : ''}}" wx:else>
          <view class="chat-quote-preview" wx:if="{{item.sender === 'human' && item.quote}}">
            <text class="chat-quote-preview-text">{{item.quote}}</text>
          </view>
          <view class="error-banner flex-row align-center" wx:if="{{item.isError}}" style="margin-bottom: 8rpx; color: #be123c; font-size: 26rpx; font-weight: bold;">
            <icon type="warn" size="12" color="#be123c" style="margin-right: 8rpx;"></icon>
            <text>天道推演中断 / 执行异常</text>
          </view>
          <block wx:if="{{item.isPending && (!item.tasks || item.tasks.length === 0) && (!item.content || item.content === '（智能体处理中...）')}}">
            <view class="pending-loader-container flex-row align-center">
              <!-- Claude "Imagining..." 同款：暖珊瑚放射星芒（8 条不等长光芒 + 缓慢旋转 + 呼吸） -->
              <view class="claude-starburst-breathe">
                <view class="claude-starburst">
                  <view class="claude-ray r0"></view>
                  <view class="claude-ray r1"></view>
                  <view class="claude-ray r2"></view>
                  <view class="claude-ray r3"></view>
                  <view class="claude-ray r4"></view>
                  <view class="claude-ray r5"></view>
                  <view class="claude-ray r6"></view>
                  <view class="claude-ray r7"></view>
                </view>
              </view>
              <text class="pending-loader-text">{{t.index.pending}}</text>
            </view>
          </block>
          <block wx:else>
            <block wx:if="{{item.segments && item.segments.length > 0}}">
              <view class="msg-segments">
                <block wx:for="{{item.segments}}" wx:for-item="seg" wx:key="index">
                  <rich-text wx:if="{{seg.type === 'text'}}" class="msg-body-rich" nodes="{{seg.richContent}}" user-select></rich-text>
                  <view wx:elif="{{seg.type === 'miniapp'}}" class="msg-miniapp-btn" bindtap="tapOpenMiniapp" data-appid="{{seg.appId}}" data-path="{{seg.path}}">
                    <view class="msg-miniapp-badge">券</view>
                    <text class="msg-miniapp-label">打开小程序领券</text>
                  </view>
                  <text wx:elif="{{seg.type === 'link'}}" class="msg-link" bindtap="tapMsgLink" data-url="{{seg.url}}" user-select>{{seg.url}}</text>
                  <image wx:elif="{{seg.type === 'image'}}" class="msg-segment-image" src="{{seg.url}}" mode="widthFix" bindtap="previewAgentImage" data-src="{{seg.url}}" data-urls="{{item.images || item.agentImages}}"></image>
                  <view wx:elif="{{seg.type === 'chart'}}" class="bubble-chart-inline">
                    <!-- 点数多时按 _minWidthPx 加宽并横向滚动；少点数时 min-width:100% 拉满容器
                         （普通 view overflow 滚动，不用 scroll-view——flex 内会把 canvas 高度算成 0） -->
                    <view class="bubble-chart-inline-scroll">
                      <canvas
                        type="2d"
                        class="bubble-chart-canvas bubble-chart-canvas-inline"
                        id="{{seg.canvasId}}"
                        style="{{seg.chartSpec && seg.chartSpec._minWidthPx ? 'width: ' + seg.chartSpec._minWidthPx + 'px; min-width: 100%;' : 'width: 100%;'}}"
                        bindtouchstart="onChartTouchStart"
                        bindtouchmove="onChartTouchMove"
                        bindtouchend="onChartTouchEnd"
                        bindtouchcancel="onChartTouchEnd"
                        catchlongpress="onChartLongPress"
                        data-id="{{seg.canvasId}}"
                      ></canvas>
                    </view>
                  </view>
                  <view wx:elif="{{seg.type === 'table'}}" class="msg-segment-table">
                    <text class="msg-table-title" wx:if="{{seg.table.title}}">{{seg.table.title}}</text>
                    <scroll-view scroll-x class="msg-table-scroll" show-scrollbar="{{false}}">
                      <!-- grid 定列宽：表头与数据行用同一 grid-template-columns，列严格对齐 -->
                      <view class="msg-table">
                        <view class="msg-table-row msg-table-head" style="grid-template-columns: repeat({{seg.table.headers.length}}, minmax(180rpx, 1fr));">
                          <view class="msg-table-cell msg-table-th" wx:for="{{seg.table.headers}}" wx:for-item="h" wx:key="i">{{h.text}}</view>
                        </view>
                        <view class="msg-table-row" style="grid-template-columns: repeat({{seg.table.headers.length}}, minmax(180rpx, 1fr));" wx:for="{{seg.table.rows}}" wx:for-item="row" wx:key="ri">
                          <view class="msg-table-cell" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="i">{{cell.text}}</view>
                        </view>
                      </view>
                    </scroll-view>
                  </view>
                </block>
              </view>
            </block>
            <rich-text wx:elif="{{item.isRich}}" class="msg-body-rich" nodes="{{item.richContent}}" user-select></rich-text>
            <text wx:elif="{{item.content && item.content !== '（智能体处理中...）'}}" user-select>{{item.content}}</text>
          </block>

          <!-- Agent 回复图片（网络图已转存为平台图片） -->
          <view class="agent-image-grid" wx:if="{{item.sender === 'agent' && item.agentImages && item.agentImages.length > 0 && !(item.segments && item.segments.length > 0)}}">
            <image class="agent-image-thumb" wx:for="{{item.agentImages}}" wx:for-item="img" wx:key="*this"
                   src="{{img}}" mode="widthFix" bindtap="previewAgentImage" data-src="{{img}}" data-urls="{{item.agentImages}}"></image>
          </view>

          <!-- 主人发送的图片（历史记录 + 点击大图预览） -->
          <view class="human-image-grid" wx:if="{{item.sender === 'human' && item.images && item.images.length > 0 && !(item.segments && item.segments.length > 0)}}">
            <image class="human-image-thumb" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this"
                   src="{{serverUrl}}{{img}}" mode="aspectFill" bindtap="previewHumanImage" bindlongpress="onHumanImageLongPress" data-src="{{img}}"></image>
          </view>

          <!-- 原生 Canvas 图表（数据点多时画布加宽、横向滚动） -->
          <view class="bubble-chart-list" wx:if="{{item.unplacedCharts && item.unplacedCharts.length > 0}}">
            <scroll-view
              scroll-x
              class="bubble-chart-scroll"
              enhanced
              show-scrollbar="{{false}}"
              wx:for="{{item.unplacedCharts}}"
              wx:for-item="uc"
              wx:for-index="ci"
              wx:key="ci"
            >
              <canvas
                type="2d"
                class="bubble-chart-canvas"
                id="{{uc.canvasId}}"
                bindtouchstart="onChartTouchStart"
                bindtouchmove="onChartTouchMove"
                bindtouchend="onChartTouchEnd"
                bindtouchcancel="onChartTouchEnd"
                catchlongpress="onChartLongPress"
                data-id="{{uc.canvasId}}"
                style="width: {{uc.spec._minWidthPx ? uc.spec._minWidthPx + 'px' : ''}};"
              ></canvas>
            </scroll-view>
          </view>

          <!-- 商品购物卡片（搜索结果原生渲染：图片/券后价/销量 + 去购买） -->
          <view class="bubble-goods-list" wx:if="{{item.goods && item.goods.length > 0}}">
            <view class="goods-card flex-row"
                  wx:for="{{item.goods}}" wx:for-item="g" wx:key="id"
                  bindtap="onGoodsTap"
                  data-msg-id="{{item.id}}" data-goods-id="{{g.id}}" data-platform="{{g.platform}}">
              <image class="goods-card-img" src="{{g.image}}" mode="aspectFill"></image>
              <view class="goods-card-body flex-col">
                <text class="goods-card-title text-ellipsis-2">{{g.title}}</text>
                <view class="goods-card-price-row flex-row align-center">
                  <text class="goods-card-symbol">¥</text>
                  <text class="goods-card-price">{{g.priceText}}</text>
                  <text class="goods-card-origin" wx:if="{{g.couponYuan > 0}}">¥{{g.originText}}</text>
                  <text class="goods-card-coupon" wx:if="{{g.couponYuan > 0}}">券{{g.couponText}}元</text>
                </view>
                <view class="goods-card-meta flex-row align-center">
                  <text class="goods-tag" wx:for="{{g.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                  <text class="goods-card-platform platform-{{g.platform}}">{{g.platformText}}</text>
                  <text class="goods-card-sales" wx:if="{{g.salesTip}}">{{g.salesTip}}</text>
                  <text class="goods-card-shop text-ellipsis" wx:if="{{g.shopName}}">{{g.shopName}}</text>
                </view>
              </view>
              <view class="goods-card-buy" catchtap="onGoodsBuy"
                    data-goods-id="{{g.id}}" data-platform="{{g.platform}}">去购买</view>
            </view>
          </view>

          <!-- 步骤级失败但整体完成：轻量提示（非红色错误横幅） -->
          <view class="partial-fail-note" wx:if="{{item.hasFailedSteps}}">⚠️ 个别步骤未成功，已自动换方案完成</view>

          <!-- 回复后的下一步建议（点击即执行） -->
          <view class="suggestion-list" wx:if="{{item.sender === 'agent' && item.suggestions && item.suggestions.length > 0 && !item.isPending}}">
            <view class="suggestion-chip" wx:for="{{item.suggestions}}" wx:for-item="s" wx:key="id"
                  bindtap="tapSuggestion" data-command="{{s.command}}">
              <text class="suggestion-chip-text">{{s.label}}</text>
              <text class="suggestion-chip-arrow">›</text>
            </view>
          </view>
          <!-- 实时进度区：状态行 + 分段进度条 + 可展开步骤列表（agent_progress 事件流驱动） -->
          <view class="bubble-task-container" wx:if="{{item.sender === 'agent' && item.psDisplay}}">
            <view class="ps-status-row flex-row align-center">
              <!-- 放射状脉冲等待图标（Claude 风格：波纹从中心向外扩散） -->
              <view class="radar-pulse">
                <view class="radar-ring"></view>
                <view class="radar-ring"></view>
                <view class="radar-ring"></view>
                <view class="radar-core"></view>
              </view>
              <text class="ps-status-text text-ellipsis">{{item.psDisplay.statusLine}}</text>
              <text class="ps-elapsed">⏱ {{item.psDisplay.elapsedText}}</text>
            </view>

            <!-- 分段进度条：步骤数已知（plan 首帧到达后） -->
            <view class="ps-bar" wx:if="{{item.psDisplay.hasSteps}}">
              <view
                class="ps-seg {{seg.status === 'SUCCESS' ? 'seg-done' : (seg.status === 'FAILED' ? 'seg-failed' : (seg.active ? 'seg-active' : 'seg-pending'))}}"
                wx:for="{{item.psDisplay.segments}}" wx:for-item="seg" wx:key="id"
                style="width: {{100 / item.psDisplay.segments.length}}%;"
              ></view>
            </view>
            <!-- 无步骤信息时的整条流动动画（理解指令阶段） -->
            <view class="ps-bar ps-bar-indeterminate" wx:else>
              <view class="ps-ind-fill"></view>
            </view>

            <view class="ps-meta-row flex-row align-center">
              <text class="ps-pct">{{item.psDisplay.pct}}%</text>
              <text class="ps-stall" wx:if="{{item.psDisplay.stalled}}">仍在推进中…</text>
              <text class="ps-toggle" wx:if="{{item.psDisplay.hasSteps}}" bindtap="togglePsSteps" data-msg-id="{{item.id}}">{{item.psDisplay.expanded ? '收起步骤' : '展开 ' + item.psDisplay.steps.length + ' 个步骤'}}</text>
            </view>

            <view class="ps-steps" wx:if="{{item.psDisplay.expanded && item.psDisplay.hasSteps}}">
              <view class="ps-step flex-row align-center" wx:for="{{item.psDisplay.steps}}" wx:for-item="s" wx:key="id">
                <text class="ps-step-mark {{s.status === 'SUCCESS' ? 'mark-done' : (s.status === 'FAILED' ? 'mark-failed' : (s.active ? 'mark-running' : 'mark-pending'))}}">{{s.status === 'SUCCESS' ? '✓' : (s.status === 'FAILED' ? '✗' : (s.active ? '⟳' : '○'))}}</text>
                <text class="ps-step-desc text-ellipsis">{{s.desc}}</text>
                <text class="ps-step-time" wx:if="{{s.durationText}}">{{s.durationText}}</text>
              </view>
            </view>

            <view class="ps-detail" wx:if="{{item.psDisplay.lastDetail}}">↳ {{item.psDisplay.lastDetail}}</view>

            <view class="fallback-action-box flex-row align-center justify-between" wx:if="{{item.autoFallbackTriggered}}" style="margin-top: 12rpx; padding: 10rpx 14rpx; background: rgba(217,119,6, 0.08); border: 1px solid rgba(217,119,6, 0.3); border-radius: 8rpx;">
              <text style="font-size: 24rpx; color: #d97706;">看门狗已自动归档超时任务（后台结果产出后会自动回填）</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="empty-tasks flex-col align-center" wx:if="{{chatHistory.length === 0}}">
        <text class="empty-icon">言</text>
        <text class="empty-text">{{t.index.empty}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="message-menu-overlay" wx:if="{{messageMenu}}" bindtap="closeMessageMenu"></view>
  <view class="message-menu" wx:if="{{messageMenu}}" style="left: {{messageMenu.x}}px; top: {{messageMenu.y}}px;">
    <view class="message-menu-item" bindtap="quoteSelectedMessage">
      <text class="message-menu-icon">引</text>
      <text class="message-menu-text">引用</text>
    </view>
    <view class="message-menu-item" bindtap="copySelectedMessage">
      <text class="message-menu-icon">复</text>
      <text class="message-menu-text">复制</text>
    </view>
  </view>

  <!-- 5. Bottom fixed terminal input -->
  <view class="wechat-footer">
    <view class="quote-banner" wx:if="{{quotedMessage}}">
      <view class="quote-banner-left">
        <text class="quote-banner-label">引用消息</text>
        <text class="quote-banner-content">{{quotedMessage.content}}</text>
      </view>
      <view class="quote-banner-close" bindtap="clearQuote">✕</view>
    </view>
    <view class="wechat-image-list" wx:if="{{pendingImages && pendingImages.length > 0}}">
      <view class="wechat-image-item" wx:for="{{pendingImages}}" wx:key="path">
        <image src="{{item.path}}" mode="aspectFill" class="wechat-image-thumb"></image>
        <view class="wechat-image-status {{item.status}}">{{item.status === 'uploading' ? '上传中…' : '失败'}}</view>
      </view>
    </view>
    <view class="wechat-image-list" wx:if="{{images && images.length > 0}}">
      <view class="wechat-image-item" wx:for="{{images}}" wx:key="*this">
        <image src="{{serverUrl}}{{item}}" mode="aspectFill" class="wechat-image-thumb"></image>
        <view class="wechat-image-remove" catchtap="removeImage" data-index="{{index}}">×</view>
      </view>
    </view>
    <view class="image-quick-actions" wx:if="{{(pendingImages && pendingImages.length > 0) || (images && images.length > 0)}}">
      <scroll-view class="image-quick-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="image-quick-track flex-row">
          <view class="image-quick-chip" wx:for="{{imageQuickActions}}" wx:key="command" hover-class="image-quick-chip-hover" bindtap="onImageQuickAction" data-command="{{item.command}}">
            <text class="image-quick-chip-icon">{{item.icon}}</text>
            <text class="image-quick-chip-text">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="wechat-input-bar">
      <view class="wechat-field">
        <textarea
          class="wechat-textarea"
          placeholder-class="wechat-placeholder"
          placeholder="{{t.index.placeholder}}"
          value="{{inputValue}}"
          bindinput="onInputChange"
          maxlength="1000"
          auto-height="{{true}}"
          show-confirm-bar="{{false}}"
          disable-default-padding
          adjust-position="{{false}}"
          cursor-spacing="20"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindkeyboardheightchange="onKeyboardHeightChange"
        />
        <view class="wechat-add-btn" bindtap="chooseImages">
          <text class="wechat-add-icon">＋</text>
        </view>
      </view>
      <view class="wechat-submit-btn" bindtap="sendInstruction">{{t.index.send}}</view>
    </view>
  </view>

  <!-- 主人快捷面板：右下角浮钮 + 指令/任务面板（面板锚定 FAB 弹出） -->
  <view class="quick-fab {{keyboardShift > 0 ? 'quick-fab-hidden' : ''}} {{fabIdle ? 'quick-fab-idle' : ''}} {{fabJumping ? 'quick-fab-jump' : ''}} {{fabGliding ? 'quick-fab-glide' : ''}}" style="left: {{quickFabX}}px; top: {{quickFabY}}px;" catchtouchstart="onQuickFabStart" catchtouchmove="onQuickFabMove" bindtouchend="onQuickFabEnd">
    <view class="quick-fab-halo"></view>
    <view class="quick-fab-ring"></view>
    <view class="quick-fab-glass">
      <view class="quick-fab-sheen"></view>
      <!-- 灵气雾气：两层柔和光晕缓慢漂移/旋转/呼吸，星芒转动时雾气流转变幻 -->
      <view class="quick-fab-mist">
        <view class="quick-fab-mist-a"></view>
        <view class="quick-fab-mist-b"></view>
      </view>
      <view class="quick-fab-star">
        <view class="claude-starburst-breathe">
          <view class="claude-starburst">
            <view class="claude-ray r0"></view>
            <view class="claude-ray r1"></view>
            <view class="claude-ray r2"></view>
            <view class="claude-ray r3"></view>
            <view class="claude-ray r4"></view>
            <view class="claude-ray r5"></view>
            <view class="claude-ray r6"></view>
            <view class="claude-ray r7"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-panel-mask" wx:if="{{showQuickPanel}}" bindtap="closeQuickPanel"></view>
  <view class="quick-panel" wx:if="{{showQuickPanel}}" style="left: {{quickPanelPos.left}}px; top: {{quickPanelPos.top}}px;">
    <view class="quick-panel-close" catchtap="closeQuickPanel">✕</view>
    <view class="quick-panel-header flex-row align-center justify-between" catchtouchstart="onPanelHeadStart" catchtouchmove="onPanelHeadMove" bindtouchend="onPanelHeadEnd">
      <view class="quick-panel-head-left flex-row align-center">
        <view class="quick-panel-mark">笺</view>
        <view class="quick-panel-title-box flex-col">
          <text class="quick-panel-title">灵犀笺</text>
          <text class="quick-panel-subtitle">常用与推荐 · 按住可拖动</text>
        </view>
      </view>
    </view>

    <scroll-view class="quick-panel-scroll" scroll-y>
      <view class="quick-panel-loading" wx:if="{{quickPanelLoading}}">
        <view class="quick-loading-star">
          <view class="claude-starburst-breathe">
            <view class="claude-starburst">
              <view class="claude-ray r0"></view>
              <view class="claude-ray r1"></view>
              <view class="claude-ray r2"></view>
              <view class="claude-ray r3"></view>
              <view class="claude-ray r4"></view>
              <view class="claude-ray r5"></view>
              <view class="claude-ray r6"></view>
              <view class="claude-ray r7"></view>
            </view>
          </view>
        </view>
        <text class="quick-loading-text">灵犀推演中…</text>
      </view>

      <!-- 四大入口砖：2×2 大按钮 -->
      <view class="quick-entry-grid" wx:if="{{!quickPanelLoading}}">
        <view class="quick-entry-tile" hover-class="hover-dim" bindtap="openMarket">
          <view class="quick-entry-badge">惠</view>
          <view class="flex-col" style="min-width: 0;">
            <text class="quick-entry-label">天天优惠</text>
            <text class="quick-entry-sub">优惠券 · 比价</text>
          </view>
        </view>
        <view class="quick-entry-tile" hover-class="hover-dim" bindtap="openScheduleFromPanel">
          <view class="quick-entry-badge">程</view>
          <view class="flex-col" style="min-width: 0;">
            <text class="quick-entry-label">我的日程</text>
            <text class="quick-entry-sub">提醒 · 安排</text>
          </view>
        </view>
        <view class="quick-entry-tile" hover-class="hover-dim" bindtap="openTasksFromPanel">
          <view class="quick-entry-badge">务</view>
          <view class="flex-col" style="min-width: 0;">
            <text class="quick-entry-label">任务中心</text>
            <text class="quick-entry-sub">进度 · 结果</text>
          </view>
        </view>
        <view class="quick-entry-tile" hover-class="hover-dim" bindtap="openNotifications">
          <view class="quick-entry-badge">讯</view>
          <view class="flex-col" style="min-width: 0;">
            <text class="quick-entry-label">消息通知</text>
            <text class="quick-entry-sub">提醒 · 待办</text>
          </view>
        </view>
      </view>

      <view class="quick-section" wx:if="{{!quickPanelLoading}}">
        <view class="quick-section-head flex-row align-center justify-between">
          <view class="flex-row align-center">
            <view class="quick-section-dot task-dot"></view>
            <text class="quick-section-title">进行中</text>
          </view>
        </view>
        <view class="quick-task-item" wx:for="{{quickTasks}}" wx:key="id" hover-class="quick-task-item-hover" bindtap="tapQuickTask" data-id="{{item.id}}">
          <view class="quick-task-status"></view>
          <view class="quick-task-main flex-col">
            <text class="quick-task-title">{{item.title}}</text>
            <view class="quick-task-bar"><view class="quick-task-bar-fill" style="width: {{item.progress}}%;"></view></view>
          </view>
          <text class="quick-task-progress">{{item.progress}}%</text>
        </view>
        <text wx:if="{{quickTasks.length === 0}}" class="quick-empty">暂无运行中任务</text>
      </view>

      <view class="quick-section" wx:if="{{!quickPanelLoading}}">
        <view class="quick-section-head flex-row align-center justify-between">
          <view class="flex-row align-center">
            <view class="quick-section-dot command-dot"></view>
            <text class="quick-section-title">常用指令</text>
          </view>
          <view class="quick-refresh" hover-class="quick-refresh-hover" bindtap="refreshQuickCommands">↻ 换一批</view>
        </view>
        <view class="quick-chip" wx:for="{{quickCommands}}" wx:key="id" hover-class="quick-chip-hover" bindtap="tapQuickCommand" data-command="{{item.command}}">
          <view class="quick-chip-index">{{index + 1}}</view>
          <view class="quick-chip-body flex-col">
            <text class="quick-chip-text">{{item.label}}</text>
            <text class="quick-chip-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
          </view>
          <text class="quick-chip-arrow">›</text>
        </view>
        <text wx:if="{{!quickPanelLoading && quickCommands.length === 0}}" class="quick-empty">暂无常用指令</text>
      </view>

      <view class="quick-section" wx:if="{{!quickPanelLoading}}">
        <view class="quick-section-head flex-row align-center justify-between">
          <view class="flex-row align-center">
            <view class="quick-section-dot rec-dot"></view>
            <text class="quick-section-title">今日推荐</text>
          </view>
          <view class="quick-refresh" hover-class="quick-refresh-hover" bindtap="refreshQuickRecommendations">↻ 换一批</view>
        </view>
        <view class="quick-chip" wx:for="{{quickRecommendations}}" wx:key="command" hover-class="quick-chip-hover" bindtap="tapQuickCommand" data-command="{{item.command}}">
          <view class="quick-chip-index">{{index + 1}}</view>
          <view class="quick-chip-body flex-col">
            <text class="quick-chip-text">{{item.label}}</text>
            <text class="quick-chip-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
          </view>
          <text class="quick-chip-arrow">›</text>
        </view>
        <text wx:if="{{!quickPanelLoading && quickRecommendations.length === 0}}" class="quick-empty">暂无推荐任务</text>
      </view>
    </scroll-view>
  </view>

  <!-- Command Approval gate overlay modal -->
  <view class="approval-modal-overlay" wx:if="{{pendingApproval}}">
    <view class="approval-modal">
      <view class="modal-header flex-row align-center justify-between">
        <view class="flex-row align-center">
          <text class="modal-title-icon">📜</text>
          <text class="modal-title text-yellow">{{t.index.approval_title}}</text>
        </view>
        <view class="pending-badge">{{t.index.approval_pending}}</view>
      </view>

      <view class="modal-body">
        <view class="info-section">
          <view class="info-row">
            <text class="info-label">{{t.index.approval_tool}}</text>
            <text class="info-value text-cyan">{{pendingApproval.tool}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{t.index.approval_params}}</text>
            <view class="params-box">
              <text class="params-text">{{pendingApproval.parameters}}</text>
            </view>
          </view>
        </view>

        <view class="reason-section">
          <text class="reason-label">{{t.index.approval_reason}}</text>
          <scroll-view class="reason-scroll" scroll-y>
            <text class="reason-text">{{pendingApproval.reply}}</text>
          </scroll-view>
        </view>
      </view>

      <view class="modal-footer flex-row">
        <button class="modal-btn glow-red-btn" bindtap="resolveApproval" data-action="reject">
          {{t.index.approval_reject}}
        </button>
        <button class="modal-btn glow-emerald-btn" bindtap="resolveApproval" data-action="approve">
          {{t.index.approval_approve}}
        </button>
      </view>
    </view>
  </view>
</view>
