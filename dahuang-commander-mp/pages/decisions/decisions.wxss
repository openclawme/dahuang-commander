@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #8c7d68;
  font-size: 26rpx;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.maint-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(158, 42, 43, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}

.maint-type {
  font-size: 26rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.fact-time {
  font-size: 22rpx;
  color: #8c7d68;
}

.fact-content {
  font-size: 26rpx;
  color: #3b3024;
  line-height: 1.5;
  word-break: break-all;
}

.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #3b3024;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
  margin: 0;
}

.maint-btn-primary {
  background: #9e2a2b;
  color: #ffffff;
  border-color: #9e2a2b;
}

.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: #8c7d68;
}

.maint-btn::after {
  border: none;
}

.empty-agents {
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c7d68;
  text-align: center;
}

.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: #f4f1ea;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 24rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #3b3024;
  box-sizing: border-box;
}

.form-ph {
  color: #8c7d68;
}

.cost-note {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-top: 12rpx;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: #ffffff;
  color: #6b5b4a;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
}

.form-save-btn {
  background: #9e2a2b;
  color: #ffffff;
}

.form-cancel-btn::after,
.form-save-btn::after {
  border: none;
}
