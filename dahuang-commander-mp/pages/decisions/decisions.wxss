@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.maint-card {
  background: var(--card);
  border: 1rpx solid var(--brand-mid);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}

.maint-type {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--brand);
}

.fact-time {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.fact-content {
  font-size: 26rpx;
  color: var(--ink-strong);
  line-height: 1.5;
  word-break: break-all;
}

.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: var(--surface);
  color: var(--ink-strong);
  border: 1rpx solid var(--line-stronger);
  margin: 0;
}

.maint-btn-primary {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}

.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: var(--ink-soft);
}

.maint-btn::after {
  border: none;
}

.empty-agents {
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

.form-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.form-card {
  width: 100%;
  background: var(--paper);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--ink);
  display: block;
  margin-bottom: 24rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--ink-strong);
  box-sizing: border-box;
}

.form-ph {
  color: var(--ink-faint);
}

.cost-note {
  display: block;
  font-size: 22rpx;
  color: var(--warn);
  margin-top: 12rpx;
}

.form-cancel-btn,
.form-save-btn {
  width: 46%;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 2.6;
}

.form-cancel-btn {
  background: var(--surface);
  color: var(--ink-mid);
  border: 1rpx solid var(--line-stronger);
}

.form-save-btn {
  background: var(--brand);
  color: #ffffff;
}

.form-cancel-btn::after,
.form-save-btn::after {
  border: none;
}
