@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #8c7d68;
  font-size: 26rpx;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.maint-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(158, 42, 43, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}

.contact-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #6b1f20);
  flex-shrink: 0;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

.row-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3b3024;
}

.row-sub {
  font-size: 22rpx;
  color: #8c7d68;
  margin-top: 4rpx;
}

.fact-time {
  font-size: 22rpx;
  color: #8c7d68;
}

.fact-content {
  font-size: 26rpx;
  color: #3b3024;
  line-height: 1.5;
  word-break: break-all;
}

.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #3b3024;
  border: 1rpx solid rgba(59, 48, 36, 0.2);
  margin: 0;
}

.maint-btn-primary {
  background: #9e2a2b;
  color: #ffffff;
  border-color: #9e2a2b;
}

.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: #8c7d68;
}

.maint-btn::after {
  border: none;
}

.empty-agents {
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c7d68;
  text-align: center;
}
