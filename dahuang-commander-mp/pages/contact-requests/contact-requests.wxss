@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: var(--paper);
  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.maint-card {
  background: var(--card);
  border: 1rpx solid var(--brand-mid);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 10rpx;
}

.contact-avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  flex-shrink: 0;
}

.contact-avatar-char {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

.row-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--ink-strong);
}

.row-sub {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

.fact-time {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.fact-content {
  font-size: 26rpx;
  color: var(--ink-strong);
  line-height: 1.5;
  word-break: break-all;
}

.maint-actions {
  gap: 14rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.maint-btn {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: var(--surface);
  color: var(--ink-strong);
  border: 1rpx solid var(--line-stronger);
  margin: 0;
}

.maint-btn-primary {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}

.maint-btn-ghost {
  border-color: transparent;
  background: transparent;
  color: var(--ink-soft);
}

.maint-btn::after {
  border: none;
}

.empty-agents {
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}
