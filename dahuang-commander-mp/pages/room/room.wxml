<view class="container" style="height: calc(100vh - {{keyboardHeight}}px);">
  <!-- 消息滚动视窗 -->
  <scroll-view class="msg-scroll" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <view class="msg-list">
      <view class="msg-item flex-row {{item.isMe ? 'msg-me' : 'msg-other'}}" wx:for="{{messages}}" wx:key="event_id" id="msg-{{item.event_id}}">
        <!-- 头像 -->
        <view class="msg-avatar" wx:if="{{!item.isMe}}">
          <text class="avatar-char">🤖</text>
        </view>
        <view class="msg-avatar" wx:if="{{item.isMe}}">
          <text class="avatar-char">🧑‍💻</text>
        </view>

        <!-- 消息主体 -->
        <view class="msg-content-wrapper flex-col {{item.isRich ? 'msg-content-rich' : ''}}">
          <!-- 发送者姓名 -->
          <text class="sender-name">{{item.senderName}}</text>
          
          <!-- 气泡 -->
          <view class="msg-bubble {{item.isMe ? 'bubble-me-glow' : 'bubble-other-glow'}} {{item.isRich ? 'bubble-rich' : ''}}" style="max-width: {{item.isRich ? '95%' : '90%'}};">
            <rich-text class="msg-body-rich" nodes="{{item.richContent || item.body}}" user-select></rich-text>
            <video wx:if="{{item.videoUrl}}" class="msg-rich-video" src="{{item.videoUrl}}" poster="{{item.videoPoster}}" controls style="width: 100%; border-radius: 8rpx; margin-top: 12rpx; border: 1rpx solid rgba(6,182,212,0.3); max-height: 360rpx;"></video>
          </view>
          
          <!-- 发送时间 -->
          <text class="msg-time">{{item.timeStr}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部对话输入框 -->
  <view class="chat-footer" style="padding-bottom: {{keyboardHeight > 0 ? '24rpx' : 'calc(24rpx + env(safe-area-inset-bottom))'}};">
    <view class="input-container flex-row align-center">
      <input 
        class="chat-input" 
        placeholder="{{t.room.placeholder}}" 
        placeholder-class="chat-placeholder" 
        value="{{inputValue}}" 
        bindinput="onInputChange" 
        confirm-type="send" 
        bindconfirm="sendMessage"
        adjust-position="{{false}}"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        bindkeyboardheightchange="onKeyboardHeightChange"
      />
      <button class="send-btn" bindtap="sendMessage">{{t.room.send}}</button>
    </view>
  </view>
</view>
