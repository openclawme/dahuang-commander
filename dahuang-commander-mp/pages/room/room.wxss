.container {
  height: 100%;
  width: 100%;
  background-color: #f4f1ea;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: transform 0.12s cubic-bezier(0.25, 1, 0.5, 1);
}

.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 40rpx;
}

.msg-item {
  width: 100%;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-other {
  flex-direction: row;
}

.msg-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: rgba(158, 42, 43, 0.1);
  border: 2rpx solid #9e2a2b;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.3);
}

.msg-me .msg-avatar {
  background-color: rgba(158, 42, 43, 0.1);
  border: 2rpx solid #9e2a2b;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.3);
}

.avatar-char {
  font-size: 32rpx;
}

.msg-content-wrapper {
  max-width: 82%;
}

.msg-me .msg-content-wrapper {
  align-items: flex-end;
}

.msg-other .msg-content-wrapper {
  align-items: flex-start;
}

.sender-name {
  font-size: 24rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
  font-weight: bold;
}

.msg-bubble {
  padding: 12rpx 16rpx;
  line-height: 1.5;
  font-size: 28rpx;
  word-break: break-all;
  word-wrap: break-word;
  text-align: left;
}

/* 气泡分层（UI 统一 v3·淡雅仙境）：我=纸白+淡墨描边，对方=青灰雾+墨线 */
.bubble-me-glow {
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.14);
  color: #1a1a1a;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  border-radius: 16rpx 0 16rpx 16rpx;
}

.bubble-other-glow {
  background: rgba(91, 122, 140, 0.07);
  border: 1rpx solid rgba(91, 122, 140, 0.28);
  color: #1a1a1a;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  border-radius: 0 16rpx 16rpx 16rpx;
}

.msg-body {
  font-size: 24rpx;
}

/* 图片消息九宫格 */
.msg-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.msg-image-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
}

.msg-time {
  font-size: 24rpx;
  color: #8c7d68;
  margin-top: 6rpx;
}

/* Chat Footer Input Styles */
.placeholder-bottom {
  height: 160rpx;
  flex-shrink: 0;
}

.chat-footer {
  position: relative;
  background-color: #f4f1ea;
  border-top: 1rpx solid rgba(59, 48, 36, 0.12);
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 30rpx -8rpx rgba(59, 48, 36, 0.2);
  z-index: 100;
  flex-shrink: 0;
}

.chat-footer .input-container {
  background: #fdfbf7;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 38rpx;
  padding: 8rpx 16rpx 8rpx 24rpx;
  flex: 1;
}

.chat-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #1a1a1a;
  font-size: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

.chat-placeholder {
  color: #8c7d68;
  font-size: 24rpx;
}

.send-btn {
  background: linear-gradient(135deg, #9e2a2b, #a93230);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 38rpx;
  padding: 0 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 0 0 16rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.35);
}

.send-btn::after {
  border: none;
}

.send-btn:active {
  opacity: 0.8;
}

/* Rich content layout overrides */
.msg-content-rich {
  flex: 1;
  max-width: 95% !important;
  width: auto !important;
  min-width: 0;
}

.bubble-rich {
  width: 100% !important;
  box-sizing: border-box !important;
  padding: 16rpx 20rpx !important;
  background-color: rgba(253, 251, 247, 0.9) !important; /* Slightly darker slate backplate */
  border: 1rpx solid rgba(158, 42, 43, 0.45) !important;
  box-shadow: 0 4rpx 20rpx rgba(158, 42, 43, 0.15) !important;
  border-radius: 16rpx !important;
}

/* ===== 人类解锁接管 ===== */
.unlock-btn,
.lock-btn {
  flex-shrink: 0;
  margin: 0 0 0 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 2.4;
  padding: 0 24rpx;
  border-radius: 999rpx;
}
.unlock-btn {
  background: linear-gradient(135deg, #9e2a2b, #a93230);
  color: #ffffff;
}
.lock-btn {
  background: rgba(158, 42, 43, 0.08);
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}
.unlock-btn::after,
.lock-btn::after {
  border: none;
}
.locked-hint {
  flex: 1;
  font-size: 24rpx;
  color: #8c7d68;
  padding: 0 8rpx;
}

/* ===== 接管横幅（交还分身入口） ===== */
.takeover-banner {
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.35);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.takeover-banner-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}

/* ===== 群生命周期 ===== */
.dissolved-banner {
  background: rgba(59, 48, 36, 0.12);
  border: 1rpx dashed rgba(59, 48, 36, 0.4);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.dissolved-banner-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
}
.group-admin-row {
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.group-admin-label {
  font-size: 20rpx;
  color: #8c7d68;
}
.group-admin-btn {
  font-size: 20rpx;
  font-weight: bold;
  color: #b45309;
  background: rgba(180, 83, 9, 0.08);
  border: 1rpx solid rgba(180, 83, 9, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}
.group-admin-btn-plain {
  color: #8c7d68;
  background: rgba(59, 48, 36, 0.05);
  border-color: rgba(59, 48, 36, 0.25);
}


/* 群聊/私聊图文混排：文字段和图片段按消息顺序渲染 */
.msg-segments {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.msg-segment-image {
  width: 100%;
  max-width: 520rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  background: rgba(255, 255, 255, 0.6);
}

.msg-miniapp-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(201, 163, 76, 0.10);
  border: 1rpx solid rgba(168, 132, 47, 0.35);
  max-width: 420rpx;
  box-sizing: border-box;
}
.msg-miniapp-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: rgba(176, 84, 63, 0.85);
  color: #fdf8ec;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-miniapp-label {
  color: #8a6d1f;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.msg-miniapp-btn:active {
  background: rgba(201, 163, 76, 0.2);
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.msg-link {
  display: block;
  color: #4a7f99;
  text-decoration: underline;
  word-break: break-all;
  font-size: 26rpx;
  line-height: 1.6;
  margin: 4rpx 0;
}


/* ===== 群聊/私聊图片附件（与主对话同方案） ===== */
.room-add-btn {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(59, 48, 36, 0.06);
  border: 1rpx solid rgba(59, 48, 36, 0.14);
}
.room-add-btn:active { opacity: 0.6; }
.room-add-icon {
  font-size: 40rpx;
  color: #6b5b4a;
  line-height: 1;
}
.room-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 4rpx 16rpx;
}
.room-image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}
.room-image-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.12);
}
.room-image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(158, 42, 43, 0.9);
  color: #fff;
  font-size: 22rpx;
  z-index: 5;
}
.room-image-status {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  border-radius: 10rpx;
}
.room-image-status.error { color: #f6d6d6; background: rgba(158, 42, 43, 0.55); }


/* 聊天图文混排：原生表格（浅色主题，可横向滚动，不再出现深色黑框） */
.msg-segment-table {
  width: 100%;
  margin: 8rpx 0;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}
.msg-table-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
  padding: 16rpx 18rpx 8rpx;
}
.msg-table-scroll { width: 100%; }
.msg-table { display: inline-block; min-width: 100%; }
.msg-table-row { display: flex; flex-direction: row; flex-wrap: nowrap; }
.msg-table-head { background: rgba(158, 42, 43, 0.06); }
.msg-table-cell {
  min-width: 200rpx;
  max-width: 420rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  border-right: 1rpx solid rgba(59, 48, 36, 0.06);
  word-break: break-all;
}
.msg-table-th {
  font-weight: bold;
  color: #9e2a2b;
  border-bottom: 1rpx solid rgba(158, 42, 43, 0.25);
}



/* 群聊/私聊里的图表（与主对话同款：普通容器 + 固定高度，避免画布高度为 0） */
.bubble-chart-list { display: block; margin-top: 12rpx; }
.bubble-chart-inline {
  display: block;
  width: 100%;
  margin: 10rpx 0;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  padding: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.bubble-chart-canvas-inline {
  display: block;
  width: 100%;
  height: 400rpx;
}
