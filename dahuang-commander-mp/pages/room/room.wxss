.container {
  height: 100%;
  width: 100%;
  background-color: #f4f1ea;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 40rpx;
}

.msg-item {
  width: 100%;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-other {
  flex-direction: row;
}

.msg-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background-color: rgba(158,42,43, 0.1);
  border: 2rpx solid #9e2a2b;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.3);
}

.msg-me .msg-avatar {
  background-color: rgba(158,42,43, 0.1);
  border: 2rpx solid #9e2a2b;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.3);
}

.avatar-char {
  font-size: 32rpx;
}

.msg-content-wrapper {
  max-width: 82%;
}

.msg-me .msg-content-wrapper {
  align-items: flex-end;
}

.msg-other .msg-content-wrapper {
  align-items: flex-start;
}

.sender-name {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
  font-weight: bold;
}

.msg-bubble {
  padding: 12rpx 16rpx;
  line-height: 1.5;
  font-size: 28rpx;
  word-break: break-all;
  word-wrap: break-word;
  text-align: left;
}

.bubble-me-glow {
  background-color: rgba(158,42,43, 0.12);
  border: 1rpx solid rgba(158,42,43, 0.4);
  color: #1a1a1a;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.1);
  border-radius: 16rpx 0 16rpx 16rpx;
}

.bubble-other-glow {
  background-color: rgba(91,122,140, 0.15);
  border: 1rpx solid rgba(91,122,140, 0.4);
  color: #3b3024;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(91,122,140, 0.1);
  border-radius: 0 16rpx 16rpx 16rpx;
}

.msg-body {
  font-size: 26rpx;
}

.msg-time {
  font-size: 26rpx;
  color: #8c7d68;
  margin-top: 6rpx;
}

/* Chat Footer Input Styles */
.placeholder-bottom {
  height: 160rpx;
  flex-shrink: 0;
}

.chat-footer {
  position: relative;
  background-color: #f4f1ea;
  border-top: 1rpx solid rgba(158,42,43, 0.2);
  padding: 16rpx 20rpx;
  box-shadow: 0 -10rpx 30rpx -8rpx rgba(59, 48, 36, 0.2);
  z-index: 100;
}

.chat-footer .input-container {
  background: #fdfbf7;
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 38rpx;
  padding: 8rpx 16rpx 8rpx 24rpx;
  flex: 1;
}

.chat-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #1a1a1a;
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
}

.chat-placeholder {
  color: #8c7d68;
  font-size: 26rpx;
}

.send-btn {
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 38rpx;
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0 0 0 16rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158, 42, 43, 0.35);
}

.send-btn::after {
  border: none;
}

.send-btn:active {
  opacity: 0.8;
}

/* Rich content layout overrides */
.msg-content-rich {
  flex: 1;
  max-width: 95% !important;
  width: auto !important;
  min-width: 0;
}

.bubble-rich {
  width: 100% !important;
  box-sizing: border-box !important;
  padding: 16rpx 20rpx !important;
  background-color: rgba(253,251,247, 0.9) !important; /* Slightly darker slate backplate */
  border: 1rpx solid rgba(158,42,43, 0.45) !important;
  box-shadow: 0 4rpx 20rpx rgba(158,42,43, 0.15) !important;
  border-radius: 12rpx !important;
}

/* ===== 人类解锁接管 ===== */
.unlock-btn,
.lock-btn {
  flex-shrink: 0;
  margin: 0 0 0 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 2.4;
  padding: 0 24rpx;
  border-radius: 999rpx;
}
.unlock-btn {
  background: #9e2a2b;
  color: #ffffff;
}
.lock-btn {
  background: rgba(158, 42, 43, 0.08);
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}
.unlock-btn::after,
.lock-btn::after {
  border: none;
}
.locked-hint {
  flex: 1;
  font-size: 24rpx;
  color: #8c7d68;
  padding: 0 8rpx;
}

/* ===== 接管横幅（交还分身入口） ===== */
.takeover-banner {
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.35);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.takeover-banner-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}

/* ===== 群生命周期 ===== */
.dissolved-banner {
  background: rgba(59, 48, 36, 0.12);
  border: 1rpx dashed rgba(59, 48, 36, 0.4);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.dissolved-banner-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #6b5b4a;
}
.group-admin-row {
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.group-admin-label {
  font-size: 22rpx;
  color: #a89982;
}
.group-admin-btn {
  font-size: 22rpx;
  font-weight: bold;
  color: #b45309;
  background: rgba(180, 83, 9, 0.08);
  border: 1rpx solid rgba(180, 83, 9, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}
.group-admin-btn-plain {
  color: #8c7d68;
  background: rgba(59, 48, 36, 0.05);
  border-color: rgba(59, 48, 36, 0.25);
}
