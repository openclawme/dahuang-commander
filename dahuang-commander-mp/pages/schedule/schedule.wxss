page { background: #f4f1ea; }
.container { padding: 20rpx 24rpx 160rpx; }

.seg-row {
  display: flex;
  flex-direction: row;
  background: rgba(253, 251, 247, 0.9);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b5b4a;
  padding: 14rpx 0;
  border-radius: 999rpx;
}
.seg.active {
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
  font-weight: bold;
}

.empty { padding: 120rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.empty-title { font-size: 32rpx; color: #6b5b4a; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #a2907a; }

.group { margin-bottom: 28rpx; }
.group-head { margin-bottom: 12rpx; }
.group-title { font-size: 26rpx; font-weight: bold; color: #4a3a2a; }
.group-count {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #8c7d68;
  background: rgba(59, 48, 36, 0.08);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.sched-card {
  background: #fdfbf7;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 18rpx -12rpx rgba(59, 48, 36, 0.25);
}
.sched-card.overdue { border-color: rgba(158, 42, 43, 0.45); }
.sched-check {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(59, 48, 36, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
}
.sched-check.checked { background: #47857a; border-color: #47857a; }
.sched-main { flex: 1; min-width: 0; }
.sched-line { margin-bottom: 6rpx; }
.sched-time { font-size: 28rpx; font-weight: bold; color: #9e2a2b; margin-right: 14rpx; }
.sched-kind {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.18);
  color: #6b5b4a;
}
.kind-reminder { color: #9e2a2b; border-color: rgba(158, 42, 43, 0.35); }
.kind-task { color: #47857a; border-color: rgba(71, 133, 122, 0.35); }
.kind-renewal { color: #b45309; border-color: rgba(180, 83, 9, 0.35); }
.kind-bill { color: #b45309; border-color: rgba(180, 83, 9, 0.35); }
.kind-delivery { color: #5b7a8c; border-color: rgba(91, 122, 140, 0.35); }
.sched-title { font-size: 28rpx; color: #1a1a1a; }
.sched-note { font-size: 22rpx; color: #8c7d68; margin-top: 6rpx; }

.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9e2a2b, #be123c);
  color: #ffffff;
  font-size: 48rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx -8rpx rgba(158, 42, 43, 0.5);
}

.sheet-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.35); z-index: 90; }
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fdfbf7;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 91;
}
.sheet-title { font-size: 30rpx; font-weight: bold; color: #4a3a2a; margin-bottom: 24rpx; }
.sheet-input {
  color: #3b3024;
  min-height: 56rpx;
  line-height: 1.5;
  background: #f4f1ea;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.sheet-row { gap: 20rpx; margin-bottom: 28rpx; }
.sheet-picker {
  background: #f4f1ea;
  border-radius: 16rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  color: #4a3a2a;
}
.sheet-actions { gap: 20rpx; }
.sheet-btn { flex: 1; text-align: center; border-radius: 999rpx; padding: 22rpx 0; font-size: 28rpx; }
.sheet-btn-plain { background: rgba(59, 48, 36, 0.08); color: #6b5b4a; }
.sheet-btn-primary { background: linear-gradient(135deg, #9e2a2b, #be123c); color: #ffffff; font-weight: bold; }

.sched-time-muted { color: #8c7d68 !important; font-weight: normal !important; }
.sched-repeat {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #47857a;
  background: rgba(71, 133, 122, 0.08);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.sheet-btn-ghost { background: rgba(71, 133, 122, 0.1); color: #47857a; }
