/* ===== 知识库 v3：问答 + 文档（古风淡雅） ===== */
.kb-container {
  height: 100vh;
  background: #f6f1e7;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 头部统计 */
.kb-head { flex-shrink: 0; padding: 24rpx 28rpx 12rpx; }
.kb-head-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(91, 122, 140, 0.9);
  color: #fdf8ec;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kb-head-title { font-size: 36rpx; color: #2b2a26; font-weight: 700; }
.kb-head-sub { font-size: 23rpx; color: #8a7f6d; }

/* 双段切换 */
.kb-seg {
  flex-shrink: 0;
  margin: 8rpx 28rpx 0;
  background: rgba(255, 253, 246, 0.9);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 6rpx;
}
.kb-seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8a7f6d;
  padding: 12rpx 0;
  border-radius: 999rpx;
}
.kb-seg-on {
  background: rgba(201, 163, 76, 0.18);
  color: #6b4f14;
  font-weight: 700;
  box-shadow: inset 0 0 0 1rpx rgba(168, 132, 47, 0.3);
}

/* ===== 文档面板 ===== */
.kb-pane {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16rpx 24rpx 240rpx;
  box-sizing: border-box;
}

/* 搜索 */
.kb-search {
  background: #fffdf6;
  border: 1rpx solid rgba(168, 132, 47, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  gap: 10rpx;
}
.kb-search-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: rgba(176, 84, 63, 0.85);
  color: #fdf8ec;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kb-search-input { flex: 1; font-size: 27rpx; color: #2b2a26; height: 56rpx; line-height: 56rpx; }
.kb-search-placeholder { color: #a89f8e; }
.kb-search-btn {
  background: rgba(201, 163, 76, 0.16);
  color: #8a6d1f;
  font-size: 25rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* 管理工具行 */
.kb-tools { margin-top: 16rpx; justify-content: space-between; }
.kb-manage-btn {
  font-size: 24rpx;
  color: #35586a;
  font-weight: 600;
  border: 1rpx solid rgba(91, 122, 140, 0.35);
  background: rgba(91, 122, 140, 0.1);
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  flex-shrink: 0;
}
.kb-tools-hint { flex: 1; margin-left: 16rpx; font-size: 21rpx; color: #a89f8e; }

/* 列表 */
.kb-list { margin-top: 16rpx; gap: 14rpx; }
.kb-doc-card {
  background: #fffdf6;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  gap: 16rpx;
}
.kb-doc-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: rgba(91, 122, 140, 0.12);
  color: #4a6a7c;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kb-doc-title { flex: 1; min-width: 0; font-size: 28rpx; color: #2b2a26; font-weight: 600; line-height: 1.4; }
.kb-doc-tag {
  flex-shrink: 0;
  font-size: 19rpx;
  color: #b0543f;
  border: 1rpx solid rgba(176, 84, 63, 0.4);
  border-radius: 6rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  line-height: 1.6;
}
.kb-doc-meta { font-size: 22rpx; color: #8a7f6d; margin-top: 4rpx; }
.kb-doc-arrow { font-size: 28rpx; color: #a89f8e; flex-shrink: 0; }
.kb-doc-switch { transform: scale(0.72); transform-origin: right center; flex-shrink: 0; }

/* 多选圈 */
.kb-sel {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(168, 132, 47, 0.55);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kb-sel-on { background: #b0543f; border-color: #b0543f; }
.kb-sel-tick { color: #fdf8ec; font-size: 24rpx; font-weight: 700; }

/* 搜索结果 */
.kb-hit-list { margin-top: 16rpx; gap: 14rpx; }
.kb-hit-card {
  background: #fffdf6;
  border: 1rpx solid rgba(168, 132, 47, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  gap: 8rpx;
}
.kb-hit-title { flex: 1; min-width: 0; font-size: 27rpx; color: #2b2a26; font-weight: 600; }
.kb-hit-score { flex-shrink: 0; margin-left: 12rpx; font-size: 21rpx; color: #b0543f; font-weight: 600; }
.kb-hit-snippet { display: block; font-size: 24rpx; color: #6b665c; line-height: 1.6; }
.kb-hit-clear { margin-top: 4rpx; font-size: 23rpx; color: #4a6a7c; text-align: center; padding: 12rpx 0 30rpx; }

/* 关键词高亮（rich-text 内 span） */
.kb-hl {
  background: rgba(201, 163, 76, 0.38);
  color: #6b4f14;
  border-radius: 4rpx;
  padding: 0 2rpx;
}

/* 空态 */
.kb-empty-box { padding: 80rpx 0; gap: 10rpx; }
.kb-empty-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: rgba(201, 163, 76, 0.12);
  border: 1rpx solid rgba(168, 132, 47, 0.35);
  color: #8a6d1f;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.kb-empty-title { font-size: 29rpx; color: #2b2a26; font-weight: 700; }
.kb-empty-text { font-size: 24rpx; color: #8a7f6d; }

/* ===== 问答面板 ===== */
.kb-qa { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.kb-qa-clear-row { display: flex; flex-direction: row; justify-content: flex-end; padding: 10rpx 28rpx 0; }
.kb-qa-clear { font-size: 22rpx; color: #8a7f6d; text-decoration: underline; padding: 4rpx 8rpx; }

.kb-qa-scroll { flex: 1; min-height: 0; box-sizing: border-box; padding: 16rpx 24rpx 8rpx; }
.kb-qa-empty { padding: 90rpx 40rpx 0; gap: 10rpx; }
.kb-qa-empty-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: rgba(91, 122, 140, 0.12);
  color: #4a6a7c;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.kb-qa-empty-title { font-size: 29rpx; color: #2b2a26; font-weight: 700; }
.kb-qa-empty-text { font-size: 24rpx; color: #8a7f6d; }

.kb-qa-msg { display: flex; margin-bottom: 20rpx; }
.kb-qa-user { justify-content: flex-end; }
.kb-qa-bubble {
  max-width: 76%;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
}
.kb-qa-bubble-user {
  background: rgba(91, 122, 140, 0.85);
  color: #fdf8ec;
  border-top-right-radius: 6rpx;
}
.kb-qa-bubble-ai {
  background: #fffdf6;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  color: #2b2a26;
  border-top-left-radius: 6rpx;
}
.kb-qa-text { display: block; white-space: pre-wrap; }
.kb-qa-cites { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.kb-qa-cite {
  font-size: 22rpx;
  color: #8a6d1f;
  background: rgba(201, 163, 76, 0.16);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.kb-qa-typing { font-size: 23rpx; color: #a89f8e; padding: 8rpx 4rpx 20rpx; }

.kb-qa-inputbar {
  flex-shrink: 0;
  background: #fffdf6;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}
.kb-qa-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #f6f1e7;
  border: 1rpx solid rgba(168, 132, 47, 0.35);
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  color: #2b2a26;
  box-sizing: border-box;
}
.kb-qa-send {
  flex-shrink: 0;
  background: #b0543f;
  color: #fdf8ec;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 16rpx 34rpx;
}
.kb-qa-send-dim { opacity: 0.5; }

/* ===== 底部：管理栏 / 上传 ===== */
.kb-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fffdf6;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  justify-content: space-between;
}
.kb-bar-btn {
  border: 1rpx solid rgba(91, 122, 140, 0.35);
  background: rgba(91, 122, 140, 0.1);
  color: #35586a;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 12rpx 36rpx;
}
.kb-bar-danger { border-color: rgba(176, 84, 63, 0.4); background: rgba(176, 84, 63, 0.08); color: #b0543f; }
.kb-bar-disabled { opacity: 0.4; }
.kb-bar-count { font-size: 25rpx; color: #8a7f6d; }

.kb-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fffdf6;
  border-top: 1rpx solid rgba(59, 48, 36, 0.08);
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.kb-footer-btn {
  gap: 10rpx;
  background: rgba(91, 122, 140, 0.12);
  border: 1rpx solid rgba(91, 122, 140, 0.35);
  border-radius: 999rpx;
  padding: 14rpx 60rpx;
}
.kb-footer-plus { font-size: 30rpx; color: #4a6a7c; }
.kb-footer-label { font-size: 27rpx; color: #35586a; font-weight: 700; }
.kb-footer-hint { font-size: 20rpx; color: #a89f8e; }

.text-ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hover-dim { opacity: 0.75; }
