.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  min-height: 100%;
  box-sizing: border-box;
}

.summary-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
  margin-bottom: 20rpx;
}

.summary-item {
  flex: 1;
}

.summary-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.summary-lbl {
  font-size: 20rpx;
  color: #8c7d68;
  margin-top: 6rpx;
}

.summary-divider {
  width: 1rpx;
  background: rgba(59, 48, 36, 0.12);
  margin: 0 24rpx;
}

.refresh-row {
  margin-bottom: 20rpx;
}

.refresh-hint {
  font-size: 20rpx;
  color: #8c7d68;
}

.refresh-btn {
  font-size: 24rpx;
  font-weight: bold;
  color: #5b7a8c;
  background: rgba(91, 122, 140, 0.1);
  border: 1rpx solid rgba(91, 122, 140, 0.35);
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}

.loading-box {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8c7d68;
}

.orders-list {
  gap: 16rpx;
}

.order-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(59, 48, 36, 0.12);
}

.order-platform {
  font-size: 20rpx;
  font-weight: bold;
  color: #6b5b4a;
  background: rgba(59, 48, 36, 0.06);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.order-status {
  font-size: 20rpx;
  font-weight: bold;
}

.status-SETTLED { color: #3b5e59; }
.status-PAID { color: #d97706; }
.status-INVALID { color: #8c7d68; }

.order-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-top: 12rpx;
  line-height: 1.4;
}

.order-time {
  font-size: 20rpx;
  color: #8c7d68;
}

.order-commission {
  font-size: 24rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-art {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  font-family: "Noto Serif SC", "Songti SC", serif;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.06);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6b5b4a;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #8c7d68;
  line-height: 1.6;
}
