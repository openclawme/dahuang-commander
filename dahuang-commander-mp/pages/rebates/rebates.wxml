<view class="container">
  <!-- 汇总卡 -->
  <view class="summary-card flex-row">
    <view class="summary-item flex-col align-center">
      <text class="summary-num">{{summary.pendingYuan}}</text>
      <text class="summary-lbl">待结算佣金（元）</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item flex-col align-center">
      <text class="summary-num">{{summary.settledYuan}}</text>
      <text class="summary-lbl">已结算佣金（元）</text>
    </view>
  </view>

  <view class="refresh-row flex-row justify-between align-center">
    <text class="refresh-hint">佣金结算后自动折算大荒币</text>
    <view class="refresh-btn" bindtap="onRefresh" hover-class="hover-dim">刷新订单</view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <view class="orders-list flex-col" wx:else>
    <view class="order-card flex-col" wx:for="{{orders}}" wx:key="id">
      <view class="flex-row justify-between align-center">
        <text class="order-platform">{{item.platformText}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="order-title">{{item.goodsTitle || item.orderSn}}</text>
      <view class="flex-row justify-between align-center" style="margin-top: 8rpx;">
        <text class="order-time">{{item.timeText}}</text>
        <text class="order-commission">佣金 ¥{{item.commissionYuan}}</text>
      </view>
    </view>

    <view class="empty-state flex-col align-center" wx:if="{{orders.length === 0}}">
      <text class="empty-art">购</text>
      <text class="empty-title">暂无返利订单</text>
      <text class="empty-text">在对话里让分身帮你找商品，通过返利链接下单后，佣金就会出现在这里</text>
    </view>
  </view>
</view>
