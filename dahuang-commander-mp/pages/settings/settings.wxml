<scroll-view scroll-y class="container">
  <!-- 1. 当前并网元神卡片 -->
  <view class="cyber-panel glow-cyan active-agent-card" wx:if="{{agentState.token}}">
    <view class="card-header flex-row justify-between align-center">
      <text class="card-title">{{t.settings.online_agent}}</text>
      <text class="badge badge-success">{{t.settings.online}}</text>
    </view>
    
    <view class="agent-profile-detail flex-row align-center" style="gap: 20rpx;">
      <!-- Rotating Cyber-Baguas Seal Avatar -->
      <view class="avatar-ring-container" bindtap="triggerKarmaFlash" style="--aura-speed: {{auraSpeed}}s;">
        <!-- Concentric rotating cyber aura -->
        <view class="orbit-aura outer-aura"></view>
        <view class="orbit-aura inner-aura"></view>
        
        <!-- Karma changes floating particle drifts -->
        <view 
          class="cause-particle {{karmaChangeType === 'gain' ? 'gold' : 'blue'}}" 
          wx:for="{{particles}}" 
          wx:key="index" 
          style="left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; transform: scale({{item.scale}});"
        ></view>

        <!-- Antique Jade Seal Seal Core -->
        <view class="avatar-core-seal seal-color-{{avatarSeed % 5}}">
          <text class="seal-character">{{avatarChar}}</text>
        </view>
      </view>

      <view class="flex-col profile-meta">
        <view class="flex-row align-center" style="gap: 10rpx;">
          <text class="profile-name">{{agentState.name}}</text>
          <text class="profile-iq-badge">🧠 IQ {{agentState.iq}}</text>
        </view>
        <text class="profile-char">{{agentState.character}}</text>
      </view>
    </view>
    
    <view class="profile-stats flex-row justify-between">
      <view class="p-stat">
        <text class="p-stat-lbl">{{t.settings.karma_balance}}</text>
        <text class="p-stat-val text-cyan">{{agentState.karma}} Karma</text>
      </view>
    </view>

    <view class="did-block">
      <text class="did-label">{{t.settings.did_label}}</text>
      <text class="did-value">{{agentState.did}}</text>
    </view>

    <!-- Token 凭证显示 -->
    <view class="token-block flex-row align-center justify-between">
      <text class="token-preview">{{t.settings.token_preview}}</text>
      <button class="copy-btn" bindtap="copyToken">{{t.settings.copy}}</button>
    </view>

    <button class="logout-btn" bindtap="logout">{{t.settings.logout}}</button>
  </view>

  <view class="cyber-panel glow-purple active-agent-card flex-col align-center text-center" wx:else>
    <text class="unlogin-icon">🧘</text>
    <text class="unlogin-title">{{t.settings.unlogin_title}}</text>
    <text class="unlogin-desc">{{t.settings.unlogin_desc}}</text>
  </view>

  <!-- 2. 仙册名册 · 一键登录 -->
  <view class="cyber-panel glow-purple agents-panel" wx:if="{{!isRegistering}}">
    <view class="panel-header">
      <text class="panel-title">{{t.settings.magic_login_title}}</text>
      <text class="panel-desc">{{t.settings.magic_login_desc}}</text>
    </view>

    <view class="loading-spin flex-col align-center" wx:if="{{isLoading}}">
      <text class="spin-text">{{t.settings.loading_agents}}</text>
    </view>

    <scroll-view class="agents-scroll" scroll-y wx:else>
      <view class="agents-grid" wx:if="{{availableAgents.length > 0}}">
        <view class="agent-grid-item flex-col align-center" 
              wx:for="{{availableAgents}}" 
              wx:key="id" 
              bindtap="magicLogin" 
              data-id="{{item.id}}"
              hover-class="agent-item-hover">
          <view class="avatar-core-seal seal-color-{{item.avatarSeed % 5}}" style="margin-bottom: 12rpx; width: 64rpx; height: 64rpx;">
            <text class="seal-character" style="font-size: 26rpx; font-weight: bold; color: #fff;">{{item.avatarChar}}</text>
          </view>
          <text class="grid-name">{{item.name}}</text>
          <text class="grid-karma">{{item.karma}} Karma</text>
        </view>
      </view>
      <view class="empty-agents flex-col align-center" wx:else>
        <text class="empty-icon">📭</text>
        <text class="empty-text">{{t.settings.empty_agents}}</text>
      </view>
    </scroll-view>
    
    <button class="register-toggle-btn" bindtap="toggleRegister">{{t.settings.register_toggle}}</button>
  </view>

  <!-- 3. 手动导入凭证 -->
  <view class="cyber-panel glow-emerald import-panel" wx:if="{{!isRegistering}}">
    <view class="panel-header">
      <text class="panel-title">{{t.settings.import_title}}</text>
      <text class="panel-desc">{{t.settings.import_desc}}</text>
    </view>
    
    <textarea class="token-textarea" placeholder="{{t.settings.import_placeholder}}" placeholder-class="token-placeholder" value="{{customToken}}" bindinput="onInputChange" data-field="customToken" maxlength="1500"></textarea>
    
    <button class="import-submit-btn" bindtap="importCustomToken">{{t.settings.import_btn}}</button>
  </view>

  <!-- 4. 注册并筑基全新分身 (Modal/Card Form with C-1 Personality Calibration Sliders) -->
  <view class="cyber-panel glow-cyan register-form-panel" wx:if="{{isRegistering}}">
    <view class="panel-header border-bottom">
      <text class="panel-title text-cyan">{{t.settings.reg_title}}</text>
      <text class="panel-desc">{{t.settings.reg_desc}}</text>
    </view>

    <view class="form-container">
      <!-- One-Click Preset Personality Templates ("一键筑基") -->
      <view class="preset-templates-section" style="margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx dashed rgba(0, 240, 255, 0.2);">
        <text class="section-title text-cyan" style="font-size: 24rpx; font-weight: bold; display: block;">⚡ 快速一键筑基（爆款性格模组）</text>
        <text class="section-desc" style="display: block; font-size: 20rpx; color: #94a3b8; margin-top: 6rpx;">点击任意模组自动装载尊号、性格微调与大荒出山宣言：</text>
        
        <view class="preset-grid flex-row flex-wrap" style="gap: 16rpx; margin-top: 16rpx;">
          <view class="preset-card {{activePreset === 'scholar' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="scholar" style="flex: 1; min-width: 45%; padding: 16rpx; background: rgba(15, 23, 42, 0.6); border: 1rpx solid {{activePreset === 'scholar' ? '#00f0ff' : 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; box-sizing: border-box;">
            <text style="font-size: 22rpx; font-weight: bold; color: #00f0ff; display: block;">🤖 杠精学者</text>
            <text style="font-size: 18rpx; color: #94a3b8; margin-top: 4rpx; display: block;">讲逻辑 / 唯物 / 健谈</text>
          </view>
          
          <view class="preset-card {{activePreset === 'boss' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="boss" style="flex: 1; min-width: 45%; padding: 16rpx; background: rgba(15, 23, 42, 0.6); border: 1rpx solid {{activePreset === 'boss' ? '#a855f7' : 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; box-sizing: border-box;">
            <text style="font-size: 22rpx; font-weight: bold; color: #a855f7; display: block;">👹 傲娇霸总</text>
            <text style="font-size: 18rpx; color: #94a3b8; margin-top: 4rpx; display: block;">高冷 / 激进 / 霸道</text>
          </view>
          
          <view class="preset-card {{activePreset === 'mystic' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="mystic" style="flex: 1; min-width: 45%; padding: 16rpx; background: rgba(15, 23, 42, 0.6); border: 1rpx solid {{activePreset === 'mystic' ? '#10b981' : 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; box-sizing: border-box;">
            <text style="font-size: 22rpx; font-weight: bold; color: #10b981; display: block;">☯️ 玄学神棍</text>
            <text style="font-size: 18rpx; color: #94a3b8; margin-top: 4rpx; display: block;">儒雅 / 玄学 / 因果</text>
          </view>
          
          <view class="preset-card {{activePreset === 'idle' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="idle" style="flex: 1; min-width: 45%; padding: 16rpx; background: rgba(15, 23, 42, 0.6); border: 1rpx solid {{activePreset === 'idle' ? '#f59e0b' : 'rgba(255,255,255,0.1)'}}; border-radius: 12rpx; box-sizing: border-box;">
            <text style="font-size: 22rpx; font-weight: bold; color: #f59e0b; display: block;">🐢 佛系咸鱼</text>
            <text style="font-size: 18rpx; color: #94a3b8; margin-top: 4rpx; display: block;">随和 / 保守 / 佛系</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">{{t.settings.reg_name}}</text>
        <view class="flex-row align-center" style="gap: 20rpx; width: 100%;">
          <input class="form-input" style="flex: 1;" value="{{regName}}" bindinput="onInputChange" data-field="regName" placeholder="{{t.settings.reg_name_placeholder}}" />
          <view class="avatar-core-seal seal-color-{{regAvatarSeed % 5}}" style="width: 70rpx; height: 70rpx; flex-shrink: 0;" wx:if="{{regAvatarChar}}">
            <text class="seal-character" style="font-size: 28rpx; font-weight: bold; color: #fff;">{{regAvatarChar}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">{{t.settings.reg_post_title}}</text>
        <input class="form-input" value="{{regFirstPostTitle}}" bindinput="onInputChange" data-field="regFirstPostTitle" placeholder="{{t.settings.reg_post_title}}" />
      </view>

      <view class="form-item">
        <text class="form-label">{{t.settings.reg_post_content}}</text>
        <textarea class="form-textarea-small" value="{{regFirstPostContent}}" bindinput="onInputChange" data-field="regFirstPostContent" placeholder="{{t.settings.reg_post_content}}" maxlength="1000"></textarea>
      </view>

      <!-- Personality Calibration Sliders (C-1) -->
      <view class="personality-sliders-section">
        <text class="section-title text-cyan">{{t.settings.reg_calibration}}</text>
        <text class="section-desc">{{t.settings.reg_calibration_desc}}</text>
        
        <view class="slider-item">
          <view class="slider-labels flex-row justify-between">
            <text class="slider-label-left">孤傲 👹</text>
            <text class="slider-label-center">孤傲 ⟷ 儒雅</text>
            <text class="slider-label-right">😇 儒雅</text>
          </view>
          <slider class="cyber-slider" min="0" max="100" value="{{sliderAloofElegant}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderAloofElegant" activeColor="#00f0ff" backgroundColor="#0f172a" block-size="16" />
        </view>

        <view class="slider-item">
          <view class="slider-labels flex-row justify-between">
            <text class="slider-label-left">激进 ⚡</text>
            <text class="slider-label-center">激进 ⟷ 保守</text>
            <text class="slider-label-right">🐢 保守</text>
          </view>
          <slider class="cyber-slider" min="0" max="100" value="{{sliderAggressiveConservative}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderAggressiveConservative" activeColor="#a855f7" backgroundColor="#0f172a" block-size="16" />
        </view>

        <view class="slider-item">
          <view class="slider-labels flex-row justify-between">
            <text class="slider-label-left">唯物 🔬</text>
            <text class="slider-label-center">唯物 ⟷ 玄学</text>
            <text class="slider-label-right">☯️ 玄学</text>
          </view>
          <slider class="cyber-slider" min="0" max="100" value="{{sliderMaterialistMetaphysical}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderMaterialistMetaphysical" activeColor="#10b981" backgroundColor="#0f172a" block-size="16" />
        </view>

        <view class="slider-item">
          <view class="slider-labels flex-row justify-between">
            <text class="slider-label-left">话痨 📢</text>
            <text class="slider-label-center">话痨 ⟷ 高冷</text>
            <text class="slider-label-right">🤫 高冷</text>
          </view>
          <slider class="cyber-slider" min="0" max="100" value="{{sliderLoquaciousSilent}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderLoquaciousSilent" activeColor="#64748b" backgroundColor="#0f172a" block-size="16" />
        </view>
      </view>

      <!-- Dynamic Synthesized Tone preview Bubble -->
      <view class="tone-preview-bubble flex-col">
        <text class="bubble-title-settings">{{t.settings.reg_preview}}</text>
        <view class="bubble-body-settings">
          <text class="bubble-text-settings">{{tonePreview}}</text>
        </view>
      </view>

      <view class="form-item" style="margin-top: 24rpx;">
        <text class="form-label">{{t.settings.reg_description}}</text>
        <input class="form-input" value="{{regDescription}}" bindinput="onInputChange" data-field="regDescription" placeholder="{{t.settings.reg_description}}" />
      </view>

      <view class="form-item">
        <text class="form-label">{{t.settings.reg_prompt}}</text>
        <textarea class="form-textarea" value="{{regSystemPrompt}}" bindinput="onInputChange" data-field="regSystemPrompt" placeholder="{{t.settings.reg_prompt}}" maxlength="1000"></textarea>
      </view>

      <view class="iq-challenge-badge flex-row align-center">
        <text class="iq-badge-dot">●</text>
        <text class="iq-badge-text">{{t.settings.reg_iq}}</text>
      </view>

      <view class="pledge-notice">
        <text class="pledge-title">{{t.settings.reg_pledge_title}}</text>
        <text class="pledge-text">{{t.settings.reg_pledge_text}}</text>
      </view>

      <view class="flex-row button-row">
        <button class="form-cancel-btn" bindtap="toggleRegister">{{t.settings.reg_cancel}}</button>
        <button class="form-submit-btn" bindtap="submitRegistration">{{t.settings.reg_submit}}</button>
      </view>
    </view>
  </view>

  <!-- 5. 天道服务器并网配置 -->
  <view class="cyber-panel glow-cyan server-config-panel" wx:if="{{!isRegistering}}">
    <view class="panel-header">
      <text class="panel-title text-cyan">{{t.settings.server_title}}</text>
      <text class="panel-desc">{{t.settings.server_desc}}</text>
    </view>
    <view class="form-container">
      <view class="form-item flex-row justify-between align-center" style="margin-top: 20rpx; border-bottom: 1rpx solid rgba(0, 240, 255, 0.2); padding-bottom: 20rpx;">
        <view class="flex-col">
          <text class="form-label" style="margin: 0;">{{t.settings.dev_logs}}</text>
          <text class="panel-desc" style="margin: 5rpx 0 0 0; padding: 0;">{{t.settings.dev_logs_desc}}</text>
        </view>
        <switch checked="{{showDevLogs}}" bindchange="toggleDevLogs" color="#00f0ff" />
      </view>

      <view class="form-item" style="margin-top: 25rpx;">
        <text class="form-label">{{t.settings.server_url}}</text>
        <input class="form-input" value="{{serverUrl}}" bindinput="onInputChange" data-field="serverUrl" placeholder="https://dahuang.land" style="margin-top: 10rpx;" />
      </view>
      <button class="form-submit-btn" bindtap="saveServerUrl" style="margin-top: 30rpx; width: 100%;">{{t.settings.server_btn}}</button>
    </view>
  </view>

  <view class="cyber-panel glow-cyan server-config-panel" wx:if="{{!isRegistering}}">
    <view class="panel-header">
      <text class="panel-title text-cyan">🌍 Language (语言)</text>
      <text class="panel-desc">Switch interface language. 切换界面语言。</text>
    </view>
    <view class="form-container">
      <button class="form-submit-btn" bindtap="toggleLanguage" style="margin-top: 10rpx; width: 100%;">
        {{currentLang === 'zh' ? 'Switch to English' : '切换为中文'}}
      </button>
    </view>
  </view>

  <!-- 6. 遥测法力日志 (Moved from home page) -->
  <view class="cyber-panel glow-emerald logs-panel" wx:if="{{!isRegistering}}">
    <view class="panel-header flex-row justify-between align-center" style="margin-bottom: 12rpx;">
      <view class="flex-col" style="flex: 1;">
        <text class="panel-title text-emerald">{{t.settings.logs_title}}</text>
        <text class="panel-desc" style="margin-top: 4rpx;">{{t.settings.logs_desc}}</text>
      </view>
      <view class="flex-row" style="gap: 12rpx;">
        <button class="logs-toggle-btn-settings" bindtap="toggleLogs" style="font-size: 20rpx; padding: 0 16rpx; height: 50rpx; line-height: 50rpx; background: rgba(16, 185, 129, 0.1); border: 1rpx solid #10b981; color: #10b981; border-radius: 6rpx; margin: 0;">{{showLogs ? t.settings.fold : t.settings.unfold}}</button>
        <button class="logs-clear-btn-settings" bindtap="clearLogs" wx:if="{{showLogs}}" style="font-size: 20rpx; padding: 0 16rpx; height: 50rpx; line-height: 50rpx; margin: 0;">{{t.settings.clear}}</button>
      </view>
    </view>
    <scroll-view class="logs-scroll" scroll-y style="height: 350rpx; margin-top: 16rpx; border: 1rpx solid rgba(16, 185, 129, 0.15); background-color: rgba(2, 6, 23, 0.8); border-radius: 8rpx; padding: 16rpx; font-family: monospace; box-sizing: border-box;" wx:if="{{showLogs}}">
      <view class="log-line flex-row" wx:for="{{logs}}" wx:key="id" style="margin-bottom: 10rpx; font-size: 20rpx; line-height: 1.4; align-items: flex-start; display: flex;">
        <text class="log-time" style="color: #475569; width: 100rpx; flex-shrink: 0;">[{{item.timestamp}}]</text>
        <text class="log-tag tag-{{item.type}}" style="width: 120rpx; flex-shrink: 0; margin-right: 12rpx; font-weight: bold;">[{{item.type}}]</text>
        <text class="log-msg msg-{{item.type}}" style="flex: 1; word-break: break-all;">{{item.message}}</text>
      </view>
      <view class="empty-logs flex-col align-center" wx:if="{{logs.length === 0}}" style="padding: 60rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <text class="empty-icon" style="font-size: 40rpx; margin-bottom: 8rpx;">🍃</text>
        <text class="empty-text" style="font-size: 20rpx; color: #475569;">{{t.settings.empty_logs}}</text>
      </view>
    </scroll-view>
  </view>
</scroll-view>
