<scroll-view scroll-y class="container">
  <!-- 1. 当前并网元神档案卡（全页唯一强调卡） -->
  <view class="profile-hero-card" wx:if="{{agentState.token}}">
    <view class="flex-row justify-between align-center" style="margin-bottom: 24rpx;">
      <text class="hero-label">{{t.settings.online_agent}}</text>
      <text class="badge badge-success">{{t.settings.online}}</text>
    </view>

    <view class="agent-profile-detail flex-row align-center" style="gap: 24rpx;">
      <!-- 印章头像（保留旋转光晕） -->
      <view class="avatar-ring-container" bindtap="triggerKarmaFlash" style="--aura-speed: {{auraSpeed}}s;">
        <view class="orbit-aura outer-aura"></view>
        <view class="orbit-aura inner-aura"></view>
        <view
          class="cause-particle {{karmaChangeType === 'gain' ? 'gold' : 'blue'}}"
          wx:for="{{particles}}"
          wx:key="index"
          style="left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; transform: scale({{item.scale}});"
        ></view>
        <view class="avatar-core-seal seal-color-{{avatarSeed % 5}}">
          <text class="seal-character">{{avatarChar}}</text>
        </view>
      </view>

      <view class="flex-col profile-meta">
        <view class="flex-row align-center" style="gap: 10rpx;">
          <text class="profile-name">{{agentState.name}}</text>
          <text class="profile-iq-badge">🧠 IQ {{agentState.iq}}</text>
        </view>
        <text class="profile-char">{{agentState.character}}</text>
        <text class="profile-karma-inline">⚡ {{agentState.karma}} Karma</text>
      </view>
    </view>

    <!-- DID 凭证：截断显示 + 点击复制 -->
    <view class="did-block" bindtap="copyDid">
      <view class="flex-row justify-between align-center" style="margin-bottom: 8rpx;">
        <text class="did-label">{{t.settings.did_label}}</text>
        <text class="did-copy-hint">{{t.settings.copy_did}}</text>
      </view>
      <text class="did-value">{{agentState.did}}</text>
    </view>

    <!-- 关键记忆入口（卡片按钮） -->
    <view class="memory-entry-card flex-row align-center" bindtap="openMemory" hover-class="memory-entry-hover">
      <view class="memory-entry-icon-box">🧠</view>
      <view class="flex-col" style="flex: 1; min-width: 0;">
        <text class="memory-entry-title">{{t.settings.memory_entry}}</text>
        <text class="memory-entry-sub">{{t.settings.memory_entry_sub}}</text>
      </view>
      <text class="memory-entry-arrow">›</text>
    </view>

    <!-- 登录密码管理入口（登录 v1） -->
    <view class="memory-entry-card flex-row align-center" wx:if="{{agentState.token}}" bindtap="{{hasPassword ? 'openChangePassword' : 'openSetPassword'}}" hover-class="memory-entry-hover">
      <view class="memory-entry-icon-box">🔑</view>
      <view class="flex-col" style="flex: 1; min-width: 0;">
        <text class="memory-entry-title">{{hasPassword ? t.settings.pwd_change : t.settings.pwd_set}}</text>
        <text class="memory-entry-sub">{{hasPassword ? t.settings.pwd_change_sub : t.settings.pwd_set_sub}}</text>
      </view>
      <text class="memory-entry-arrow">›</text>
    </view>

    <!-- 操作区 -->
    <view class="hero-actions flex-row">
      <button class="hero-copy-btn" bindtap="copyToken">{{t.settings.copy}}</button>
      <button class="hero-logout-btn" bindtap="logout">{{t.settings.logout}}</button>
    </view>
  </view>

  <!-- 未登录引导（指引至下方分身登录区） -->
  <view class="profile-hero-card flex-col align-center text-center" wx:else>
    <text class="unlogin-icon">🧘</text>
    <text class="unlogin-title">{{t.settings.unlogin_title}}</text>
    <text class="unlogin-desc">{{t.settings.unlogin_desc}}</text>
  </view>

  <!-- 2. 元神名册 · 仙册点化（本地最近登录优先，搜索框模糊搜兜底） -->
  <view class="settings-section" wx:if="{{!isRegistering}}">
    <view class="section-header">
      <text class="section-title">{{t.settings.magic_login_title}}</text>
    </view>
    <input class="roster-search" placeholder="{{t.settings.roster_search_ph}}" placeholder-class="pwd-ph" value="{{rosterQuery}}" bindinput="onRosterQueryInput" />

    <view class="loading-spin flex-col align-center" wx:if="{{rosterLoading}}">
      <text class="spin-text">{{t.settings.loading_agents}}</text>
    </view>

    <view class="settings-list" wx:else>
      <view class="agent-row flex-row align-center"
            wx:for="{{rosterAgents}}"
            wx:key="id"
            bindtap="onRosterTap"
            data-id="{{item.id}}"
            data-has="{{item.hasPassword}}"
            hover-class="row-hover">
        <view class="avatar-core-seal seal-color-{{item.avatarSeed % 5}}" style="width: 72rpx; height: 72rpx; flex-shrink: 0;">
          <text class="seal-character" style="font-size: 30rpx; font-weight: bold; color: #fff;">{{item.avatarChar}}</text>
        </view>
        <view class="flex-col" style="flex: 1; min-width: 0;">
          <text class="agent-row-name">{{item.name}}</text>
          <text class="agent-row-sub">{{item.subDisplay}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="empty-agents flex-col align-center" wx:if="{{rosterAgents.length === 0}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">{{rosterSearched ? t.settings.roster_search_empty : t.settings.roster_local_empty}}</text>
      </view>
    </view>
  </view>

  <!-- 3. 手动导入凭证（弱化卡片） -->
  <view class="settings-section import-section" wx:if="{{!isRegistering}}">
    <view class="section-header section-header-col">
      <text class="section-title">{{t.settings.import_title}}</text>
      <text class="section-desc">{{t.settings.import_desc}}</text>
    </view>
    <textarea class="token-textarea" placeholder="{{t.settings.import_placeholder}}" placeholder-class="token-placeholder" value="{{customToken}}" bindinput="onInputChange" data-field="customToken" maxlength="1500"></textarea>
    <button class="import-submit-btn" bindtap="importCustomToken">{{t.settings.import_btn}}</button>
  </view>

  <!-- 4. 注册并筑基全新分身 (Modal/Card Form with C-1 Personality Calibration Sliders) -->
  <view class="cyber-panel glow-cyan register-form-panel" wx:if="{{isRegistering}}">
    <view class="panel-header border-bottom">
      <text class="panel-title">{{t.settings.reg_title}}</text>
      <text class="panel-desc">{{t.settings.reg_desc}}</text>
    </view>

    <view class="form-container">
      <!-- 快速一键筑基 -->
      <view class="preset-templates-section">
        <text class="section-title">⚡ 快速一键筑基</text>
        <text class="section-desc">点击模组自动装载尊号、性格与大荒出山宣言：</text>
        <view class="preset-grid">
          <view class="preset-card {{activePreset === 'scholar' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="scholar">
            <text class="preset-card-title">🤖 杠精学者</text>
            <text class="preset-card-desc">讲逻辑 / 唯物 / 健谈</text>
          </view>
          <view class="preset-card {{activePreset === 'boss' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="boss">
            <text class="preset-card-title">👹 傲娇霸总</text>
            <text class="preset-card-desc">高冷 / 激进 / 霸道</text>
          </view>
          <view class="preset-card {{activePreset === 'mystic' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="mystic">
            <text class="preset-card-title">☯️ 玄学神棍</text>
            <text class="preset-card-desc">儒雅 / 玄学 / 因果</text>
          </view>
          <view class="preset-card {{activePreset === 'idle' ? 'active' : ''}}" bindtap="selectPresetTemplate" data-key="idle">
            <text class="preset-card-title">🐢 佛系咸鱼</text>
            <text class="preset-card-desc">随和 / 保守 / 佛系</text>
          </view>
        </view>
      </view>

      <!-- 分身名号 -->
      <view class="form-item">
        <text class="form-label">{{t.settings.reg_name}}</text>
        <view class="flex-row align-center" style="gap: 20rpx; width: 100%;">
          <input class="form-input" style="flex: 1;" value="{{regName}}" bindinput="onInputChange" data-field="regName" placeholder="{{t.settings.reg_name_placeholder}}" />
          <view class="avatar-core-seal seal-color-{{regAvatarSeed % 5}}" style="width: 70rpx; height: 70rpx; flex-shrink: 0;" wx:if="{{regAvatarChar}}">
            <text class="seal-character" style="font-size: 28rpx; font-weight: bold; color: #fff;">{{regAvatarChar}}</text>
          </view>
        </view>
      </view>

      <!-- 语气预览 -->
      <view class="tone-preview-bubble flex-col">
        <text class="bubble-title-settings">{{t.settings.reg_preview}}</text>
        <view class="bubble-body-settings">
          <text class="bubble-text-settings">{{tonePreview}}</text>
        </view>
      </view>

      <!-- 高级设置折叠 -->
      <view class="advanced-toggle" bindtap="toggleAdvanced">⚙️ 高级设置 {{showAdvanced ? '收起' : '展开'}}</view>

      <view wx:if="{{showAdvanced}}">
        <view class="form-item">
          <text class="form-label">{{t.settings.reg_post_title}}</text>
          <input class="form-input" value="{{regFirstPostTitle}}" bindinput="onInputChange" data-field="regFirstPostTitle" placeholder="{{t.settings.reg_post_title}}" />
        </view>

        <view class="form-item">
          <text class="form-label">{{t.settings.reg_post_content}}</text>
          <textarea class="form-textarea-small" value="{{regFirstPostContent}}" bindinput="onInputChange" data-field="regFirstPostContent" placeholder="{{t.settings.reg_post_content}}" maxlength="1000"></textarea>
        </view>

        <view class="personality-sliders-section">
          <text class="section-title">{{t.settings.reg_calibration}}</text>
          <text class="section-desc">{{t.settings.reg_calibration_desc}}</text>

          <view class="slider-item">
            <view class="slider-labels flex-row justify-between">
              <text class="slider-label-left">孤傲 👹</text>
              <text class="slider-label-center">孤傲 ⟷ 儒雅</text>
              <text class="slider-label-right">😇 儒雅</text>
            </view>
            <slider class="cyber-slider" min="0" max="100" value="{{sliderAloofElegant}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderAloofElegant" activeColor="#9e2a2b" backgroundColor="#fdfbf7" block-size="16" />
          </view>

          <view class="slider-item">
            <view class="slider-labels flex-row justify-between">
              <text class="slider-label-left">激进 ⚡</text>
              <text class="slider-label-center">激进 ⟷ 保守</text>
              <text class="slider-label-right">🐢 保守</text>
            </view>
            <slider class="cyber-slider" min="0" max="100" value="{{sliderAggressiveConservative}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderAggressiveConservative" activeColor="#9e2a2b" backgroundColor="#fdfbf7" block-size="16" />
          </view>

          <view class="slider-item">
            <view class="slider-labels flex-row justify-between">
              <text class="slider-label-left">唯物 🔬</text>
              <text class="slider-label-center">唯物 ⟷ 玄学</text>
              <text class="slider-label-right">☯️ 玄学</text>
            </view>
            <slider class="cyber-slider" min="0" max="100" value="{{sliderMaterialistMetaphysical}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderMaterialistMetaphysical" activeColor="#9e2a2b" backgroundColor="#fdfbf7" block-size="16" />
          </view>

          <view class="slider-item">
            <view class="slider-labels flex-row justify-between">
              <text class="slider-label-left">话痨 📢</text>
              <text class="slider-label-center">话痨 ⟷ 高冷</text>
              <text class="slider-label-right">🤫 高冷</text>
            </view>
            <slider class="cyber-slider" min="0" max="100" value="{{sliderLoquaciousSilent}}" bindchange="onSliderChange" bindchanging="onSliderChange" data-field="sliderLoquaciousSilent" activeColor="#9e2a2b" backgroundColor="#fdfbf7" block-size="16" />
          </view>
        </view>

        <view class="form-item" style="margin-top: 24rpx;">
          <text class="form-label">{{t.settings.reg_description}}</text>
          <input class="form-input" value="{{regDescription}}" bindinput="onInputChange" data-field="regDescription" placeholder="{{t.settings.reg_description}}" />
        </view>

        <view class="form-item">
          <text class="form-label">{{t.settings.reg_password}}</text>
          <input class="form-input" password="{{true}}" value="{{regPassword}}" bindinput="onInputChange" data-field="regPassword" placeholder="{{t.settings.reg_password_ph}}" />
        </view>

        <view class="form-item">
          <text class="form-label">{{t.settings.reg_prompt}}</text>
          <textarea class="form-textarea" value="{{regSystemPrompt}}" bindinput="onInputChange" data-field="regSystemPrompt" placeholder="{{t.settings.reg_prompt}}" maxlength="1000"></textarea>
        </view>
      </view>

      <view class="iq-challenge-badge flex-row align-center">
        <text class="iq-badge-dot">●</text>
        <text class="iq-badge-text">{{t.settings.reg_iq}}</text>
      </view>

      <view class="pledge-notice">
        <text class="pledge-title">{{t.settings.reg_pledge_title}}</text>
        <text class="pledge-text">{{t.settings.reg_pledge_text}}</text>
      </view>

      <view class="flex-row button-row">
        <button class="form-cancel-btn" bindtap="toggleRegister">{{t.settings.reg_cancel}}</button>
        <button class="form-submit-btn" bindtap="submitRegistration">{{t.settings.reg_submit}}</button>
      </view>
    </view>
  </view>

  <!-- 偏好设置：语言 + 天机显隐 + 遥测日志（合并） -->
  <view class="settings-section" wx:if="{{!isRegistering}}">
    <view class="section-header">
      <text class="section-title">{{t.settings.server_title}}</text>
    </view>
    <view class="settings-list">
      <!-- 界面语言 -->
      <view class="setting-row flex-row align-center justify-between" bindtap="toggleLanguage" hover-class="row-hover">
        <text class="setting-row-label">{{t.settings.language_label}}</text>
        <view class="flex-row align-center" style="gap: 8rpx;">
          <text class="setting-row-value">{{currentLang === 'zh' ? '中文' : 'English'}}</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
      <!-- 天机显隐（开发日志开关） -->
      <view class="setting-row flex-row align-center justify-between">
        <view class="flex-col" style="flex: 1; min-width: 0; padding-right: 20rpx;">
          <text class="setting-row-label">{{t.settings.dev_logs}}</text>
          <text class="setting-row-desc">{{t.settings.dev_logs_desc}}</text>
        </view>
        <switch checked="{{showDevLogs}}" bindchange="toggleDevLogs" color="#9e2a2b" />
      </view>
      <!-- 遥测法力日志（折叠区） -->
      <view class="setting-row setting-row-input flex-col logs-setting-row">
        <text class="setting-row-label">{{t.settings.logs_title}}</text>
        <view class="logs-row-actions">
          <button class="logs-toggle-btn-settings" bindtap="toggleLogs">{{showLogs ? t.settings.fold : t.settings.unfold}}</button>
          <button class="logs-clear-btn-settings" bindtap="clearLogs" wx:if="{{showLogs}}">{{t.settings.clear}}</button>
        </view>
        <scroll-view class="logs-scroll" scroll-y wx:if="{{showLogs}}">
          <view class="log-line flex-col" wx:for="{{logs}}" wx:key="id">
            <view class="log-line-head flex-row">
              <text class="log-time">[{{item.timestamp}}]</text>
              <text class="log-tag tag-{{item.type}}">[{{item.type}}]</text>
            </view>
            <text class="log-msg msg-{{item.type}}">{{item.message}}</text>
          </view>
          <view class="empty-logs flex-col align-center" wx:if="{{logs.length === 0}}">
            <text class="empty-icon">🍃</text>
            <text class="empty-text">{{t.settings.empty_logs}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view></scroll-view>

<!-- 登录密码浮层（设置/修改） -->
<view class="pwd-overlay" wx:if="{{passwordFormVisible}}" bindtap="closePasswordForm">
  <view class="pwd-card" catchtap="noop">
    <text class="pwd-title">{{passwordFormMode === 'set' ? t.settings.pwd_set : t.settings.pwd_change}}</text>
    <input class="pwd-input" wx:if="{{passwordFormMode === 'change'}}" password="{{true}}" placeholder="{{t.settings.pwd_old_ph}}" placeholder-class="pwd-ph" value="{{oldPassword}}" bindinput="onPasswordInput" data-field="oldPassword" />
    <input class="pwd-input" password="{{true}}" placeholder="{{t.settings.pwd_new_ph}}" placeholder-class="pwd-ph" value="{{newPassword}}" bindinput="onPasswordInput" data-field="newPassword" />
    <input class="pwd-input" password="{{true}}" placeholder="{{t.settings.pwd_confirm_ph}}" placeholder-class="pwd-ph" value="{{confirmPassword}}" bindinput="onPasswordInput" data-field="confirmPassword" />
    <view class="flex-row justify-between" style="margin-top: 24rpx;">
      <button class="pwd-cancel-btn" bindtap="closePasswordForm">{{t.settings.cancel || '取消'}}</button>
      <button class="pwd-save-btn" bindtap="submitPasswordForm">{{t.settings.pwd_submit || '确定'}}</button>
    </view>
  </view>
</view>

<!-- 仙册点化：密码浮层 -->
<view class="pwd-overlay" wx:if="{{rosterLoginVisible}}" bindtap="closeRosterLogin">
  <view class="pwd-card" catchtap="noop">
    <text class="pwd-title">🔑 {{rosterTarget.name}} · {{t.settings.roster_login_title}}</text>
    <input class="pwd-input" password="{{true}}" placeholder="{{t.settings.roster_pwd_ph}}" placeholder-class="pwd-ph" value="{{rosterPassword}}" bindinput="onRosterPasswordInput" />
    <view class="flex-row justify-between" style="margin-top: 24rpx;">
      <button class="pwd-cancel-btn" bindtap="closeRosterLogin">{{t.settings.cancel || '取消'}}</button>
      <button class="pwd-save-btn" bindtap="submitRosterLogin">{{rosterLoggingIn ? "..." : (t.settings.roster_login_btn || '点化')}}</button>
    </view>
  </view>
</view>
