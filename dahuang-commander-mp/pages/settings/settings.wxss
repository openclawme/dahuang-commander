@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

/* Active Profile Card */
.active-agent-card {
  padding: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.card-header {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.1);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.agent-profile-detail {
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-ring-large {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #9e2a2b;
  background-color: rgba(158,42,43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.3);
}

.avatar-emoji {
  font-size: 50rpx;
}

.profile-meta {
  justify-content: center;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.profile-char {
  font-size: 22rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

.profile-stats {
  background: rgba(244,241,234, 0.6);
  border: 1rpx solid rgba(107,91,74, 0.15);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.p-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.p-stat-lbl {
  font-size: 20rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
}

.p-stat-val {
  font-size: 32rpx;
  font-weight: bold;
}

.did-block {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(253, 251, 247, 0.7);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 12rpx;
}

.did-block:active {
  background: rgba(158, 42, 43, 0.05);
  border-color: rgba(158, 42, 43, 0.25);
}

.did-label {
  font-size: 20rpx;
  color: #6b5b4a;
  font-weight: bold;
}

.did-copy-hint {
  font-size: 18rpx;
  color: #8c7d68;
}

.did-value {
  display: block;
  font-size: 22rpx;
  color: #9e2a2b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.profile-karma-inline {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #b8844f;
}

.token-block {
  background: rgba(244,241,234, 0.5);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.token-preview {
  font-size: 20rpx;
  color: #6b5b4a;
  flex: 1;
}

.copy-btn {
  background: rgba(158,42,43, 0.1);
  border: 1rpx solid #9e2a2b;
  color: #9e2a2b;
  font-size: 20rpx;
  font-weight: bold;
  padding: 0 16rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 4rpx;
  margin: 0;
}

.copy-btn::after {
  border: none;
}

.copy-btn:active {
  background: rgba(158,42,43, 0.25);
}

.logout-btn {
  background: rgba(190,18,60, 0.1);
  border: 1rpx solid rgba(190,18,60, 0.4);
  color: #be123c;
  font-size: 24rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  text-align: center;
  width: 100%;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(190,18,60, 0.2);
}

/* Unlogged card styles */
.unlogin-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.unlogin-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5b7a8c;
}

.unlogin-desc {
  font-size: 22rpx;
  color: #6b5b4a;
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 0 16rpx;
}

/* Agents Panel */
.panel-desc {
  font-size: 20rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
  line-height: 1.4;
}

.loading-spin {
  padding: 40rpx 0;
}

.spin-text {
  font-size: 24rpx;
  color: #6b5b4a;
}

.agents-scroll {
  height: 350rpx;
  margin-top: 20rpx;
}

.agents-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.agent-grid-item {
  width: calc(33.33% - 11rpx);
  background: rgba(244,241,234, 0.5);
  border: 1rpx solid rgba(91,122,140, 0.2);
  border-radius: 8rpx;
  padding: 16rpx;
  transition: all 0.2s ease;
}

.agent-item-hover {
  border-color: #5b7a8c;
  background: rgba(91,122,140, 0.1);
}

.grid-avatar {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.grid-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #3b3024;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.grid-karma {
  font-size: 20rpx;
  color: #5b7a8c;
  text-align: center;
  margin-top: 4rpx;
}

.empty-agents {
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 22rpx;
  color: #8c7d68;
}

.register-toggle-btn {
  background: linear-gradient(135deg, #5b7a8c, #8c4356);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  border: none;
  width: 100%;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(91,122,140, 0.4);
}

.register-toggle-btn::after {
  border: none;
}

.register-toggle-btn:active {
  opacity: 0.8;
}

/* Import Panel */
.token-textarea {
  width: 100%;
  height: 120rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(22,101,52, 0.3);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 22rpx;
  color: #1a1a1a;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.token-placeholder {
  color: #6b5b4a;
  font-size: 22rpx;
}

.import-submit-btn {
  background: linear-gradient(135deg, #166534, #3b5e59);
  color: #f4f1ea;
  font-size: 24rpx;
  font-weight: bold;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 6rpx;
  border: none;
  width: 100%;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(22,101,52, 0.3);
}

.import-submit-btn::after {
  border: none;
}

.import-submit-btn:active {
  opacity: 0.8;
}

/* Register Form Panel */
.register-form-panel {
  display: flex;
  flex-direction: column;
}

.border-bottom {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.1);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

.form-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.form-input {
  height: 70rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #9e2a2b;
}

.form-textarea-small {
  height: 100rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  height: 160rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.iq-challenge-badge {
  background: rgba(158,42,43, 0.08);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 14rpx 20rpx;
  margin-top: 10rpx;
}

.iq-badge-dot {
  color: #9e2a2b;
  font-size: 24rpx;
  margin-right: 12rpx;
  animation: pulse-cyan 1.5s infinite alternate;
}

.iq-badge-text {
  font-size: 18rpx;
  color: #9e2a2b;
  font-weight: bold;
}

@keyframes pulse-cyan {
  0% {
    opacity: 0.3;
  }
  100% {
    opacity: 1;
  }
}

.pledge-notice {
  margin-top: 10rpx;
  line-height: 1.5;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
}

.pledge-title {
  font-size: 20rpx;
  font-weight: bold;
  color: #a89982;
}

.pledge-text {
  font-size: 18rpx;
  color: #6b5b4a;
}

.button-row {
  gap: 20rpx;
  margin-top: 10rpx;
}

.form-cancel-btn {
  flex: 1;
  background: rgba(59, 48, 36, 0.1);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  color: #8c7d68;
  font-size: 24rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 0;
}

.form-cancel-btn::after {
  border: none;
}

.form-cancel-btn:active {
  background: rgba(59, 48, 36, 0.12);
}

.form-submit-btn {
  flex: 1;
  background: linear-gradient(135deg, #9e2a2b, #b35c44);
  color: #f4f1ea;
  font-size: 24rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  border: none;
  text-align: center;
  margin: 0;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.4);
}

.form-submit-btn::after {
  border: none;
}

.form-submit-btn:active {
  opacity: 0.8;
}

/* Telemetry Logs inside Settings */
.logs-clear-btn-settings {
  background: rgba(190,18,60, 0.1);
  border: 1rpx solid rgba(190,18,60, 0.3);
  color: #be123c;
  font-size: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  margin: 0;
}

.logs-clear-btn-settings::after {
  border: none;
}

.logs-clear-btn-settings:active {
  background: rgba(190,18,60, 0.25);
  border-color: #be123c;
}

.tag-SYSTEM { color: #6b5b4a; }
.tag-ACTION { color: #eab308; }
.tag-CHAT { color: #d946ef; }
.tag-ERROR { color: #be123c; }

.msg-SYSTEM { color: #8c7d68; }
.msg-ACTION { color: #fef08a; }
.msg-CHAT { color: #fbcfe8; }
.msg-ERROR { color: #fecdd3; }

/* Personality Sliders Calibration & Speech Preview (C-1) */
.personality-sliders-section {
  background: rgba(253,251,247, 0.4);
  border: 1rpx solid rgba(91,122,140, 0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.section-desc {
  font-size: 18rpx;
  color: #6b5b4a;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.slider-item {
  margin-bottom: 20rpx;
}

.slider-labels {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.slider-label-left {
  font-size: 18rpx;
  color: #6b5b4a;
  width: 100rpx;
  text-align: left;
}

.slider-label-center {
  font-size: 18rpx;
  font-weight: bold;
  color: #8c7d68;
}

.slider-label-right {
  font-size: 18rpx;
  color: #6b5b4a;
  width: 100rpx;
  text-align: right;
}

.cyber-slider {
  margin: 0;
  padding: 0;
}

/* Tone Preview Bubble Styles */
.tone-preview-bubble {
  background: rgba(244,241,234, 0.6);
  border-left: 6rpx solid #5b7a8c;
  border-radius: 0 16rpx 16rpx 0;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(91,122,140, 0.1);
}

.bubble-title-settings {
  font-size: 18rpx;
  font-weight: bold;
  color: #5b7a8c;
  margin-bottom: 8rpx;
  display: block;
}

.bubble-body-settings {
  min-height: 48rpx;
  display: flex;
  align-items: center;
}

.bubble-text-settings {
  font-size: 20rpx;
  color: #3b3024;
  line-height: 1.5;
  font-style: italic;
  display: block;
}

