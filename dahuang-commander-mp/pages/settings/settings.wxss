@import "../index/index.wxss";

.container {
  padding: 24rpx;
  background-color: #f4f1ea;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

/* Active Profile Card */
.active-agent-card {
  padding: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.card-header {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.1);
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.agent-profile-detail {
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-ring-large {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #9e2a2b;
  background-color: rgba(158,42,43, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.3);
}

.avatar-emoji {
  font-size: 50rpx;
}

.profile-meta {
  justify-content: center;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-char {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
}

.profile-stats {
  background: rgba(244,241,234, 0.6);
  border: 1rpx solid rgba(107,91,74, 0.15);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.p-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.p-stat-lbl {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-bottom: 6rpx;
}

.p-stat-val {
  font-size: 32rpx;
  font-weight: bold;
}

.did-block {
  margin-bottom: 24rpx;
  padding: 0 0 20rpx 0;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 0;
}

.did-block:active {
  background: rgba(158, 42, 43, 0.05);
  border-color: rgba(158, 42, 43, 0.25);
}

.did-label {
  font-size: 26rpx;
  color: #6b5b4a;
  font-weight: bold;
}

.did-copy-hint {
  font-size: 26rpx;
  color: #8c7d68;
}

.did-value {
  display: block;
  font-size: 26rpx;
  color: #9e2a2b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.profile-karma-inline {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #b8844f;
}

.token-block {
  background: rgba(244,241,234, 0.5);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.token-preview {
  font-size: 26rpx;
  color: #6b5b4a;
  flex: 1;
}

.copy-btn {
  background: rgba(158,42,43, 0.1);
  border: 1rpx solid #9e2a2b;
  color: #9e2a2b;
  font-size: 26rpx;
  font-weight: bold;
  padding: 0 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 4rpx;
  margin: 0;
}

.copy-btn::after {
  border: none;
}

.copy-btn:active {
  background: rgba(158,42,43, 0.25);
}

.logout-btn {
  background: rgba(190,18,60, 0.1);
  border: 1rpx solid rgba(190,18,60, 0.4);
  color: #be123c;
  font-size: 26rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  text-align: center;
  width: 100%;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(190,18,60, 0.2);
}

/* Unlogged card styles */
.unlogin-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.unlogin-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5b7a8c;
}

.unlogin-desc {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 0 16rpx;
}

/* Agents Panel */
.panel-desc {
  font-size: 26rpx;
  color: #6b5b4a;
  margin-top: 6rpx;
  line-height: 1.4;
}

.loading-spin {
  padding: 40rpx 0;
}

.spin-text {
  font-size: 26rpx;
  color: #6b5b4a;
}

.empty-agents {
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c7d68;
}

/* Import Panel */
.token-textarea {
  width: 100%;
  height: 120rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(59,48,36, 0.15);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.token-placeholder {
  color: #6b5b4a;
  font-size: 26rpx;
}

.import-submit-btn {
  background: linear-gradient(135deg, #9e2a2b, #b35c44);
  color: #f4f1ea;
  font-size: 26rpx;
  font-weight: bold;
  height: 70rpx;
  border-radius: 32rpx;
  border: none;
  width: 100%;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.35);
}

.import-submit-btn::after {
  border: none;
}

.import-submit-btn:active {
  opacity: 0.8;
}

/* Register Form Panel */
.register-form-panel {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
}

.border-bottom {
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.1);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

.form-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #9e2a2b;
}

.form-input {
  height: 70rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #9e2a2b;
}

.form-textarea-small {
  height: 100rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  height: 160rpx;
  background: rgba(244,241,234, 0.8);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}

.iq-challenge-badge {
  background: rgba(158,42,43, 0.08);
  border: 1rpx solid rgba(158,42,43, 0.3);
  border-radius: 6rpx;
  padding: 14rpx 20rpx;
  margin-top: 10rpx;
}

.iq-badge-dot {
  color: #9e2a2b;
  font-size: 26rpx;
  margin-right: 12rpx;
  animation: pulse-cyan 1.5s infinite alternate;
}

.iq-badge-text {
  font-size: 26rpx;
  color: #9e2a2b;
  font-weight: bold;
}

@keyframes pulse-cyan {
  0% {
    opacity: 0.3;
  }
  100% {
    opacity: 1;
  }
}

.pledge-notice {
  margin-top: 10rpx;
  line-height: 1.5;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.1);
}

.pledge-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #a89982;
}

.pledge-text {
  font-size: 26rpx;
  color: #6b5b4a;
}

.button-row {
  gap: 20rpx;
  margin-top: 10rpx;
}

.form-cancel-btn {
  flex: 1;
  background: rgba(59, 48, 36, 0.1);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  color: #8c7d68;
  font-size: 26rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 0;
}

.form-cancel-btn::after {
  border: none;
}

.form-cancel-btn:active {
  background: rgba(59, 48, 36, 0.12);
}

.form-submit-btn {
  flex: 1;
  background: linear-gradient(135deg, #9e2a2b, #b35c44);
  color: #f4f1ea;
  font-size: 26rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  border: none;
  text-align: center;
  margin: 0;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(158,42,43, 0.4);
}

.form-submit-btn::after {
  border: none;
}

.form-submit-btn:active {
  opacity: 0.8;
}

/* Telemetry Logs inside Settings */
.logs-clear-btn-settings {
  background: rgba(190,18,60, 0.1);
  border: 1rpx solid rgba(190,18,60, 0.3);
  color: #be123c;
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  margin: 0;
}

.logs-clear-btn-settings::after {
  border: none;
}

.logs-clear-btn-settings:active {
  background: rgba(190,18,60, 0.25);
  border-color: #be123c;
}

.tag-SYSTEM { color: #6b5b4a; }
.tag-ACTION { color: #eab308; }
.tag-CHAT { color: #d946ef; }
.tag-ERROR { color: #be123c; }

.msg-SYSTEM { color: #8c7d68; }
.msg-ACTION { color: #fef08a; }
.msg-CHAT { color: #fbcfe8; }
.msg-ERROR { color: #fecdd3; }

/* Personality Sliders Calibration & Speech Preview (C-1) */
.personality-sliders-section {
  background: rgba(253,251,247, 0.4);
  border: 1rpx solid rgba(91,122,140, 0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.slider-item {
  margin-bottom: 20rpx;
}

.slider-labels {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.slider-label-left {
  font-size: 26rpx;
  color: #6b5b4a;
  width: 100rpx;
  text-align: left;
}

.slider-label-center {
  font-size: 26rpx;
  font-weight: bold;
  color: #8c7d68;
}

.slider-label-right {
  font-size: 26rpx;
  color: #6b5b4a;
  width: 100rpx;
  text-align: right;
}

.cyber-slider {
  margin: 0;
  padding: 0;
}

/* Tone Preview Bubble Styles */
.tone-preview-bubble {
  background: rgba(244,241,234, 0.6);
  border-left: 6rpx solid #5b7a8c;
  border-radius: 0 16rpx 16rpx 0;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(91,122,140, 0.1);
}

.bubble-title-settings {
  font-size: 26rpx;
  font-weight: bold;
  color: #5b7a8c;
  margin-bottom: 8rpx;
  display: block;
}

.bubble-body-settings {
  min-height: 48rpx;
  display: flex;
  align-items: center;
}

.bubble-text-settings {
  font-size: 26rpx;
  color: #3b3024;
  line-height: 1.5;
  font-style: italic;
  display: block;
}


/* ========== 档案卡 + 行式列表布局（水墨重构版） ========== */

/* 元神档案卡：全页唯一强调卡 */
.profile-hero-card {
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(59, 48, 36, 0.12);
  border-top: 6rpx solid #9e2a2b;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx -10rpx rgba(59, 48, 36, 0.15);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.hero-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b3024;
}

.hero-actions {
  gap: 20rpx;
  margin-top: 24rpx;
}

.hero-copy-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.06);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  border-radius: 38rpx;
  margin: 0;
}

.hero-copy-btn::after { border: none; }

.hero-copy-btn:active {
  background: rgba(158, 42, 43, 0.12);
}

.hero-logout-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #6b5b4a;
  background: rgba(59, 48, 36, 0.05);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 38rpx;
  margin: 0;
}

.hero-logout-btn::after { border: none; }

.hero-logout-btn:active {
  background: rgba(59, 48, 36, 0.1);
}

/* 设置区块：标题 + 行式列表 */
.settings-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx 8rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b3024;
  margin-bottom: 8rpx;
  display: block;
}

.section-desc {
  font-size: 26rpx;
  color: #8c7d68;
  line-height: 1.4;
  margin-top: 6rpx;
  display: block;
}

.settings-list {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

/* 名册行 */
.agent-row {
  padding: 20rpx 24rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}

.agent-row:last-child {
  border-bottom: none;
}

.row-hover {
  background: rgba(158, 42, 43, 0.05);
}

.agent-row-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.agent-row-karma {
  font-size: 26rpx;
  font-weight: bold;
  color: #b8844f;
  flex-shrink: 0;
}

.row-arrow {
  font-size: 32rpx;
  color: #a89982;
  flex-shrink: 0;
  font-weight: normal;
}

.register-row {
  border-bottom: none;
}

.register-row-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.06);
  border: 1rpx dashed rgba(158, 42, 43, 0.35);
  border-radius: 50%;
}

.register-row-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  color: #9e2a2b;
}

/* 设置行 */
.setting-row {
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(59, 48, 36, 0.08);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.setting-row-desc {
  font-size: 26rpx;
  color: #8c7d68;
  margin-top: 4rpx;
}

.setting-row-value {
  font-size: 26rpx;
  color: #6b5b4a;
}

.setting-row-input {
  align-items: flex-start;
}

.server-url-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  background: rgba(244, 241, 234, 0.8);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.server-save-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  background: #9e2a2b;
  border-radius: 32rpx;
  border: none;
  margin: 0;
}

.server-save-btn::after { border: none; }

.server-save-btn:active { opacity: 0.85; }

/* 日志区块 */
.logs-toggle-btn-settings {
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(158, 42, 43, 0.06);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
  color: #9e2a2b;
  border-radius: 28rpx;
  margin: 0;
}

.logs-toggle-btn-settings::after { border: none; }

.logs-clear-btn-settings {
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(59, 48, 36, 0.05);
  border: 1rpx solid rgba(59, 48, 36, 0.15);
  color: #6b5b4a;
  border-radius: 28rpx;
  margin: 0;
}

.logs-clear-btn-settings::after { border: none; }

.logs-scroll {
  height: 400rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(59, 48, 36, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.log-line {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.log-line-head {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.log-time {
  color: #8c7d68;
  font-size: 24rpx;
}

.log-tag {
  font-weight: bold;
  font-size: 24rpx;
}

.log-msg {
  word-break: break-all;
  color: #3b3024;
}

.empty-logs {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 导入凭证区：弱化处理 */
.import-section .token-textarea {
  margin-bottom: 16rpx;
}

.import-submit-btn {
  width: 100%;
}

/* 统一按钮文字居中（替代脆弱的 line-height 垂直居中） */
.hero-copy-btn,
.hero-logout-btn,
.import-submit-btn,
.server-save-btn,
.logs-toggle-btn-settings,
.logs-clear-btn-settings,
.form-cancel-btn,
.form-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}
/* 遥测日志折叠区：标题独占一行，按钮完整展示 */
.logs-setting-row {
  width: 100%;
  gap: 16rpx;
}
.logs-setting-row .logs-scroll {
  width: 100%;
}
.logs-row-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  max-width: 100%;
}
.logs-toggle-btn-settings,
.logs-clear-btn-settings {
  flex: 0 0 auto;
  width: auto;
  max-width: 100%;
  white-space: nowrap;
}
/* 导入区标题纵向排布 */
.section-header-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}
.hero-copy-btn,
.hero-logout-btn {
  white-space: nowrap;
}
