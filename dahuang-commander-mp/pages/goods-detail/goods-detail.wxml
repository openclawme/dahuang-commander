<view class="container" wx:if="{{goods}}">
  <scroll-view class="detail-scroll" scroll-y>
    <!-- 轮播图（商详 gallery；无则回退搜索主图） -->
    <swiper class="detail-swiper" wx:if="{{detail && detail.gallery.length > 1}}" indicator-dots circular
            indicator-color="rgba(0,0,0,0.2)" indicator-active-color="#9e2a2b">
      <swiper-item wx:for="{{detail.gallery}}" wx:key="*this">
        <image class="detail-swiper-img" src="{{item}}" mode="aspectFill" lazy-load
               bindtap="previewGallery" data-index="{{index}}"></image>
      </swiper-item>
    </swiper>
    <view class="detail-image-wrap" wx:else bindtap="previewGallery" data-index="0">
      <image class="detail-image" src="{{goods.image}}" mode="aspectFill"></image>
      <text class="detail-image-hint">点击查看大图</text>
    </view>

    <view class="detail-panel">
      <!-- 价格区 -->
      <view class="detail-price-row flex-row align-center">
        <text class="detail-symbol">¥</text>
        <text class="detail-price">{{goods.priceText}}</text>
        <text class="detail-origin" wx:if="{{goods.couponYuan > 0}}">¥{{goods.originText}}</text>
        <text class="detail-coupon" wx:if="{{goods.couponYuan > 0}}">券{{goods.couponText}}元</text>
      </view>

      <!-- 标题 -->
      <view class="detail-title">{{goods.title}}</view>

      <!-- 平台 / 销量 / 店铺 -->
      <view class="detail-meta flex-row align-center">
        <text class="goods-card-platform platform-{{goods.platform}}">{{goods.platformText}}</text>
        <text class="detail-sales" wx:if="{{goods.salesTip}}">{{goods.salesTip}}</text>
        <text class="detail-shop text-ellipsis" wx:if="{{goods.shopName}}">{{goods.shopName}}</text>
      </view>

      <!-- 类目 · 品牌（商详返回） -->
      <view class="detail-category" wx:if="{{detail && detail.categoryText}}">{{detail.categoryText}}</view>

      <!-- 结算说明（不出现任何佣金/金额信息） -->
      <view class="detail-note flex-row align-center">
        <text class="detail-note-icon">币</text>
        <text class="detail-note-text">通过本商品购买入口下单，订单完成后大荒币自动入账</text>
      </view>
    </view>

    <!-- 规格参数（京东商详 propGroups） -->
    <view class="detail-section" wx:if="{{detail && detail.specGroups && detail.specGroups.length > 0}}">
      <view class="detail-section-header flex-row align-center">
        <view class="detail-section-line"></view>
        <text class="detail-section-title">规格参数</text>
        <view class="detail-section-line"></view>
      </view>
      <block wx:for="{{detail.specGroups}}" wx:for-item="group" wx:key="index">
        <view class="spec-group-name" wx:if="{{group.group}}">{{group.group}}</view>
        <view class="spec-row flex-row" wx:for="{{group.attrs}}" wx:for-item="attr" wx:key="name">
          <text class="spec-name">{{attr.name}}</text>
          <text class="spec-value">{{attr.value}}</text>
        </view>
      </block>
    </view>

    <!-- 内容简介（京东图书） -->
    <view class="detail-section" wx:if="{{detail && detail.bookIntro}}">
      <view class="detail-section-header flex-row align-center">
        <view class="detail-section-line"></view>
        <text class="detail-section-title">内容简介</text>
        <view class="detail-section-line"></view>
      </view>
      <text class="detail-desc-text">{{detail.bookIntro}}</text>
    </view>

    <!-- 包装清单（京东商详） -->
    <view class="detail-section" wx:if="{{detail && detail.packingList}}">
      <view class="detail-section-header flex-row align-center">
        <view class="detail-section-line"></view>
        <text class="detail-section-title">包装清单</text>
        <view class="detail-section-line"></view>
      </view>
      <text class="detail-packing-text">{{detail.packingList}}</text>
    </view>

    <!-- 图文详情（京东 detailImages 长图 / 拼多多 desc 文字） -->
    <view class="detail-section" wx:if="{{detail && (detail.detailImages.length > 0 || detail.desc)}}">
      <view class="detail-section-header flex-row align-center">
        <view class="detail-section-line"></view>
        <text class="detail-section-title">商品详情</text>
        <view class="detail-section-line"></view>
      </view>
      <block wx:if="{{detail.detailImages.length > 0}}">
        <image class="detail-long-img" wx:for="{{detail.detailImages}}" wx:key="*this" src="{{item}}"
               mode="widthFix" lazy-load bindtap="previewDetailImage" data-src="{{item}}"></image>
      </block>
      <text class="detail-desc-text" wx:elif="{{detail.desc}}">{{detail.desc}}</text>
    </view>

    <!-- 类目热销推荐（京东榜单，无佣金字段） -->
    <view class="detail-section" wx:if="{{related.length > 0}}">
      <view class="detail-section-header flex-row align-center">
        <view class="detail-section-line"></view>
        <text class="detail-section-title">热销推荐</text>
        <view class="detail-section-line"></view>
      </view>
      <view class="related-grid">
        <view class="related-card flex-col" wx:for="{{related}}" wx:key="id"
              bindtap="onRelatedTap" data-goods-id="{{item.id}}" hover-class="hover-dim">
          <image class="related-img" src="{{item.image}}" mode="aspectFill" lazy-load></image>
          <text class="related-title text-ellipsis-2">{{item.title}}</text>
          <view class="related-price-row flex-row align-center">
            <text class="related-symbol">¥</text>
            <text class="related-price">{{item.priceText}}</text>
            <text class="related-origin" wx:if="{{item.couponYuan > 0}}">¥{{item.originText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-spacer"></view>
  </scroll-view>

  <!-- 底部购买栏 -->
  <view class="detail-bottom-bar flex-row align-center justify-between">
    <view class="detail-bottom-price flex-row align-center">
      <text class="detail-symbol">¥</text>
      <text class="detail-price">{{goods.priceText}}</text>
    </view>
    <view class="detail-buy-btn" bindtap="onBuy" hover-class="hover-dim">{{buying ? '生成中…' : '去购买'}}</view>
  </view>
</view>

<view class="container empty" wx:else>
  <text class="empty-text">商品信息已失效，请回到聊天重新搜索</text>
</view>
