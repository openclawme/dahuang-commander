/* 商品详情页：宣纸底 + 纸白面板 + 朱砂价格/按钮反色（古风淡雅体系） */
.container {
  min-height: 100vh;
  background: #f4f1ea;
}

.detail-scroll {
  height: calc(100vh - 120rpx);
}

.detail-image-wrap {
  position: relative;
  background: #f4f1ea;
  height: 640rpx;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image-hint {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(27, 27, 27, 0.45);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.detail-panel {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  box-shadow: 0 6rpx 18rpx -10rpx rgba(59, 48, 36, 0.16);
}

.detail-price-row {
  margin-bottom: 18rpx;
}

.detail-symbol {
  font-size: 28rpx;
  color: #9e2a2b;
  font-weight: bold;
}

.detail-price {
  font-size: 56rpx;
  color: #9e2a2b;
  font-weight: bold;
  margin-right: 16rpx;
}

.detail-origin {
  font-size: 26rpx;
  color: #9aa3a8;
  text-decoration: line-through;
  margin-right: 14rpx;
}

.detail-coupon {
  font-size: 22rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.4);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.detail-title {
  font-size: 30rpx;
  color: #2b2b2b;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.detail-meta {
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed rgba(59, 48, 36, 0.12);
}

.goods-card-platform {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.platform-pdd {
  color: #ffffff;
  background: rgba(158, 42, 43, 0.85);
}

.platform-jd {
  color: #9e2a2b;
  background: rgba(158, 42, 43, 0.08);
  border: 1rpx solid rgba(158, 42, 43, 0.3);
}

.detail-sales {
  font-size: 22rpx;
  color: #5b7a8c;
  flex-shrink: 0;
}

.detail-shop {
  font-size: 22rpx;
  color: #9aa3a8;
  flex: 1;
  min-width: 0;
}

.detail-note {
  margin-top: 20rpx;
  gap: 12rpx;
}

.detail-note-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #5b7a8c;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-note-text {
  font-size: 22rpx;
  color: #5b7a8c;
}

.detail-spacer {
  height: 40rpx;
}

.detail-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid rgba(59, 48, 36, 0.1);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.detail-bottom-price {
  align-items: flex-end;
}

.detail-buy-btn {
  background: #9e2a2b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(158, 42, 43, 0.5);
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  color: #9aa3a8;
  font-size: 26rpx;
}

.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.align-center { align-items: center; }
.justify-between { justify-content: space-between; }
.text-ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ==================== 商详大字段（轮播图 + 图文详情） ==================== */
.detail-swiper {
  height: 640rpx;
  background: #f4f1ea;
}

.detail-swiper-img {
  width: 100%;
  height: 100%;
}

.detail-category {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa3a8;
}

.detail-section {
  background: #ffffff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  box-shadow: 0 6rpx 18rpx -10rpx rgba(59, 48, 36, 0.16);
}

.detail-section-header {
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.detail-section-line {
  width: 48rpx;
  height: 2rpx;
  background: rgba(59, 48, 36, 0.15);
}

.detail-section-title {
  font-size: 24rpx;
  color: #5b7a8c;
  letter-spacing: 4rpx;
}

.detail-packing-text {
  font-size: 24rpx;
  color: #2b2b2b;
  line-height: 1.7;
  white-space: pre-line;
}

.detail-long-img {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  background: #f4f1ea;
}

.detail-desc-text {
  font-size: 24rpx;
  color: #2b2b2b;
  line-height: 1.7;
}

/* ==================== 规格参数（propGroups） ==================== */
.spec-group-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #5b7a8c;
  margin: 16rpx 0 8rpx;
}

.spec-group-name:first-child {
  margin-top: 0;
}

.spec-row {
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed rgba(59, 48, 36, 0.1);
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-name {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa3a8;
}

.spec-value {
  flex: 1;
  font-size: 22rpx;
  color: #2b2b2b;
  line-height: 1.5;
}

/* ==================== 类目热销推荐 ==================== */
.related-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.related-card {
  background: #faf8f4;
  border: 1rpx solid rgba(59, 48, 36, 0.08);
  border-radius: 12rpx;
  padding: 12rpx;
}

.related-img {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx;
  background: #f4f1ea;
  margin-bottom: 10rpx;
}

.related-title {
  font-size: 22rpx;
  color: #2b2b2b;
  line-height: 1.4;
  margin-bottom: 8rpx;
  min-height: 62rpx;
}

.related-price-row {
  gap: 8rpx;
}

.related-symbol {
  font-size: 20rpx;
  color: #9e2a2b;
  font-weight: bold;
}

.related-price {
  font-size: 28rpx;
  color: #9e2a2b;
  font-weight: bold;
}

.related-origin {
  font-size: 20rpx;
  color: #9aa3a8;
  text-decoration: line-through;
}

/* ==================== 下架提示 ==================== */
.off-sale-banner {
  margin-top: 16rpx;
  background: rgba(91, 122, 140, 0.08);
  border: 1rpx solid rgba(91, 122, 140, 0.25);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #5b7a8c;
}

.buy-disabled {
  background: #b9b2a6 !important;
  box-shadow: none !important;
}

/* 活动角标（秒杀/百亿补贴） */
.goods-tag {
  font-size: 20rpx;
  color: #9e2a2b;
  border: 1rpx solid rgba(158, 42, 43, 0.45);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
  background: rgba(158, 42, 43, 0.04);
}

/* CPS 披露（合规） */
.detail-disclosure {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #c3c0b8;
}
